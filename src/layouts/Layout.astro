---
import '../styles/global.css';
import 'bootstrap/dist/css/bootstrap.min.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

import type { Lang } from '../types';
import { defaultLang } from '../store/translations';

export interface Props {
  title: string;
  lang?: Lang;
}

const { title } = Astro.props;
import { getStoredLang } from '../store/translations';

const [, pathLang] = Astro.url.pathname.split('/');
const lang = (pathLang && ['fi', 'en', 'se'].includes(pathLang)) ? pathLang as Lang : defaultLang;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={
      lang === 'en' 
        ? "ISECure provides secure bank connection channels and Web Service API solutions for businesses. Trusted WS-Channel integration services for Nordic banks including Nordea, OP, and Danske Bank."
        : lang === 'se'
        ? "ISECure erbjuder säkra bankförbindelsekanaler och Web Service API-lösningar för företag. Pålitliga WS-Kanal integrationstjänster för nordiska banker inklusive Nordea, OP och Danske Bank."
        : "ISECure tarjoaa turvalliset pankkiyhteydet ja Web Service API-ratkaisut yrityksille. Luotettavat WS-Kanava integraatiopalvelut pohjoismaisille pankeille mukaan lukien Nordea, OP ja Danske Bank."
    } />
    <meta name="keywords" content="WS-Kanava, Web Service, API, pankkiyhteys, SEPA, maksuliikenne, verkkopankki, Nordea, OP, Danske Bank, bank integration, AWS, cloud services" />
    <meta name="author" content="ISECure Oy" />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={
      lang === 'en'
        ? "Secure bank connection channel and API solutions for businesses"
        : lang === 'se'
        ? "Säker bankförbindelsekanal och API-lösningar för företag"
        : "Turvallinen pankkiyhteyskanava ja API-ratkaisut yrityksille"
    } />
    <meta property="og:image" content="/images/isecure-og-image.png" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={
      lang === 'en'
        ? "Secure bank connection channel and API solutions for businesses"
        : lang === 'se'
        ? "Säker bankförbindelsekanal och API-lösningar för företag"
        : "Turvallinen pankkiyhteyskanava ja API-ratkaisut yrityksille"
    } />
    <meta name="twitter:image" content="/images/isecure-og-image.png" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <title>{title} | ISECure - Professional Bank Integration Solutions</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "ISECure WS-Channel",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Cloud",
        "offers": {
          "@type": "Offer",
          "category": "Banking Integration Solutions"
        },
        "description": {
          lang === 'en' 
            ? "Secure bank connection channel and API solutions for businesses"
            : lang === 'se'
            ? "Säker bankförbindelsekanal och API-lösningar för företag"
            : "Turvallinen pankkiyhteyskanava ja API-ratkaisut yrityksille"
        },
        "provider": {
          "@type": "Organization",
          "name": "ISECure Oy",
          "address": {
            "@type": "PostalAddress",
            "addressCountry": "FI",
            "addressLocality": "Helsinki"
          }
        }
      }
    </script>
    
    <!-- Custom CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Analytics -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BJ6B7H7K8E');
      gtag('config', 'AW-1025469048');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BJ6B7H7K8E"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-1025469048"></script>
  </head>
  <body>
    <Navigation lang={lang} />
    <main class="main-content">
      <slot />
      <Contact lang={lang} />
    </main>
    <Footer />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://sdk.amazonaws.com/js/aws-sdk-2.1473.0.min.js"></script>
  </body>
</html>
