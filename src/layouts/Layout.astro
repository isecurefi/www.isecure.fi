---
import '../styles/global.css';
import 'bootstrap/dist/css/bootstrap.min.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

import type { Lang } from '../types';
export interface Props {
  title: string;
  lang?: Lang;
}

const { title } = Astro.props;
import { defaultLanguage as defaultLang } from '../utils/languages';
const [, pathLang] = Astro.url.pathname.split('/');
const lang = (pathLang && ['fi', 'en', 'se'].includes(pathLang)) ? pathLang as Lang : defaultLang;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={
      lang === 'en' 
        ? "ISECure provides secure bank connection channels and Web Service API solutions for businesses. Trusted WS-Channel integration services for Nordic banks including Nordea, OP, and Danske Bank."
        : lang === 'se'
        ? "ISECure erbjuder säkra bankförbindelsekanaler och Web Service API-lösningar för företag. Pålitliga WS-Kanal integrationstjänster för nordiska banker inklusive Nordea, OP och Danske Bank."
        : "ISECure tarjoaa turvalliset pankkiyhteydet ja Web Service API-ratkaisut yrityksille. Luotettavat WS-Kanava integraatiopalvelut pohjoismaisille pankeille mukaan lukien Nordea, OP ja Danske Bank."
    } />
    <meta name="keywords" content="WS-Kanava, Web Service, API, pankkiyhteys, SEPA, maksuliikenne, verkkopankki, Nordea, OP, Danske Bank, bank integration, AWS, cloud services, secure banking, Nordic banks" />
    <meta name="author" content="ISECure Oy" />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="theme-color" content="#0d6efd" />
    <meta name="format-detection" content="telephone=no" />
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ISECure" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={
      lang === 'en'
        ? "Secure bank connection channel and API solutions for businesses. Professional WS-Channel integration for Nordic banks."
        : lang === 'se'
        ? "Säker bankförbindelsekanal och API-lösningar för företag. Professionell WS-Kanal integration för nordiska banker."
        : "Turvallinen pankkiyhteyskanava ja API-ratkaisut yrityksille. Ammattimainen WS-Kanava integraatio pohjoismaisille pankeille."
    } />
    <meta property="og:image" content={new globalThis.URL('/images/isecure-og-image.png', Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : lang === 'se' ? 'sv_SE' : 'fi_FI'} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ISECureOy" />
    <meta name="twitter:creator" content="@ISECureOy" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={
      lang === 'en'
        ? "Secure bank connection channel and API solutions for businesses. Professional WS-Channel integration for Nordic banks."
        : lang === 'se'
        ? "Säker bankförbindelsekanal och API-lösningar för företag. Professionell WS-Kanal integration för nordiska banker."
        : "Turvallinen pankkiyhteyskanava ja API-ratkaisut yrityksille. Ammattimainen WS-Kanava integraatio pohjoismaisille pankeille."
    } />
    <meta name="twitter:image" content={new globalThis.URL('/images/isecure-og-image.png', Astro.url)} />
    <meta name="twitter:image:alt" content="ISECure - Professional Bank Integration Solutions" />

    <!-- Additional SEO -->
    <meta name="geo.region" content="FI" />
    <meta name="geo.placename" content="Helsinki" />
    <meta name="geo.position" content="60.1699;24.9384" />
    <meta name="ICBM" content="60.1699, 24.9384" />
    <meta name="application-name" content="ISECure" />
    <meta name="apple-mobile-web-app-title" content="ISECure" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <link rel="canonical" href={Astro.site ? new globalThis.URL(Astro.url.pathname, Astro.site).toString() : Astro.url.pathname} />
    <title>{title} | ISECure - Professional Bank Integration Solutions</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://isecure.fi/#organization",
            "name": "ISECure Oy",
            "url": "https://isecure.fi",
            "logo": {
              "@type": "ImageObject",
              "url": "https://isecure.fi/images/isecure-small-logo.png",
              "width": 200,
              "height": 40
            },
            "address": {
              "@type": "PostalAddress",
              "addressCountry": "FI",
              "addressLocality": "Helsinki",
              "postalCode": "00100"
            },
            "contactPoint": {
              "@type": "ContactPoint",
              "telephone": "+358404835507",
              "contactType": "sales",
              "email": "dan.forsberg@isecure.fi",
              "availableLanguage": ["Finnish", "English", "Swedish"]
            },
            "sameAs": [
              "https://www.linkedin.com/company/isecure-oy"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://isecure.fi/#website",
            "url": "https://isecure.fi",
            "name": "ISECure",
            "publisher": {
              "@id": "https://isecure.fi/#organization"
            },
            "inLanguage": "${lang === 'en' ? 'en-US' : lang === 'se' ? 'sv-SE' : 'fi-FI'}"
          },
          {
            "@type": "SoftwareApplication",
            "name": "${
              lang === 'en' ? 'ISECure WS-Channel' :
              lang === 'se' ? 'ISECure WS-Kanal' :
              'ISECure WS-Kanava'
            }",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Cloud",
            "offers": {
              "@type": "Offer",
              "category": "Banking Integration Solutions",
              "priceCurrency": "EUR",
              "availability": "https://schema.org/InStock"
            },
            "description": "${
              lang === 'en' 
                ? 'Secure bank connection channel and API solutions for businesses. Professional WS-Channel integration for Nordic banks.'
                : lang === 'se'
                ? 'Säker bankförbindelsekanal och API-lösningar för företag. Professionell WS-Kanal integration för nordiska banker.'
                : 'Turvallinen pankkiyhteyskanava ja API-ratkaisut yrityksille. Ammattimainen WS-Kanava integraatio pohjoismaisille pankeille.'
            }",
            "provider": {
              "@id": "https://isecure.fi/#organization"
            },
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": "4.8",
              "ratingCount": "156"
            }
          }
        ]
      }
    </script>
    
    <!-- Preload critical assets -->
    <link rel="preload" as="font" href="https://fonts.gstatic.com/s/inter/v12/UcC73FwrK3iLTeHuS_fvQtMwCp50KnMa1ZL7.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="https://fonts.gstatic.com/s/inter/v12/UcC73FwrK3iLTeHuS_fvQtMwCp50KnMa2ZL7.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="https://fonts.gstatic.com/s/inter/v12/UcC73FwrK3iLTeHuS_fvQtMwCp50KnMa25L7.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="image" href="/images/isecure-small-logo.png">
    
    <!-- Critical CSS -->
    <style is:inline>
      :root {
        --primary-color: #0d6efd;
        --background-color: #ffffff;
        --text-color: #212529;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
        color: var(--text-color);
        padding-top: 76px;
        margin: 0;
      }

      .navbar {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 1030;
      }

      .main-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
      }
    </style>
    
    <!-- Optimize font loading -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
    
    <!-- Defer non-critical scripts -->
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script defer src="/js/jquery.js"></script>
    <script defer src="https://sdk.amazonaws.com/js/aws-sdk-2.1473.0.min.js"></script>

    <!-- Analytics -->
    <script async is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BJ6B7H7K8E');
      gtag('config', 'AW-1025469048');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BJ6B7H7K8E"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-1025469048"></script>
  </head>
  <body>
    <Navigation lang={lang} />
    <main class="main-content">
      <slot />
      <Contact lang={lang} />
    </main>
    <Footer />
  </body>
</html>
