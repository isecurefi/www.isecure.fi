---
import CatalogNavigation from "../components/CatalogNavigation.astro";
import {
  catalogUi,
  type CatalogRecord,
  type DeveloperSurface,
} from "../data/productRegistry";
import {
  absoluteUrl,
  alternateLinks,
  faqNode,
  localizedRoutes,
  pageName,
  type Breadcrumb,
} from "../lib/seo";
import Layout from "./Layout.astro";
import type { Lang } from "../types";

interface Props {
  lang: Lang;
  record?: CatalogRecord;
  surface?: DeveloperSurface;
  slug?: string;
  title?: string;
  description?: string;
  faq?: Array<{ q: string; a: string }>;
  fullWidth?: boolean;
  bodyClass?: string;
}

const {
  lang,
  record,
  surface,
  fullWidth = false,
  bodyClass = "",
} = Astro.props;
if (record?.visibility === "none") {
  throw new Error(`Catalog record ${record.id} has no public or preview route`);
}
if (!record && !surface && !Astro.props.slug) {
  throw new Error(
    "CatalogPageLayout requires a record, developer surface, or slug",
  );
}
const catalogEntry = record ?? surface;
const slug = Astro.props.slug ?? "";
const routes =
  catalogEntry && catalogEntry.visibility !== "none"
    ? catalogEntry.routes
    : localizedRoutes(slug);
const canonicalUrl = absoluteUrl(routes[lang]);
const title = Astro.props.title ?? catalogEntry?.seo.title[lang] ?? "ISECure";
const description =
  Astro.props.description ?? catalogEntry?.seo.description[lang] ?? "";
// Products sit under the product index in the breadcrumb trail; guides and
// integrations hang directly off the homepage.
const breadcrumbs: Breadcrumb[] = [
  { name: "ISECure", url: absoluteUrl(localizedRoutes()[lang]) },
  ...(record?.kind === "product"
    ? [
        {
          name: catalogUi[lang].products,
          url: absoluteUrl(localizedRoutes("products")[lang]),
        },
      ]
    : []),
  { name: pageName(title), url: canonicalUrl },
];
const webPage = catalogEntry && {
  about: {
    "@type": "Thing",
    name: catalogEntry.name[lang],
    description: catalogEntry.summary[lang],
  },
};
// FAQPage covers the catalog record's questions plus any page-specific ones.
const faq = faqNode([
  ...(record?.faq ?? []).map((item) => ({
    q: item.question[lang],
    a: item.answer[lang],
  })),
  ...(Astro.props.faq ?? []),
]);
const robots =
  record?.visibility === "draft" ? "noindex, nofollow" : "index, follow";
---

<Layout
  {title}
  {description}
  socialDescription={description}
  {canonicalUrl}
  alternateLinks={alternateLinks(routes)}
  {webPage}
  {breadcrumbs}
  structuredDataNodes={[faq]}
  {robots}
  {lang}
  {fullWidth}
  {bodyClass}
>
  <div
    data-catalog-record={catalogEntry?.id}
    data-catalog-kind={catalogEntry?.kind}
    data-catalog-stage={catalogEntry?.stage}
    data-catalog-visibility={catalogEntry?.visibility}
  >
    <slot name="hero" />
    {
      record && record.visibility !== "draft" && (
        <CatalogNavigation {lang} current={record} />
      )
    }
    <slot />
  </div>
</Layout>
