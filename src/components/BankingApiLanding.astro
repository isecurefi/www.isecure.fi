<script>
  // One API, all the banks: payment files flow from the secured hub to every
  // bank, statements flow back, and lanes near the pointer light up.
  type Point = { x: number; y: number };
  const canvas = document.querySelector<HTMLCanvasElement>(".hero-network");
  const hero = canvas?.parentElement;
  const ctx = canvas?.getContext("2d");
  if (canvas && hero && ctx) {
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const BANKS = 9;
    const packets = Array.from({ length: BANKS * 2 }, (_, i) => ({
      lane: i % BANKS,
      outbound: i < BANKS,
      t: (i * 0.37) % 1,
      speed: 0.07 + ((i * 7) % 5) * 0.012,
    }));
    const flash = new Float32Array(BANKS);
    const pointer = { y: 0.5, active: 0 };
    const smooth = { y: 0.5, active: 0 };
    let width = 0;
    let height = 0;
    let colors = { accent: "#4fd1c5", blue: "#8ab4ff" };
    let frameId = 0;
    let last = 0;
    let elapsed = 0;
    let visible = true;

    const readColors = () => {
      const style = getComputedStyle(hero);
      colors = {
        accent:
          style.getPropertyValue("--landing-accent").trim() || colors.accent,
        blue: style.getPropertyValue("--landing-blue").trim() || colors.blue,
      };
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      width = hero.clientWidth;
      height = hero.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(0);
    };

    const geometry = () => {
      const wide = width >= 980;
      const hub = { x: width * (wide ? 0.7 : 0.66), y: height * 0.5 };
      const bankX = width * (wide ? 0.95 : 0.97);
      const banks = Array.from({ length: BANKS }, (_, i) => ({
        x: bankX - Math.abs(i - (BANKS - 1) / 2) * width * 0.012,
        y: height * (0.1 + (0.8 * i) / (BANKS - 1)),
      }));
      return { hub, banks };
    };

    const point = (hub: Point, bank: Point, t: number): Point => {
      // Cubic Bézier: leaves the hub horizontally, arrives at the bank horizontally.
      const mx = hub.x + (bank.x - hub.x) * 0.5;
      const u = 1 - t;
      return {
        x:
          u * u * u * hub.x +
          3 * u * u * t * mx +
          3 * u * t * t * mx +
          t * t * t * bank.x,
        y:
          u * u * u * hub.y +
          3 * u * u * t * hub.y +
          3 * u * t * t * bank.y +
          t * t * t * bank.y,
      };
    };

    const roundRect = (
      x: number,
      y: number,
      w: number,
      h: number,
      r: number,
    ) => {
      ctx.beginPath();
      ctx.roundRect(x - w / 2, y - h / 2, w, h, r);
    };

    function draw(delta: number) {
      const { hub, banks } = geometry();
      const blend = 1 - Math.exp(-delta / 180);
      smooth.y += (pointer.y - smooth.y) * blend;
      smooth.active += (pointer.active - smooth.active) * blend;
      ctx.clearRect(0, 0, width, height);
      ctx.lineCap = "round";

      banks.forEach((bank, i) => {
        const distance = (bank.y / height - smooth.y) * BANKS;
        const glow = Math.exp((-distance * distance) / 2) * smooth.active;
        flash[i] = Math.max(0, flash[i] - delta / 900);
        const mx = hub.x + (bank.x - hub.x) * 0.5;
        ctx.globalAlpha = 0.16 + glow * 0.5 + flash[i] * 0.3;
        ctx.strokeStyle = colors.accent;
        ctx.lineWidth = 1.2 + glow;
        ctx.beginPath();
        ctx.moveTo(hub.x, hub.y);
        ctx.bezierCurveTo(mx, hub.y, mx, bank.y, bank.x, bank.y);
        ctx.stroke();

        ctx.globalAlpha = 0.45 + glow * 0.4 + flash[i] * 0.4;
        ctx.fillStyle = colors.accent;
        ctx.beginPath();
        ctx.arc(bank.x, bank.y, 4.5 + flash[i] * 2, 0, Math.PI * 2);
        ctx.fill();
      });

      packets.forEach((packet) => {
        packet.t += (packet.speed * delta) / 1000;
        if (packet.t >= 1) {
          packet.t -= 1;
          if (packet.outbound) flash[packet.lane] = 1;
        }
        const t = packet.outbound ? packet.t : 1 - packet.t;
        const { x, y } = point(hub, banks[packet.lane], t);
        const fade = Math.min(1, packet.t * 8, (1 - packet.t) * 8);
        ctx.globalAlpha = 0.85 * fade;
        roundRect(x, y, 11, 8, 2);
        if (packet.outbound) {
          ctx.fillStyle = colors.accent;
          ctx.fill();
        } else {
          ctx.strokeStyle = colors.blue;
          ctx.lineWidth = 1.4;
          ctx.stroke();
        }
      });

      // Hardened hub: a shield that breathes slowly.
      const pulse = (elapsed / 2600) % 1;
      ctx.globalAlpha = 0.35 * (1 - pulse);
      ctx.strokeStyle = colors.accent;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(hub.x, hub.y, 26 + pulse * 34, 0, Math.PI * 2);
      ctx.stroke();
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = colors.accent;
      ctx.beginPath();
      ctx.moveTo(hub.x, hub.y - 20);
      ctx.lineTo(hub.x + 16, hub.y - 13);
      ctx.quadraticCurveTo(hub.x + 16, hub.y + 10, hub.x, hub.y + 20);
      ctx.quadraticCurveTo(hub.x - 16, hub.y + 10, hub.x - 16, hub.y - 13);
      ctx.closePath();
      ctx.fill();
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "destination-out";
      ctx.beginPath();
      ctx.arc(hub.x, hub.y - 3, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillRect(hub.x - 1.75, hub.y - 1, 3.5, 9);
      ctx.globalCompositeOperation = "source-over";
    }

    const frame = (time: number) => {
      const delta = last ? Math.min(time - last, 50) : 16;
      last = time;
      elapsed += delta;
      draw(delta);
      frameId = requestAnimationFrame(frame);
    };

    const sync = () => {
      cancelAnimationFrame(frameId);
      frameId = 0;
      last = 0;
      if (!reducedMotion.matches && visible && !document.hidden) {
        frameId = requestAnimationFrame(frame);
      } else {
        pointer.active = smooth.active = 0;
        draw(0);
      }
    };

    document.addEventListener(
      "pointermove",
      (event) => {
        const bounds = hero.getBoundingClientRect();
        pointer.active = Number(
          event.clientY >= bounds.top && event.clientY <= bounds.bottom,
        );
        pointer.y = (event.clientY - bounds.top) / bounds.height;
      },
      { passive: true },
    );
    new ResizeObserver(resize).observe(hero);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(hero);
    new MutationObserver(() => {
      readColors();
      draw(0);
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-isecure-theme"],
    });
    reducedMotion.addEventListener("change", sync);
    document.addEventListener("visibilitychange", sync);
    readColors();
    resize();
    sync();
  }
</script>

<style>
  .landing-inner {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .landing-hero {
    background: var(--landing-hero-bg);
    border-bottom: 0;
    isolation: isolate;
    overflow: hidden;
    position: relative;
    /* Extends up behind the fixed 56px navigation bar. */
    margin-top: -56px;
    padding: 128px 0 54px;
  }

  .landing-hero::before {
    background-image:
      linear-gradient(var(--landing-hero-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--landing-hero-grid) 1px, transparent 1px);
    background-size: 48px 48px;
    content: "";
    inset: 0;
    mask-image: radial-gradient(ellipse at 75% 50%, #000, transparent 70%);
    pointer-events: none;
    position: absolute;
    z-index: -2;
  }

  .hero-network {
    height: 100%;
    inset: 0;
    pointer-events: none;
    position: absolute;
    width: 100%;
    z-index: -1;
  }

  .eyebrow,
  .banking-landing .eyebrow {
    color: var(--landing-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .hero-copy > .eyebrow {
    font-size: clamp(1rem, 1.5vw, 1.28rem);
    line-height: 1.35;
    margin-bottom: 16px;
    max-width: 720px;
    text-transform: none;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  .hero-copy h1 {
    font-size: clamp(2.3rem, 4.4vw, 4.25rem);
    line-height: 1.02;
    margin: 0;
    max-width: 760px;
  }

  .lead {
    color: var(--landing-muted);
    font-size: clamp(1.2rem, 1.55vw, 1.38rem);
    line-height: 1.6;
    margin: 24px 0 0;
    max-width: 780px;
  }

  .hero-icp {
    background: rgba(79, 209, 197, 0.08);
    border-left: 3px solid var(--landing-accent);
    color: var(--landing-ink);
    font-size: 1.02rem;
    font-weight: 750;
    line-height: 1.55;
    margin: 22px 0 0;
    max-width: 720px;
    padding: 12px 16px;
  }

  .proof-line {
    color: var(--landing-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.95rem;
    font-weight: 650;
    gap: 6px 22px;
    list-style: none;
    margin: 28px 0 0;
    max-width: 760px;
    padding: 0;
  }

  .proof-line li {
    align-items: center;
    display: inline-flex;
    gap: 8px;
  }

  .proof-line li::before {
    background: var(--landing-accent);
    border-radius: 50%;
    content: "";
    flex: none;
    height: 6px;
    width: 6px;
