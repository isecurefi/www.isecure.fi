const t = content[lang];
---

<article class="banking-landing">
  <section class="landing-hero" id="overview">
    <div class="landing-inner hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p class="lead">{t.lead}</p>
        <p class="hero-icp">{t.icp}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#quickstart">{t.primaryCta}</a>
          <a class="button button-secondary" href="https://isecure.fi/wsapi_v2/index.html">{t.secondaryCta}</a>
        </div>
        <div class="proof-strip" aria-label="ISECure proof points">
          {
            t.proof.map((item) => (
              <div class="proof-item">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
                <p>{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="terminal-panel" aria-label={t.tsLabel}>
        <section class="code-sample">
          <h3>{t.tsLabel}</h3>
          <pre><code class="hljs language-typescript" set:html={highlightedTsCode} /></pre>
        </section>
      </div>
    </div>
  </section>

  <section class="landing-section references-section" id="references">
    <div class="landing-inner">
      <References lang={lang} />
    </div>
  </section>

  <section class="landing-section quickstart-section" id="quickstart">
    <div class="landing-inner section-heading">
      <p class="eyebrow">{t.quickstartEyebrow}</p>
      <h2>{t.quickstartTitle}</h2>
      <p>{t.quickstartLead}</p>
      <div class="doc-actions">
        <a class="button button-primary" href="https://isecure.fi/wsapi_v2/index.html">{t.docsCta}</a>
        <a
          class="button button-secondary"
          href="https://github.com/isecurefi/isecure-ts-client"
          target="_blank"
          rel="noopener"
        >
          TypeScript SDK
        </a>
      </div>
    </div>
    <div class="landing-inner quickstart-grid">
      {
        t.quickstart.map((step) => (
          <section class="quickstart-card">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </section>
        ))
      }
    </div>
  </section>

  <section class="landing-section bank-section" id="banks">
    <div class="landing-inner bank-panel">
      <p class="eyebrow">{t.banksEyebrow}</p>
      <h2>{t.banksTitle}</h2>
      <p>{t.banks}</p>
      <div class="bank-logo-panel">
        <BankLogos />
      </div>
    </div>
  </section>

  <section class="landing-section" id="model">
    <div class="landing-inner section-heading">
      <p class="eyebrow">{t.whyEyebrow}</p>
      <h2>{t.whyTitle}</h2>
      <p>{t.whyLead}</p>
    </div>
    <div class="landing-inner benefit-grid">
      {
        t.benefits.map((benefit) => (
          <section class="benefit-card">
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </section>
        ))
      }
    </div>
  </section>

  <section class="landing-section architecture-section" id="api">
    <div class="landing-inner split-grid">
      <div>
        <p class="eyebrow">{t.architectureEyebrow}</p>
        <h2>{t.architectureTitle}</h2>
        <p>{t.architectureLead}</p>
        <div class="doc-actions architecture-actions">
          <a class="button button-primary" href="https://isecure.fi/wsapi_v2/index.html">{t.docsCta}</a>
          <a class="button button-secondary" href="https://isecure.fi/wsapi_v2.json">{t.openApiCta}</a>
        </div>
      </div>
      <div class="flow-panel" aria-label={t.architectureTitle}>
        {
          t.flow.map((step, index) => (
            <>
              <div class="flow-step">
                <span>{index + 1}</span>
                <strong>{step}</strong>
              </div>
              {index < t.flow.length - 1 && <div class="flow-line" aria-hidden="true" />}
            </>
          ))
        }
        <aside class="flow-callout flow-callout-secondary">
          <h3>{t.infrastructureOption.title}</h3>
          <p>{t.infrastructureOption.text}</p>
        </aside>
        <aside class="flow-callout">
          <h3>{t.sftpOption.title}</h3>
          <p>{t.sftpOption.text}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="landing-section management-app-section" id="management-app">
    <div class="landing-inner management-app-panel">
      <div>
        <p class="eyebrow">{t.managementApp.eyebrow}</p>
        <h2>{t.managementApp.title}</h2>
        <p>{t.managementApp.text}</p>
      </div>
      <div class="management-app-meta">
        <div class="platform-list" aria-label={t.managementApp.platformsLabel}>
          {["macOS", "Windows", "iOS", "Android"].map((platform) => <span>{platform}</span>)}
        </div>
        <a class="button button-primary" href="#contact">{t.managementApp.cta}</a>
      </div>
    </div>
  </section>

  <section class="landing-section sdk-section" id="sdks">
    <div class="landing-inner section-heading">
      <p class="eyebrow">{t.sdkEyebrow}</p>
      <h2>{t.sdkTitle}</h2>
      <p>{t.sdkLead}</p>
    </div>
    <div class="landing-inner sdk-grid">
      {
        t.sdks.map((sdk) => (
          <section class="sdk-card">
            <div>
              <h3>
                {sdk.href ? (
                  <a href={sdk.href} target="_blank" rel="noopener">
                    {sdk.title}
                  </a>
                ) : (
                  sdk.title
                )}
              </h3>
              <span>{sdk.status}</span>
            </div>
            <p>{sdk.text}</p>
          </section>
        ))
      }
    </div>
  </section>

  <section class="landing-section pricing-section" id="pricing">
    <div class="landing-inner section-heading">
      <p class="eyebrow">{t.pricingEyebrow}</p>
      <h2>{t.pricingTitle}</h2>
      <p>{t.pricingLead}</p>
    </div>
    <div class="landing-inner pricing-panel">
      <div class="pricing-main">
        <p class="pricing-from-label">{t.pricingFromLabel}</p>
        <p class="pricing-price">{t.pricingFrom}</p>
        <p class="pricing-from-note">{t.pricingFromNote}</p>
        <p class="pricing-analogy">{t.pricingAnalogy}</p>
        <ul class="pricing-included">{t.pricingIncluded.map((item) => <li>{item}</li>)}</ul>
        <div class="doc-actions">
          <a class="button button-primary" href="#quickstart">{t.primaryCta}</a>
          <a class="button button-secondary" href="#contact">{t.pricingContactCta}</a>
        </div>
      </div>
      <div class="pricing-breakdown">
        {
          t.pricing.map((item) => (
            <div class="pricing-row">
              <div>
                <strong>{item.label}</strong>
                <p>{item.text}</p>
              </div>
              <span>{item.value}</span>
            </div>
          ))
        }
        <p class="pricing-example">{t.pricingExample}</p>
        <p class="pricing-note">{t.pricingNote}</p>
      </div>
    </div>
  </section>

  <section class="landing-section faq-section" id="faq">
    <div class="landing-inner">
      <p class="eyebrow">{t.faqEyebrow}</p>
      <h2>{t.faqTitle}</h2>
      <div class="faq-grid">
        {
          t.faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</article>

<script is:inline>
  (() => {
    if (!document.body.classList.contains("banking-theme-page")) return;

    const savedTheme = localStorage.getItem("isecure-banking-theme");
    const initialTheme = savedTheme === "dark" ? "dark" : "light";
    const buttons = document.querySelectorAll("[data-theme-choice]");

    function setTheme(theme) {
      document.documentElement.dataset.isecureTheme = theme;
      document.body.dataset.isecureTheme = theme;
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", button.dataset.themeChoice === theme ? "true" : "false");
      });
      localStorage.setItem("isecure-banking-theme", theme);
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => setTheme(button.dataset.themeChoice));
    });

    setTheme(initialTheme);
  })();
</script>

<style>
  :global(html.banking-theme-root),
  :global(body.banking-theme-page) {
    --landing-ink: #eaf2f4;
    --landing-muted: #9fb1bf;
    --landing-line: rgba(255, 255, 255, 0.14);
    --landing-soft: #0d1820;
    --landing-accent: #4fd1c5;
    --landing-accent-strong: #35b8ad;
    --landing-primary-bg: #4fd1c5;
    --landing-primary-hover: #35b8ad;
    --landing-primary-ink: #061314;
    --landing-blue: #8ab4ff;
    --landing-bg: #071116;
    --landing-card: #101c25;
    --landing-card-strong: #142633;
    --landing-hero-bg: radial-gradient(circle at 18% 12%, rgba(79, 209, 197, 0.2), transparent 34%),
      linear-gradient(120deg, #071116 0%, #0c1825 54%, #071116 100%);
    --landing-code-bg: #09131b;
    --landing-code-ink: #d8f6f1;
    --landing-code-muted: #a8b6c2;
    --landing-code-line: rgba(255, 255, 255, 0.12);
    --landing-code-head: rgba(255, 255, 255, 0.05);
    --landing-code-keyword: #8ab4ff;
    --landing-code-string: #8ee8c8;
    --landing-code-title: #ffd166;
    --landing-code-property: #c3e88d;
    --landing-code-number: #ffb86c;
    --landing-code-comment: #7a8794;
  }

  :global(html.banking-theme-root[data-isecure-theme="light"]),
  :global(body.banking-theme-page[data-isecure-theme="light"]) {
    --landing-ink: #12212f;
    --landing-muted: #526173;
    --landing-line: #dce5ea;
    --landing-soft: #f4f8f9;
    --landing-accent: #006f6a;
    --landing-accent-strong: #005a56;
    --landing-primary-bg: #b8eee7;
    --landing-primary-hover: #9fe4dc;
    --landing-primary-ink: #073936;
    --landing-blue: #174ea6;
    --landing-bg: #ffffff;
    --landing-card: #ffffff;
    --landing-card-strong: #f8fbfc;
    --landing-hero-bg: linear-gradient(120deg, rgba(0, 111, 106, 0.12), rgba(23, 78, 166, 0.08)), #f8fbfc;
    --landing-code-bg: #f8fbfc;
    --landing-code-ink: #13212d;
    --landing-code-muted: #64748b;
    --landing-code-line: #dce5ea;
    --landing-code-head: #edf4f6;
    --landing-code-keyword: #174ea6;
    --landing-code-string: #007a5a;
    --landing-code-title: #9a5b00;
    --landing-code-property: #006f6a;
    --landing-code-number: #a33b00;
    --landing-code-comment: #687789;
  }

  .banking-landing {
    color: var(--landing-ink);
    background: var(--landing-bg);
  }

  :global(html.banking-theme-root),
  :global(body.banking-theme-page) {
    background: var(--landing-bg);
  }

  :global(body.banking-theme-page .navbar) {
    background: var(--landing-bg) !important;
    border-bottom: 0 !important;
    box-shadow: none !important;
  }

  :global(body.banking-theme-page .navbar .nav-link),
  :global(body.banking-theme-page .navbar-brand),
  :global(body.banking-theme-page .lang-link) {
    color: var(--landing-ink);
  }

  :global(body.banking-theme-page .navbar-brand) {
