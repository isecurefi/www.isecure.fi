---
import { getText } from '../store/translations';
import type { Lang } from '../types';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', text: getText('nav.home', lang) },
  { href: '/ws-kanava', text: getText('nav.wsChannel', lang) },
  { href: '/ws-api', text: getText('nav.api', lang) },
  { href: '#contact', text: getText('nav.contact', lang) }
].map(item => ({
  ...item,
  href: item.href.startsWith('#') ? item.href : `${item.href}?lang=${lang}`
}));
---
<nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm" role="navigation">
  <div class="container">
    <a class="navbar-brand" href="/">
      <img src="/images/isecure-small-logo.png" style="height:40px" alt="iSecure">
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="nav navbar-nav navbar-right me-auto">
        {navItems.map(item => (
          <li class="nav-item">
            <a class="nav-link" href={item.href}>{item.text}</a>
          </li>
        ))}
      </ul>
      <LanguageSwitcher currentLang={lang} />
    </div>
  </div>
</nav>
