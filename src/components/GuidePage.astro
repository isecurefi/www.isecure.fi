---
import CatalogFaqGlossary from "./CatalogFaqGlossary.astro";
import CapabilityDirectionTable from "./CapabilityDirectionTable.astro";
import CatalogStatus from "./CatalogStatus.astro";
import ProviderDetail from "./ProviderDetail.astro";
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import type { Lang } from "../types";
import Actions from "./ui/Actions.astro";
import Button from "./ui/Button.astro";
import Callout from "./ui/Callout.astro";
import Card from "./ui/Card.astro";
import CardGrid from "./ui/CardGrid.astro";
import PageHero from "./ui/PageHero.astro";
import Prose from "./ui/Prose.astro";
import Section from "./ui/Section.astro";
import SectionHeading from "./ui/SectionHeading.astro";

// Shared presentational component for keyword-targeted content pages.
// Each topic passes its trilingual `content` and a `related` cross-link list;
// this renders consistent, indexable markup with hreflang alternates.
interface GuideSection {
  h2: string;
  paras: string[];
  list?: string[];
}
interface Source {
  href: string;
  label: string;
}
interface LangContent {
  title: string;
  description: string;
  h1: string;
  intro: string;
  sections: GuideSection[];
  sources?: Source[];
  cta?: {
    title: string;
    text: string;
    label: string;
  };
}
interface Related {
  slug: string;
  fi: string;
  en: string;
  se: string;
}
interface Props {
  lang: Lang;
  slug: string;
  content: Record<Lang, LangContent>;
  related?: Related[];
  catalogId?: string;
}

const { lang, slug, content, related = [], catalogId } = Astro.props;
const t = content[lang];
const catalogRecord = catalogId ? getCatalogRecord(catalogId) : undefined;
const relatedTitle = { fi: "Lue myös", en: "See also", se: "Läs även" }[lang];
const sourcesTitle = {
  fi: "Virallinen lähde",
  en: "Official source",
  se: "Officiell källa",
}[lang];
const relatedHref = (s: string) =>
  lang === "fi" ? `/${s}/` : `/${lang}/${s}/`;
---

<CatalogPageLayout
  title={t.title}
  lang={lang}
  description={t.description}
  {slug}
  record={catalogRecord}
  fullWidth
>
  <PageHero slot="hero" title={t.h1} lead={t.intro} />

  <Section>
    <article class="guide-page">
      <Prose>
        {
          t.sections.map((s) => (
            <section>
              <h2>{s.h2}</h2>
              {s.paras.map((p) => (
                <p>{p}</p>
              ))}
              {s.list && (
                <ul>
                  {s.list.map((li) => (
                    <li>{li}</li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </Prose>

      {
        t.sources && t.sources.length > 0 && (
          <div class="guide-sources">
            <Callout tone="note">
              <h2>{sourcesTitle}</h2>
              <ul>
                {t.sources.map((source) => (
                  <li>
                    <a href={source.href}>{source.label}</a>
                  </li>
                ))}
              </ul>
            </Callout>
          </div>
        )
      }
    </article>
  </Section>

  {
    catalogRecord?.kind === "product" && (
      <Section tone="band">
        <CatalogStatus lang={lang} record={catalogRecord} />
        <CapabilityDirectionTable lang={lang} record={catalogRecord} />
        <CatalogFaqGlossary lang={lang} record={catalogRecord} />
      </Section>
    )
  }

  {
    catalogRecord?.kind === "integration" && (
      <Section tone="band">
        <ProviderDetail lang={lang} record={catalogRecord} />
      </Section>
    )
  }

  {
    t.cta && (
      <Section tone="band" class="guide-cta">
        <SectionHeading title={t.cta.title} lead={t.cta.text} align="center">
          <Actions align="center">
            <Button href="#contact">{t.cta.label}</Button>
          </Actions>
        </SectionHeading>
      </Section>
    )
  }

  {
    related.length > 0 && (
      <Section class="guide-related">
        <SectionHeading title={relatedTitle} />
        <CardGrid columns={related.length >= 4 ? 4 : 3}>
          {related.map((r) => (
            <Card title={r[lang]} href={relatedHref(r.slug)} icon="arrow" />
          ))}
        </CardGrid>
      </Section>
    )
  }
</CatalogPageLayout>

<style>
  /* Prose resets the first heading in each section, so space sections here. */
  .guide-page section + section {
    margin-top: 2.4em;
  }

  .guide-sources {
    margin-top: 48px;
    max-width: 780px;
  }

  .guide-sources h2 {
    color: var(--landing-ink);
    font-size: 1.05rem;
    margin: 0 0 8px;
  }

  .guide-sources ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
