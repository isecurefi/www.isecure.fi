---
import CatalogFaqGlossary from "./CatalogFaqGlossary.astro";
import CapabilityDirectionTable from "./CapabilityDirectionTable.astro";
import CatalogStatus from "./CatalogStatus.astro";
import ProviderDetail from "./ProviderDetail.astro";
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import type { Lang } from "../types";
import Actions from "./ui/Actions.astro";
import Button from "./ui/Button.astro";
import Callout from "./ui/Callout.astro";
import Card from "./ui/Card.astro";
import CardGrid from "./ui/CardGrid.astro";
import FaqList from "./ui/FaqList.astro";
import PageHero from "./ui/PageHero.astro";
import Prose from "./ui/Prose.astro";
import Section from "./ui/Section.astro";
import SectionHeading from "./ui/SectionHeading.astro";

// Shared presentational component for keyword-targeted content pages.
// Each topic passes its trilingual `content` and a `related` cross-link list;
// this renders consistent, indexable markup with hreflang alternates.
interface GuideSection {
  h2: string;
  paras: string[];
  list?: string[];
  // Element path → meaning rows, rendered as a two-column table.
  fields?: Array<[string, string]>;
  fieldsHeaders?: [string, string];
  // First column renders as <code> unless set to false.
  fieldsCode?: boolean;
  // Shortened illustrative XML, rendered verbatim.
  xml?: string;
}
interface Source {
  href: string;
  label: string;
}
interface LangContent {
  title: string;
  description: string;
  h1: string;
  intro: string;
  sections: GuideSection[];
  sources?: Source[];
  // Rendered as an accordion and published as FAQPage structured data.
  faq?: Array<{ q: string; a: string }>;
  cta?: {
    title: string;
    text: string;
    label: string;
  };
}
interface Related {
  slug: string;
  fi: string;
  en: string;
  se: string;
}
interface Props {
  lang: Lang;
  slug: string;
  content: Record<Lang, LangContent>;
  related?: Related[];
  catalogId?: string;
}

const { lang, slug, content, related = [], catalogId } = Astro.props;
const t = content[lang];
const catalogRecord = catalogId ? getCatalogRecord(catalogId) : undefined;
const relatedTitle = { fi: "Lue myös", en: "See also", se: "Läs även" }[lang];
const sourcesTitle = {
  fi: "Lähteet",
  en: "Sources",
  se: "Källor",
}[lang];
const faqTitle = {
  fi: "Usein kysyttyä",
  en: "Frequently asked questions",
  se: "Vanliga frågor",
}[lang];
const defaultFieldHeaders = {
  fi: ["Elementti", "Merkitys"],
  en: ["Element", "Meaning"],
  se: ["Element", "Betydelse"],
}[lang];
const relatedHref = (s: string) =>
  lang === "fi" ? `/${s}/` : `/${lang}/${s}/`;
const exampleIndex = t.sections.findIndex((section) => section.xml);
const exampleCopy = {
  fi: {
    jump: "Katso XML-esimerkki",
    copy: "Kopioi XML-esimerkki",
    copied: "Kopioitu",
    failed: "Valitse ja kopioi XML käsin.",
    download: "Lataa kokonainen synteettinen alkutiliote (XML)",
    note: "Simulaattorin camt.053.001.02-alkutiliote: 10 miljoonan euron testisaldo, ei tapahtumia. Erillinen, kokonainen tiedosto; yllä oleva esimerkki on lyhennetty.",
  },
  en: {
    jump: "View XML example",
    copy: "Copy XML example",
    copied: "Copied",
    failed: "Select and copy the XML manually.",
    download: "Download complete synthetic opening statement (XML)",
    note: "Simulator camt.053.001.02 opening statement: EUR 10 million test balance, no transactions. This is a separate complete file; the example above is shortened.",
  },
  se: {
    jump: "Visa XML-exempel",
    copy: "Kopiera XML-exempel",
    copied: "Kopierat",
    failed: "Markera och kopiera XML-texten manuellt.",
    download: "Ladda ner ett komplett syntetiskt öppningskontoutdrag (XML)",
    note: "Simulatorns camt.053.001.02-öppningskontoutdrag: testsaldo på 10 miljoner euro, inga transaktioner. Detta är en separat komplett fil; exemplet ovan är förkortat.",
  },
}[lang];
---

<CatalogPageLayout
  title={t.title}
  lang={lang}
  description={t.description}
  {slug}
  record={catalogRecord}
  faq={t.faq}
  fullWidth
>
  <PageHero slot="hero" title={t.h1} lead={t.intro}>
    {
      exampleIndex >= 0 && (
        <Actions>
          <Button href="#xml-example" variant="secondary">
            {exampleCopy.jump}
          </Button>
        </Actions>
      )
    }
  </PageHero>

  <Section>
    <article class="guide-page">
      <Prose>
        {
          t.sections.map((s, sectionIndex) => (
            <section>
              <h2>{s.h2}</h2>
              {s.paras.map((p) => (
                <p>{p}</p>
              ))}
              {s.list && (
                <ul>
                  {s.list.map((li) => (
                    <li>{li}</li>
                  ))}
                </ul>
              )}
              {s.fields && (
                <table>
                  <thead>
                    <tr>
                      <th>{(s.fieldsHeaders ?? defaultFieldHeaders)[0]}</th>
                      <th>{(s.fieldsHeaders ?? defaultFieldHeaders)[1]}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {s.fields.map(([path, meaning]) => (
                      <tr>
                        <td>
                          {s.fieldsCode === false ? (
                            path
                          ) : (
                            <code>
                              {path.split("/").map((part, i) => (
                                <>
                                  {i > 0 && "/"}
                                  {i > 0 && <wbr />}
                                  {part}
                                </>
                              ))}
                            </code>
                          )}
                        </td>
                        <td>{meaning}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              {s.xml && (
                <div
                  id={sectionIndex === exampleIndex ? "xml-example" : undefined}
                >
                  <div class="example-tools">
                    <button
                      type="button"
                      data-copy-example
                      data-copied={exampleCopy.copied}
                      data-copy-failed={exampleCopy.failed}
                      data-analytics-content-type="developer-resource"
                      data-analytics-item-id={`${slug}-xml-copy`}
                      data-analytics-source="guide-example"
                    >
                      {exampleCopy.copy}
                    </button>
                    <span data-copy-status role="status" aria-live="polite" />
                  </div>
                  <pre set:text={s.xml} />
                  {slug === "camt-053" && (
                    <div class="example-download">
                      <a
                        href="/examples/camt-053.001.02-opening.xml"
                        download
                        data-analytics-content-type="developer-resource"
                        data-analytics-item-id="camt-053-opening-xml"
                        data-analytics-source="guide-example"
                      >
                        {exampleCopy.download}
                      </a>
                      <p>{exampleCopy.note}</p>
                    </div>
                  )}
                </div>
              )}
            </section>
          ))
        }
      </Prose>

      {
        t.faq && t.faq.length > 0 && (
          <section class="guide-faq">
            <h2>{faqTitle}</h2>
            <FaqList items={t.faq} />
          </section>
        )
      }

      {
        t.sources && t.sources.length > 0 && (
          <div class="guide-sources">
            <Callout tone="note">
              <h2>{sourcesTitle}</h2>
              <ul>
                {t.sources.map((source) => (
                  <li>
                    <a href={source.href}>{source.label}</a>
                  </li>
                ))}
              </ul>
            </Callout>
          </div>
        )
      }
    </article>
  </Section>

  {
    catalogRecord?.kind === "product" && (
      <Section tone="band">
        <CatalogStatus lang={lang} record={catalogRecord} />
        <CapabilityDirectionTable lang={lang} record={catalogRecord} />
        <CatalogFaqGlossary lang={lang} record={catalogRecord} />
      </Section>
    )
  }

  {
    catalogRecord?.kind === "integration" && (
      <Section tone="band">
        <ProviderDetail lang={lang} record={catalogRecord} />
      </Section>
    )
  }

  {
    t.cta && (
      <Section tone="band" class="guide-cta">
        <SectionHeading title={t.cta.title} lead={t.cta.text} align="center">
          <Actions align="center">
            <Button href="#contact">{t.cta.label}</Button>
          </Actions>
        </SectionHeading>
      </Section>
    )
  }

  {
    related.length > 0 && (
      <Section class="guide-related">
        <SectionHeading title={relatedTitle} />
        <CardGrid columns={related.length >= 4 ? 4 : 3}>
          {related.map((r) => (
            <Card title={r[lang]} href={relatedHref(r.slug)} icon="arrow" />
          ))}
        </CardGrid>
      </Section>
    )
  }
</CatalogPageLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-example]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const section = button.closest("section");
        const status =
          section?.querySelector<HTMLElement>("[data-copy-status]");
        const xml = section?.querySelector("pre")?.textContent;
        if (!status || !xml) return;
        try {
          await navigator.clipboard.writeText(xml);
          status.textContent = button.dataset.copied ?? "Copied";
        } catch {
          status.textContent =
            button.dataset.copyFailed ?? "Select and copy the XML manually.";
        }
      });
    });
</script>

<style>
  #xml-example {
    scroll-margin-top: 100px;
  }
  .example-tools {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 20px 0 10px;
    font-size: 13px;
  }
  .example-tools button {
    font: inherit;
    padding: 10px 14px;
    min-height: 44px;
    color: var(--landing-ink);
    background: var(--landing-card);
    border: 1px solid var(--landing-line);
    border-radius: 6px;
    cursor: pointer;
  }
  .example-tools button:focus-visible {
    outline: 2px solid var(--landing-accent);
    outline-offset: 3px;
  }
  .example-download {
    margin-top: 16px;
  }
  .example-download p {
    font-size: 13px;
    margin-top: 8px;
    color: var(--landing-muted);
  }
  /* Prose resets the first heading in each section, so space sections here. */
  .guide-page section + section {
    margin-top: 2.4em;
  }

  .guide-faq,
  .guide-sources {
    margin-top: 48px;
    max-width: 780px;
  }

  .guide-faq h2 {
    color: var(--landing-ink);
    font-size: 1.4rem;
    margin: 0 0 16px;
  }

  .guide-sources h2 {
    color: var(--landing-ink);
    font-size: 1.05rem;
    margin: 0 0 8px;
  }

  .guide-sources ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
