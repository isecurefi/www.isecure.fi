---
import { dailyCashContent } from "../data/dailyCash";
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import "../styles/DailyCash.css";
import type { Lang } from "../types";
import CapabilityDirectionTable from "./CapabilityDirectionTable.astro";
import CatalogStatus from "./CatalogStatus.astro";
import CatalogFaqGlossary from "./CatalogFaqGlossary.astro";
import DailyCashPositionPreview from "./DailyCashPositionPreview.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = dailyCashContent[lang];
const record = getCatalogRecord("daily-cash");
---

<CatalogPageLayout
  title={copy.meta.title}
  description={copy.meta.description}
  lang={lang}
  fullWidth={true}
  bodyClass="banking-theme-page daily-cash-product-page"
  {record}
>
  <article class="daily-cash-landing">
    <div class="preview-ribbon" role="note">
      <span aria-hidden="true"></span>
      {copy.previewLabel}
    </div>

    <header class="daily-cash-hero">
      <div class="daily-cash-shell hero-layout">
        <div class="hero-copy">
          <p class="section-eyebrow">{copy.hero.eyebrow}</p>
          <h1>{copy.hero.title}</h1>
          <p class="hero-lead">{copy.hero.lead}</p>
          <div class="hero-actions">
            <a class="cash-button cash-button-primary" href="#daily-cash-how"
              >{copy.hero.primaryAction}</a
            >
            <a
              class="cash-button cash-button-secondary"
              href="#daily-cash-status">{copy.hero.secondaryAction}</a
            >
          </div>
          <p class="hero-qualifier">
            <span aria-hidden="true">i</span>{copy.hero.qualifier}
          </p>
        </div>
        <DailyCashPositionPreview copy={copy.dashboard} />
      </div>
    </header>

    <section class="plain-section">
      <div class="daily-cash-shell plain-layout">
        <p class="section-eyebrow">{copy.plain.eyebrow}</p>
        <div>
          <h2>{copy.plain.title}</h2>
          <p>{copy.plain.body}</p>
        </div>
      </div>
    </section>

    <section class="daily-cash-section value-section">
      <div class="daily-cash-shell">
        <p class="section-eyebrow">{copy.value.eyebrow}</p>
        <h2>{copy.value.title}</h2>
        <div class="value-grid">
          {
            copy.value.items.map((item, index) => (
              <article class="value-card">
                <span class="value-index">0{index + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="daily-cash-section how-section" id="daily-cash-how">
      <div class="daily-cash-shell">
        <p class="section-eyebrow">{copy.how.eyebrow}</p>
        <h2>{copy.how.title}</h2>
        <ol class="process-grid">
          {
            copy.how.steps.map((step) => (
              <li>
                <span>{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="daily-cash-section essentials-section">
      <div class="daily-cash-shell essentials-layout">
        <div class="essentials-intro">
          <p class="section-eyebrow">{copy.essentials.eyebrow}</p>
          <h2>{copy.essentials.title}</h2>
          <p>{copy.essentials.lead}</p>
        </div>
        <dl class="essentials-list">
          {
            copy.essentials.rows.map((row) => (
              <div>
                <dt>{row.capability}</dt>
                <dd>{row.answer}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="daily-cash-section trust-section">
      <div class="daily-cash-shell">
        <p class="section-eyebrow">{copy.trust.eyebrow}</p>
        <h2>{copy.trust.title}</h2>
        <div class="trust-grid">
          {
            copy.trust.items.map((item) => (
              <article>
                <span class="trust-mark" aria-hidden="true">
                  ✓
                </span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="daily-cash-section" id="daily-cash-status">
      <div class="daily-cash-shell">
        <CatalogStatus {lang} {record} />
        <CapabilityDirectionTable {lang} {record} />
        <CatalogFaqGlossary {lang} {record} />
      </div>
    </section>
  </article>
</CatalogPageLayout>
