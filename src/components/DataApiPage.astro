const t = content[lang];
const privacyHref = lang === "fi" ? "/privacy/" : `/${lang}/privacy/`;
---

<Layout
  title={t.title}
  lang={lang}
  description={t.description}
  alternateLinks={alternateLinks}
  bodyClass="banking-theme-page"
  fullWidth
>
  <div class="bda">
    <header class="bda-hero">
      <div class="bda-inner bda-hero-inner">
        <p class="bda-eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.h1}</h1>
        <p class="bda-sub">{t.hero.sub}</p>
        <div class="bda-hero-actions">
          <a class="bda-btn" href="#waitlist">{t.hero.cta}</a>
          <span class="bda-reassure">{t.hero.reassure}</span>
        </div>
      </div>
    </header>

    <section class="bda-section" aria-labelledby="bda-pain">
      <div class="bda-inner">
        <p class="bda-eyebrow">{t.pain.eyebrow}</p>
        <h2 id="bda-pain">{t.pain.title}</h2>
        {t.pain.paras.map((p) => <p class="bda-lead">{p}</p>)}
      </div>
    </section>

    <section class="bda-section" aria-labelledby="bda-how">
      <div class="bda-inner">
        <p class="bda-eyebrow">{t.how.eyebrow}</p>
        <h2 id="bda-how">{t.how.title}</h2>
        <p class="bda-lead">{t.how.lead}</p>
        <ol class="bda-flow" aria-label={t.how.title}>
          {
            t.how.nodes.map((n, i) => (
              <li class="bda-flow-node">
                <span class="bda-flow-step">{i + 1}</span>
                <span>{n}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bda-section" aria-labelledby="bda-outputs">
      <div class="bda-inner bda-outputs">
        <div>
          <p class="bda-eyebrow">{t.outputs.eyebrow}</p>
          <h2 id="bda-outputs">{t.outputs.title}</h2>
          <ul class="bda-checks">
            {t.outputs.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
        <figure class="bda-code">
          <pre tabindex="0" aria-label="JSON"><code>{jsonExample}</code></pre>
          <figcaption>{t.outputs.jsonCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="bda-section" aria-labelledby="bda-why">
      <div class="bda-inner">
        <p class="bda-eyebrow">{t.why.eyebrow}</p>
        <h2 id="bda-why">{t.why.title}</h2>
        <div class="bda-grid">
          {
            t.why.items.map((it) => (
              <div class="bda-card">
                <h3>{it.t}</h3>
                <p>{it.d}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bda-section" aria-labelledby="bda-workflow">
      <div class="bda-inner">
        <p class="bda-eyebrow">{t.workflow.eyebrow}</p>
        <h2 id="bda-workflow">{t.workflow.title}</h2>
        <ol class="bda-steps">
          {
            t.workflow.steps.map((s, i) => (
              <li>
                <span class="bda-step-num">{i + 1}</span>
                <div>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bda-section" aria-labelledby="bda-early">
      <div class="bda-inner bda-early">
        <div>
          <p class="bda-eyebrow">{t.early.eyebrow}</p>
          <h2 id="bda-early">{t.early.title}</h2>
          <ul class="bda-checks">
            {t.early.benefits.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div class="bda-card bda-partner">
          <h3>{t.early.partnerTitle}</h3>
          <ul>
            {t.early.partner.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="bda-section" aria-labelledby="bda-faq">
      <div class="bda-inner bda-faq">
        <p class="bda-eyebrow">{t.faq.eyebrow}</p>
        <h2 id="bda-faq">{t.faq.title}</h2>
        {
          t.faq.items.map((f) => (
            <details class="bda-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="bda-section bda-waitlist-section" id="waitlist" aria-labelledby="bda-form">
      <div class="bda-inner bda-form-wrap">
        <p class="bda-eyebrow">{t.form.eyebrow}</p>
        <h2 id="bda-form">{t.form.title}</h2>
        <p class="bda-lead">{t.form.lead}</p>

        <form
          id="bda-waitlist-form"
          class="bda-form"
          method="post"
          data-endpoint=""
          data-sending={t.form.sending}
          data-success={t.form.success}
          data-error={t.form.error}
          data-noendpoint={t.form.noendpoint}
          novalidate
        >
          <div class="bda-field">
            <label for="wl-email">{t.form.email} <span class="bda-req" aria-hidden="true">*</span></label>
            <input id="wl-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="bda-field">
            <label for="wl-company">{t.form.company} <span class="bda-req" aria-hidden="true">*</span></label>
            <input id="wl-company" name="company" type="text" autocomplete="organization" required />
          </div>
          <div class="bda-field">
            <label for="wl-role">{t.form.role} <span class="bda-opt">({t.form.optional})</span></label>
            <input id="wl-role" name="role" type="text" autocomplete="organization-title" />
          </div>
          <div class="bda-field">
            <label for="wl-problem">{t.form.problem} <span class="bda-opt">({t.form.optional})</span></label>
            <textarea id="wl-problem" name="problem" rows="3"></textarea>
          </div>
          <div class="bda-field">
            <label for="wl-interest">{t.form.interest} <span class="bda-opt">({t.form.optional})</span></label>
            <input id="wl-interest" name="interest" type="text" />
          </div>
          <p class="bda-privacy" id="wl-privacy">
            {t.form.privacy.replace(/\s*[^.]*$/, "")}
            <a href={privacyHref}>{lang === "fi" ? "tietosuojaseloste" : lang === "se" ? "integritetspolicy" : "privacy policy"}</a>.
          </p>
          <button type="submit" class="bda-btn" aria-describedby="wl-privacy">{t.form.submit}</button>
          <p class="bda-status" data-status role="status" aria-live="polite"></p>
          <p class="bda-fallback">{t.form.fallback} <a href="mailto:sales@isecure.fi?subject=Bank%20Data%20%26%20Evidence%20API%20early%20access">sales@isecure.fi</a></p>
        </form>
      </div>
    </section>
  </div>
</Layout>

<style>
