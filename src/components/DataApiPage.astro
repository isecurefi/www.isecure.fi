---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../types";

// Early-access waitlist landing page for the "Bank Data & Evidence API" (working name).
// Factually conservative: early access, no universal bank/ISO coverage claims, no
// real-time claims, no auto-bookkeeping. File Exchange API remains unchanged.
// Form is ready to POST to a backend via data-endpoint; no endpoint is invented here.

const { lang } = Astro.props;

const origin = "https://www.isecure.fi";
const alternateLinks = [
  { hreflang: "fi", href: `${origin}/data-api/` },
  { hreflang: "en", href: `${origin}/en/data-api/` },
  { hreflang: "sv", href: `${origin}/se/data-api/` },
  { hreflang: "x-default", href: `${origin}/data-api/` },
];

// Language-neutral, illustrative response. Marked provisional in the caption.
const jsonExample = `{
  "resource": "statement",
  "account": "FI21 1234 5600 0007 85",
  "currency": "EUR",
  "balances": [
    { "type": "closingBooked", "amount": "10450.00" }
  ],
  "entries": [
    {
      "id": "ntry_8f2a1c",
      "amount": "-1200.00",
      "bookingDate": "2026-07-12",
      "status": "booked",
      "reference": "RF9812345678",
      "evidence": {
        "sourceFile": "camt053_20260712.xml",
        "isoMessage": "camt.053.001.08",
        "path": "/Document/BkToCstmrStmt/Stmt/Ntry[3]"
      }
    }
  ]
}`;

