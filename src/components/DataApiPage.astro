<script>
  const form = document.getElementById("bda-waitlist-form") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector("[data-status]") as HTMLElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const label = btn.textContent || "";
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const endpoint = form.dataset.endpoint;
      status.textContent = "";
      if (!endpoint) {
        status.textContent = form.dataset.noendpoint || "";
        return;
      }
      btn.disabled = true;
      btn.textContent = form.dataset.sending || label;
      try {
        const body = JSON.stringify(Object.fromEntries(new FormData(form) as any));
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
        });
        if (!res.ok) throw new Error();
        form.reset();
        status.textContent = form.dataset.success || "";
      } catch {
        status.textContent = form.dataset.error || "";
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  }
</script>
