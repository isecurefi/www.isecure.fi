---
// Content card. With href, the title link covers the whole card.
import IconTile from "./IconTile.astro";
import type { IconName } from "./icons";

interface Props {
  title?: string;
  icon?: IconName;
  href?: string;
  linkLabel?: string;
  external?: boolean;
  headingLevel?: 2 | 3;
  tone?: "default" | "accent";
  // Analytics attributes are forwarded to the title link.
  [key: `data-${string}`]: string | undefined;
}

const {
  title,
  icon,
  href,
  linkLabel,
  external = false,
  headingLevel = 3,
  tone = "default",
  ...linkData
} = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

<article class:list={["ui-card", `is-${tone}`, { "is-linked": href }]}>
  {icon && <IconTile name={icon} />}
  <slot name="header" />
  {
    title && (
      <Heading class="ui-card-title">
        {href ? (
          <a
            {href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener" : undefined}
            {...linkData}
          >
            {title}
          </a>
        ) : (
          title
        )}
      </Heading>
    )
  }
  {
    Astro.slots.has("default") && (
      <div class="ui-card-body">
        <slot />
      </div>
    )
  }
  {
    href && linkLabel && (
      <span class="ui-card-more" aria-hidden="true">
        {linkLabel} →
      </span>
    )
  }
</article>

<style>
  .ui-card {
    background: var(--landing-card);
    border: 1px solid var(--landing-line);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgba(16, 24, 32, 0.04);
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    position: relative;
  }

  .is-accent {
    background:
      linear-gradient(
        135deg,
        rgba(79, 209, 197, 0.1),
        rgba(138, 180, 255, 0.08)
      ),
      var(--landing-card);
  }

  .is-linked {
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }

  .is-linked:hover {
    border-color: var(--landing-accent);
    box-shadow: 0 18px 40px rgba(16, 24, 32, 0.1);
    transform: translateY(-3px);
  }

  .ui-card :global(.ui-icon-tile) {
    margin-bottom: 6px;
  }

  .ui-card-title {
    color: var(--landing-ink);
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0;
  }

  .ui-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .ui-card-title a::after {
    content: "";
    inset: 0;
    position: absolute;
  }

  .ui-card-title a:focus-visible {
    outline: none;
  }

  .ui-card:has(.ui-card-title a:focus-visible) {
    outline: 2px solid var(--landing-accent);
    outline-offset: 3px;
  }

  .ui-card-body {
    color: var(--landing-muted);
    line-height: 1.65;
  }

  .ui-card-body :global(p) {
    margin: 0 0 10px;
  }

  .ui-card-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .ui-card-more {
    color: var(--landing-accent);
    font-weight: 700;
    margin-top: auto;
    padding-top: 6px;
  }
</style>
