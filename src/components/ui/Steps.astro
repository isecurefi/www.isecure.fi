---
// Numbered steps: a row with connectors, or a vertical timeline.
interface Props {
  steps: readonly ({ title: string; text?: string } | string)[];
  direction?: "row" | "column";
}

const { steps, direction = "row" } = Astro.props;
const items = steps.map((step) =>
  typeof step === "string" ? { title: step, text: undefined } : step,
);
---

<ol class:list={["ui-steps", `is-${direction}`]}>
  {
    items.map((step, index) => (
      <li>
        <span class="ui-step-number" aria-hidden="true">
          {index + 1}
        </span>
        <div>
          <h3>{step.title}</h3>
          {step.text && <p>{step.text}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .ui-steps {
    display: grid;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .is-row {
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
  }

  li {
    position: relative;
  }

  .ui-step-number {
    align-items: center;
    background: var(--landing-accent);
    border-radius: 999px;
    box-shadow: 0 0 0 6px rgba(79, 209, 197, 0.16);
    color: var(--landing-bg);
    display: inline-flex;
    flex: none;
    font-weight: 800;
    height: 42px;
    justify-content: center;
    width: 42px;
  }

  .is-row li:not(:last-child)::after {
    background: linear-gradient(90deg, var(--landing-accent), transparent);
    content: "";
    height: 1px;
    left: 58px;
    opacity: 0.45;
    position: absolute;
    right: -20px;
    top: 21px;
  }

  .is-row h3 {
    margin-top: 18px;
  }

  .is-column {
    gap: 0;
  }

  .is-column li {
    display: grid;
    gap: 18px;
    grid-template-columns: 42px minmax(0, 1fr);
    padding-bottom: 28px;
  }

  .is-column li:not(:last-child)::after {
    background: var(--landing-line);
    bottom: 4px;
    content: "";
    left: 20.5px;
    position: absolute;
    top: 52px;
    width: 1px;
  }

  .is-column h3 {
    padding-top: 9px;
  }

  h3 {
    color: var(--landing-ink);
    font-size: 1.08rem;
    line-height: 1.35;
    margin: 0 0 6px;
  }

  p {
    color: var(--landing-muted);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 980px) {
    .is-row {
      grid-auto-flow: row;
    }

    .is-row li::after {
      display: none;
    }
  }
</style>
