---
import ProductApiLinks from "./ProductApiLinks.astro";
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import type { Lang } from "../types";
import CatalogAccessSummary from "./CatalogAccessSummary.astro";
import Actions from "./ui/Actions.astro";
import Button from "./ui/Button.astro";
import Callout from "./ui/Callout.astro";
import Card from "./ui/Card.astro";
import CardGrid from "./ui/CardGrid.astro";
import CheckList from "./ui/CheckList.astro";
import PageHero from "./ui/PageHero.astro";
import Section from "./ui/Section.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Split from "./ui/Split.astro";
import Steps from "./ui/Steps.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const record = getCatalogRecord("processing-api");
const simulatorRecord = getCatalogRecord("bank-simulation");
if (simulatorRecord.visibility === "none") {
  throw new Error("Bank Simulator must have a public route");
}
const exampleUrl =
  "https://github.com/isecurefi/isecure-ts-client/blob/main/examples/processing-generate-file/README.md";
const sdkGuideUrl =
  "https://github.com/isecurefi/isecure-ts-client/blob/main/docs/processing.md";
const copy = {
  fi: {
    eyebrow: "Processing API",
    heading: "Valmistele pankin maksuaineistot hallitusti",
    lead: "Processing API auttaa ohjelmistoasi muodostamaan pankille lähetettävän maksuaineiston hallitulla työnkululla jo ennen oikean pankkisopimuksen ja tuotantovarmenteiden valmistumista. Se tarkistaa maksutiedot, lukitsee viimeistellyn version ja antaa sovelluksesi ladata täsmälleen saman tiedoston paikallista allekirjoitusta varten.",
    statusTitle: "Tuotevaihe ja käyttöoikeus",
    statusText:
      "Processing API on Beta-vaiheessa. Nordean Corporate Access -maksuaineistoprofiilit ovat Nordean validoimia Suomen, Ruotsin, Norjan ja Tanskan osalta. OP:n ja Danske Bankin Suomen SEPA-maksuaineistoprofiilit ovat saatavilla; niiden pankkikohtainen validointi on kesken. Säästöpankin, Oma Säästöpankin ja Ålandsbankenin Suomen SEPA-maksuaineistoprofiilit sekä POP Pankin ja Aktian pain.001.001.03-profiilit ovat saatavilla; niiden pankkikohtainen validointi ei ole vielä alkanut. Processing API on saatavilla vain tuotannossa erikseen käyttöönotetuille tilausasiakkaille. Testipalvelu on poistettu käytöstä. Maksunsaajan tarkistus (VoP) ei kuulu nykyiseen tuotantojulkaisuun.",
    pricingTitle: "Hinnoittelu (Beta)",
    pricingText:
      "Hinnat kuten Pankkiyhteydessä: 18 €/kk perusmaksu per integraattori, 2 €/kk per loppuasiakas (vähintään 10 asiakaslisenssiä), 200 € kertaluonteinen tuotantokäyttöönotto. Käyttöönottomaksua ei peritä nykyisiltä Pankkiyhteys-asiakkailta 31.12.2026 asti. Vuosilaskutus, hintoihin lisätään ALV.",
    flowTitle: "Näin maksuaineisto valmistuu",
    flow: [
      "Valitse pankille ja maalle sopiva maksuaineiston muoto käyttäjän käyttöoikeuksien rajoissa.",
      "Luo maksuerä ja lisää tai korjaa siihen kuuluvat maksut.",
      "Tarkista maksutiedot ja viimeistele versio XML-tiedoston muodostamista varten.",
      "Muodosta ja lataa viimeistellyn version tiedosto. Nykyinen tekninen tulostusmuoto on ISO 20022 pain.001.001.09, ja TypeScript SDK tarkistaa, ettei ladattu tiedosto ole muuttunut.",
    ],
    boundaryTitle: "Mihin Processing API:n vastuu päättyy",
    boundaries: [
      "Processing API ja Bank Connectivity käyttävät erillisiä kirjautumisistuntoja.",
      "Bank Connectivity hoitaa erikseen pankkivarmenteet sekä pankkitiedostojen listauksen, latauksen ja lähetyksen.",
      "Asiakkaan yksityinen allekirjoitusavain säilyy omassa sovelluksessa. Processing API ei vastaanota avainta eikä lähetä maksua pankkiin.",
      "Tiedoston muodostaminen ei hyväksy maksua. Lähetys edellyttää File Exchange -rajapinnan vaatimia PGP-allekirjoituksia.",
    ],
    relationshipTitle: "Valitse allekirjoituksen jälkeen testi tai tuotanto",
    processingLabel: "Processing API",
    processing: "Valmistelee ja muodostaa tarkistetun maksuaineiston.",
    localLabel: "Asiakkaan sovellus",
    local:
      "Tarkistaa ja allekirjoittaa ladatun tiedoston asiakkaan hallinnassa.",
    exchangeLabel: "Valitse kohde",
    exchange:
      "Käytä samaa File Exchange API:a nyt Pankkisimulaattorin ja myöhemmin erikseen pätevöidyn oikean pankkikohteen kanssa.",
    testPathTitle: "Testipolku · Pankkisimulaattori",
    testPath:
      "Lähetä allekirjoitettu synteettinen tiedosto pankille simulator erillisellä File Exchange -istunnolla ja nouda pain.002-, camt.054- ja päivitetty camt.053-aineisto.",
    testPathLimit:
      "Vanha Processing–Pankkisimulaattori-esimerkki edellyttää poistettua testipalvelua. Nykyinen aineistonmuodostusesimerkki ei lähetä tiedostoja. File Exchange -simulaattori on erillinen palvelu.",
    testPathLink: "Avaa Pankkisimulaattori",
    productionPathTitle: "Tuotantopolku · Bank Connectivity",
    productionPath:
      "Lähetä allekirjoitettu tiedosto tuettuun pankkiin vasta, kun asiakkaalla on erillinen Bank Connectivity -käyttöoikeus, pankkisopimus, tuotantotunnukset ja pätevöity yhteys.",
    transport:
      "Simulaattorin palaute on synteettistä eikä todista oikean pankin hyväksyntää, toteutunutta maksua tai tuotantokelpoisuutta.",
    exampleTitle: "Aja nykyinen Processing-esimerkki",
    exampleText:
      "SDK-esimerkki määrittää profiilin, luo ja tarkistaa luonnoksen, viimeistelee sen ja muodostaa XML-tiedoston. Se luo tietoja Processing-palveluun mutta ei lähetä mitään pankkiin.",
    exampleLabel: "Avaa Processing API -esimerkki",
    sdkLabel: "TypeScript SDK -käyttöohje",
    docsLabel: "Avaa Bank Connectivity -rajapinnan dokumentaatio",
  },
  en: {
    eyebrow: "Processing API",
    heading: "Prepare and validate bank payment files",
    lead: "Processing API helps your software prepare bank payment files through a controlled workflow before the real bank agreement and production certificates are ready. It checks the payment details, finalizes a version, and lets your application download the exact same file for local signing.",
    statusTitle: "Product stage and access",
    statusText:
      "Processing API is in Beta. Nordea Corporate Access payment-file profiles are Nordea validated for Finland, Sweden, Norway and Denmark. OP and Danske Bank Finland SEPA payment-file profiles are available; their bank validation is in progress. Säästöpankki, Oma Säästöpankki and Ålandsbanken Finland SEPA payment-file profiles and the POP Pankki and Aktia pain.001.001.03 profiles are available; their bank validation has not started. Processing API is available only in production for separately onboarded subscribers. The test service has been retired. Verification of Payee (VoP) is not part of the current production release.",
    pricingTitle: "Pricing (Beta)",
    pricingText:
      "Priced like Bank Connectivity: 18 €/month base fee per integrator, 2 €/month per end customer (minimum 10 customer licenses), 200 € one-time production onboarding. Onboarding is waived for existing Bank Connectivity customers until 31 December 2026. Annual billing, VAT added on top.",
    flowTitle: "How a payment file is prepared",
    flow: [
      "Choose the payment-file format for the bank and country within the user's access rights.",
      "Create a payment batch and add or correct its payments.",
      "Validate the payment details and finalize the version used to generate XML.",
      "Generate and download the file for that finalized version. The current technical output is ISO 20022 pain.001.001.09, and the TypeScript SDK verifies that the downloaded file has not changed.",
    ],
    boundaryTitle: "Where Processing API's responsibility ends",
    boundaries: [
      "Processing API and Bank Connectivity use separate sign-in sessions.",
      "Bank Connectivity separately handles bank certificates and bank-file listing, download, and upload.",
      "The customer's private signing key stays in their own application. Processing API never receives the key and does not submit a payment to a bank.",
      "Generating a file does not approve a payment. Upload requires the PGP signatures enforced by File Exchange.",
    ],
    relationshipTitle: "Choose test or production after signing",
    processingLabel: "Processing API",
    processing: "Prepares and generates the checked payment file.",
    localLabel: "Customer application",
    local:
      "Verifies and signs the downloaded file under the customer's control.",
    exchangeLabel: "Choose destination",
    exchange:
      "Use the same File Exchange API with Bank Simulator now and a separately qualified real-bank destination later.",
    testPathTitle: "Test path · Bank Simulator",
    testPath:
      "Upload the signed synthetic file to bank simulator through a separate File Exchange session, then retrieve pain.002, camt.054, and the updated camt.053.",
    testPathLimit:
      "The historical Processing-to-Simulator example requires the retired test service. The current generation example uploads nothing. The File Exchange simulator is a separate service.",
    testPathLink: "Open Bank Simulator",
    productionPathTitle: "Production path · Bank Connectivity",
    productionPath:
      "Upload the signed file to a supported bank only after the customer has separate Bank Connectivity access, a bank agreement, production credentials, and a qualified connection.",
    transport:
      "Simulator feedback is synthetic; it does not prove real-bank acceptance, a completed payment, or production qualification.",
    exampleTitle: "Run the current Processing example",
    exampleText:
      "The SDK example configures a profile, creates and validates a draft, finalizes it and generates XML. It creates Processing records but sends nothing to a bank.",
    exampleLabel: "Open the Processing API example",
    sdkLabel: "TypeScript SDK guide",
    docsLabel: "Open the Bank Connectivity API documentation",
  },
  se: {
    eyebrow: "Processing API",
    heading: "Förbered och kontrollera bankens betalningsfiler",
    lead: "Processing API hjälper er programvara att skapa betalningsfiler för banken i ett kontrollerat flöde innan det riktiga bankavtalet och produktionscertifikaten är klara. Det kontrollerar betalningsuppgifterna, slutför en version och låter er applikation hämta exakt samma fil för lokal signering.",
    statusTitle: "Produktfas och åtkomst",
    statusText:
      "Processing API är i Beta. Betalningsfilsprofiler för Nordea Corporate Access är validerade av Nordea för Finland, Sverige, Norge och Danmark. OP:s och Danske Banks SEPA-betalningsfilsprofiler för Finland är tillgängliga; deras bankvalidering pågår. Sparbankens, Oma Sparbanks och Ålandsbankens SEPA-betalningsfilsprofiler för Finland samt POP Bankens och Aktias pain.001.001.03-profiler är tillgängliga; deras bankvalidering har inte börjat. Processing API är endast tillgängligt i produktion för prenumerationskunder med separat onboarding. Testtjänsten har avvecklats. Mottagarkontroll (VoP) ingår inte i den nuvarande produktionsversionen.",
    pricingTitle: "Prissättning (Beta)",
    pricingText:
      "Pris som Bank Connectivity: 18 €/mån grundavgift per integratör, 2 €/mån per slutkund (minst 10 kundlicenser), 200 € engångsavgift för produktionsonboarding. Onboardingavgiften tas inte ut av befintliga Bank Connectivity-kunder fram till 31 december 2026. Årsfakturering, moms tillkommer.",
    flowTitle: "Så förbereds en betalningsfil",
    flow: [
      "Välj betalningsfilens format för banken och landet inom användarens åtkomsträttigheter.",
      "Skapa en betalningsbatch och lägg till eller korrigera dess betalningar.",
      "Kontrollera betalningsuppgifterna och slutför versionen för XML-generering.",
      "Generera och hämta filen för den slutförda versionen. Det nuvarande tekniska utdataformatet är ISO 20022 pain.001.001.09, och TypeScript SDK:t kontrollerar att den hämtade filen inte har ändrats.",
    ],
    boundaryTitle: "Var Processing API:s ansvar slutar",
    boundaries: [
      "Processing API och Bank Connectivity använder separata inloggningssessioner.",
      "Bank Connectivity hanterar separat bankcertifikat samt listning, hämtning och uppladdning av bankfiler.",
      "Kundens privata signeringsnyckel stannar i den egna applikationen. Processing API tar aldrig emot nyckeln och skickar inte en betalning till banken.",
      "Att generera en fil godkänner inte en betalning. Uppladdning kräver de PGP-signaturer som File Exchange kontrollerar.",
    ],
    relationshipTitle: "Välj test eller produktion efter signeringen",
    processingLabel: "Processing API",
    processing: "Förbereder och genererar den kontrollerade betalningsfilen.",
    localLabel: "Kundens applikation",
    local: "Verifierar och signerar den hämtade filen under kundens kontroll.",
    exchangeLabel: "Välj destination",
    exchange:
      "Använd samma File Exchange API med Banksimulatorn nu och en separat kvalificerad riktig bankdestination senare.",
    testPathTitle: "Testflöde · Banksimulator",
    testPath:
      "Ladda upp den signerade syntetiska filen till banken simulator via en separat File Exchange-session och hämta sedan pain.002, camt.054 och den uppdaterade camt.053-filen.",
    testPathLimit:
      "Det historiska Processing–Banksimulator-exemplet kräver den avvecklade testtjänsten. Det nuvarande genereringsexemplet laddar inte upp filer. File Exchange-simulatorn är en separat tjänst.",
    testPathLink: "Öppna Banksimulatorn",
    productionPathTitle: "Produktionsflöde · Bank Connectivity",
    productionPath:
      "Ladda upp den signerade filen till en bank som stöds först när kunden har separat åtkomst till Bank Connectivity, bankavtal, produktionsuppgifter och en kvalificerad anslutning.",
    transport:
      "Simulatorresponsen är syntetisk; den bevisar inte en riktig banks godkännande, en genomförd betalning eller produktionskvalificering.",
    exampleTitle: "Kör det nuvarande Processing-exemplet",
    exampleText:
      "SDK-exemplet konfigurerar en profil, skapar och kontrollerar ett utkast, slutför det och genererar XML. Det skapar poster i Processing men skickar inget till banken.",
    exampleLabel: "Öppna Processing API-exemplet",
    sdkLabel: "Guide för TypeScript SDK",
    docsLabel: "Öppna dokumentationen för Bank Connectivity API",
  },
}[lang];
---

<CatalogPageLayout {lang} {record} bodyClass="processing-api-page" fullWidth>
  <PageHero
    slot="hero"
    eyebrow={copy.eyebrow}
    title={copy.heading}
    lead={copy.lead}
  >
    <Actions>
      <Button
        href={record.cta.href[lang]}
        data-analytics-content-type="product_access"
        data-analytics-item-id={record.id}
        data-analytics-source="product-status"
      >
        {record.cta.label[lang]}
      </Button>
    </Actions>
    <Card slot="aside" tone="accent">
      <CatalogAccessSummary
        slot="header"
        {lang}
        stage={record.stage}
        access={record.access}
      />
      <h2 class="status-title">{copy.statusTitle}</h2>
      <p>{copy.statusText}</p>
      <h2 class="status-title">{copy.pricingTitle}</h2>
      <p>{copy.pricingText}</p>
    </Card>
  </PageHero>

  <Section>
    <Split sticky>
      <SectionHeading slot="side" title={copy.flowTitle} />
      <Steps steps={copy.flow} direction="column" />
    </Split>
  </Section>

  <Section tone="band">
    <SectionHeading title={copy.relationshipTitle} />
    <Steps
      steps={[
        { title: copy.processingLabel, text: copy.processing },
        { title: copy.localLabel, text: copy.local },
        { title: copy.exchangeLabel, text: copy.exchange },
      ]}
    />
    <div class="destinations">
      <CardGrid columns={2}>
        <Card
          title={copy.testPathTitle}
          icon="flask"
          href={simulatorRecord.routes[lang]}
          linkLabel={copy.testPathLink}
          data-analytics-content-type="product"
          data-analytics-item-id={simulatorRecord.id}
          data-analytics-source="processing-api-test-path"
        >
          <p>{copy.testPath}</p>
          <p class="limit">{copy.testPathLimit}</p>
        </Card>
        <Card title={copy.productionPathTitle} icon="bank">
          <p>{copy.productionPath}</p>
        </Card>
      </CardGrid>
      <Callout tone="note">{copy.transport}</Callout>
    </div>
  </Section>

  <Section>
    <Split sticky>
      <SectionHeading slot="side" title={copy.boundaryTitle} />
      <CheckList items={copy.boundaries} icon="shield" />
    </Split>
  </Section>

  <Section tone="band">
    <CardGrid columns={2}>
      <ProductApiLinks {lang} kind="processing" />
      <Card
        title={copy.exampleTitle}
        icon="file"
        headingLevel={2}
        tone="accent"
      >
        <p>{copy.exampleText}</p>
        <Actions>
          <Button
            href={exampleUrl}
            external
            data-analytics-content-type="developer_resource"
            data-analytics-item-id="processing-api-sdk-example"
            data-analytics-source="processing-api-example"
          >
            {copy.exampleLabel}
          </Button>
          <Button href={sdkGuideUrl} external variant="secondary">
            {copy.sdkLabel}
          </Button>
          <Button
            variant="secondary"
            href="/wsapi_v2/"
            data-analytics-content-type="developer_resource"
            data-analytics-item-id="file-exchange-api-reference"
            data-analytics-source="processing-api-example"
          >
            {copy.docsLabel}
          </Button>
        </Actions>
      </Card>
    </CardGrid>
  </Section>
</CatalogPageLayout>

<style>
  .status-title {
    color: var(--landing-ink);
    font-size: 1.15rem;
    margin: 6px 0 0;
  }

  .destinations {
    display: grid;
    gap: 20px;
    margin-top: 48px;
  }

  .limit {
    font-size: 0.92rem;
    opacity: 0.85;
  }
</style>
