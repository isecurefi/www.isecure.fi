---
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import type { Lang } from "../types";
import CatalogAccessSummary from "./CatalogAccessSummary.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const record = getCatalogRecord("processing-api");
const exampleUrl =
  "https://github.com/isecurefi/isecure-ts-client/blob/main/examples/processing-manual-upload/README.md";
const copy = {
  fi: {
    eyebrow: "Processing API",
    heading: "Valmistele pankin maksuaineistot hallitusti",
    lead: "Processing API auttaa ohjelmistoasi muodostamaan pankille lähetettävän maksuaineiston hallitulla työnkululla. Se tarkistaa maksutiedot, lukitsee hyväksytyn version ja antaa sovelluksesi ladata täsmälleen saman tiedoston allekirjoitusta ja pankkiin lähettämistä varten.",
    statusTitle: "Tuotevaihe ja käyttöoikeus",
    statusText:
      "Processing API on saatavilla ISECuren testiympäristössä tilausasiakkaille pyynnöstä. Tuote on Experimental-vaiheessa, ja pankki- ja maakohtaisten maksuaineistojen pätevöinti jatkuu. Tuotantokäyttöä, pankkitukea tai palvelutasoa ei vielä luvata.",
    flowTitle: "Näin maksuaineisto valmistuu",
    flow: [
      "Valitse pankille ja maalle sopiva maksuaineiston muoto käyttäjän käyttöoikeuksien rajoissa.",
      "Luo maksuerä ja lisää tai korjaa siihen kuuluvat maksut.",
      "Tarkista pakolliset tiedot ja lukitse yksi muuttumaton versio henkilön hyväksyttäväksi.",
      "Lataa hyväksynnän jälkeen täsmälleen sama tiedosto. Nykyinen tekninen tulostusmuoto on ISO 20022 pain.001.001.09, ja TypeScript SDK tarkistaa, ettei ladattu tiedosto ole muuttunut.",
    ],
    boundaryTitle: "Mihin Processing API:n vastuu päättyy",
    boundaries: [
      "Processing API ja Bank Connectivity käyttävät erillisiä kirjautumisistuntoja.",
      "Bank Connectivity hoitaa erikseen pankkivarmenteet sekä pankkitiedostojen listauksen, latauksen ja lähetyksen.",
      "Asiakkaan yksityinen allekirjoitusavain säilyy omassa sovelluksessa. Processing API ei vastaanota avainta eikä lähetä maksua pankkiin.",
      "ISECuren työnkulussa annettu hyväksyntä koskee valmisteltua tiedostoa. Se ei ole pankin hyväksyntä eikä todiste toteutuneesta maksusta.",
    ],
    relationshipTitle:
      "Miten Processing API ja Bank Connectivity toimivat yhdessä",
    processingLabel: "Processing API",
    processing: "Luo ja vapauttaa tarkistetun maksuaineiston.",
    localLabel: "Asiakkaan sovellus",
    local:
      "Tarkistaa ja allekirjoittaa ladatun tiedoston asiakkaan hallinnassa.",
    exchangeLabel: "Bank Connectivity",
    exchange:
      "Siirtää allekirjoitetun tiedoston pankkiin erillisen käyttöoikeuden ja pankkisopimuksen rajoissa.",
    transport:
      "Pankkiin lähettäminen edellyttää erillistä Bank Connectivity -käyttöoikeutta, asiakkaan pankkisopimusta ja tuettua pankkiyhteyttä.",
    exampleTitle: "Aja valmis TypeScript-esimerkki",
    exampleText:
      "Esimerkki valmistelee ja lataa tarkistetun maksuaineiston, allekirjoittaa sen asiakkaan sovelluksessa ja lähettää sen pankkiin vasta erillisen vahvistuksen jälkeen.",
    exampleLabel: "Avaa Processing API -esimerkki",
    docsLabel: "Avaa Bank Connectivity -rajapinnan dokumentaatio",
  },
  en: {
    eyebrow: "Processing API",
    heading: "Prepare bank payment files with control and approval",
    lead: "Processing API helps your software prepare bank payment files through a controlled workflow. It checks the payment details, locks the approved version, and lets your application download the exact same file for signing and delivery to the bank.",
    statusTitle: "Product stage and access",
    statusText:
      "Processing API is available in the ISECure test environment to subscribed customers by request. The product is Experimental, and qualification of bank- and country-specific payment files is still in progress. Production use, bank support, and service levels are not yet promised.",
    flowTitle: "How a payment file is prepared",
    flow: [
      "Choose the payment-file format for the bank and country within the user's access rights.",
      "Create a payment batch and add or correct its payments.",
      "Check the required details and lock one unchanged version for a person to approve.",
      "After approval, download the exact same file. The current technical output is ISO 20022 pain.001.001.09, and the TypeScript SDK verifies that the downloaded file has not changed.",
    ],
    boundaryTitle: "Where Processing API's responsibility ends",
    boundaries: [
      "Processing API and Bank Connectivity use separate sign-in sessions.",
      "Bank Connectivity separately handles bank certificates and bank-file listing, download, and upload.",
      "The customer's private signing key stays in their own application. Processing API never receives the key and does not submit a payment to a bank.",
      "Approval in the ISECure workflow applies to the prepared file. It is not bank authorization or proof of a completed payment.",
    ],
    relationshipTitle: "How Processing API works with Bank Connectivity",
    processingLabel: "Processing API",
    processing: "Creates and releases the checked payment file.",
    localLabel: "Customer application",
    local:
      "Verifies and signs the downloaded file under the customer's control.",
    exchangeLabel: "Bank Connectivity",
    exchange:
      "Sends the signed file to the bank under separate access rights and the customer's bank agreement.",
    transport:
      "Sending to a bank requires separate Bank Connectivity access, the customer's bank agreement, and a supported bank connection.",
    exampleTitle: "Run the complete TypeScript example",
    exampleText:
      "The example prepares and downloads a checked payment file, signs it in the customer's application, and sends it to the bank only after separate confirmation.",
    exampleLabel: "Open the Processing API example",
    docsLabel: "Open the Bank Connectivity API documentation",
  },
  se: {
    eyebrow: "Processing API",
    heading: "Förbered bankens betalningsfiler med kontroll och godkännande",
    lead: "Processing API hjälper er programvara att skapa betalningsfiler för banken i ett kontrollerat flöde. Det kontrollerar betalningsuppgifterna, låser den godkända versionen och låter er applikation hämta exakt samma fil för signering och överföring till banken.",
    statusTitle: "Produktfas och åtkomst",
    statusText:
      "Processing API är tillgängligt i ISECures testmiljö för prenumerationskunder på begäran. Produkten är i Experimental-fasen och kvalificeringen av bank- och landsspecifika betalningsfiler pågår. Detta är ännu inget löfte om produktion, bankstöd eller servicenivå.",
    flowTitle: "Så förbereds en betalningsfil",
    flow: [
      "Välj betalningsfilens format för banken och landet inom användarens åtkomsträttigheter.",
      "Skapa en betalningsbatch och lägg till eller korrigera dess betalningar.",
      "Kontrollera de obligatoriska uppgifterna och lås en oförändrad version som en person kan godkänna.",
      "Hämta exakt samma fil efter godkännandet. Det nuvarande tekniska utdataformatet är ISO 20022 pain.001.001.09, och TypeScript SDK:t kontrollerar att den hämtade filen inte har ändrats.",
    ],
    boundaryTitle: "Var Processing API:s ansvar slutar",
    boundaries: [
      "Processing API och Bank Connectivity använder separata inloggningssessioner.",
      "Bank Connectivity hanterar separat bankcertifikat samt listning, hämtning och uppladdning av bankfiler.",
      "Kundens privata signeringsnyckel stannar i den egna applikationen. Processing API tar aldrig emot nyckeln och skickar inte en betalning till banken.",
      "Godkännandet i ISECures flöde gäller den förberedda filen. Det är inte bankens auktorisering eller bevis på en genomförd betalning.",
    ],
    relationshipTitle: "Så samverkar Processing API med Bank Connectivity",
    processingLabel: "Processing API",
    processing: "Skapar och frigör den kontrollerade betalningsfilen.",
    localLabel: "Kundens applikation",
    local: "Verifierar och signerar den hämtade filen under kundens kontroll.",
    exchangeLabel: "Bank Connectivity",
    exchange:
      "Skickar den signerade filen till banken med separat åtkomst och inom kundens bankavtal.",
    transport:
      "Överföring till banken kräver separat åtkomst till Bank Connectivity, kundens bankavtal och en bankanslutning som stöds.",
    exampleTitle: "Kör det fullständiga TypeScript-exemplet",
    exampleText:
      "Exemplet förbereder och hämtar en kontrollerad betalningsfil, signerar den i kundens applikation och skickar den till banken först efter en separat bekräftelse.",
    exampleLabel: "Öppna Processing API-exemplet",
    docsLabel: "Öppna dokumentationen för Bank Connectivity API",
  },
}[lang];
---

<CatalogPageLayout {lang} {record} bodyClass="processing-api-page">
  <article class="processing-api container">
    <header>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lead">{copy.lead}</p>
    </header>

    <section class="status" aria-labelledby="processing-status">
      <div>
        <CatalogAccessSummary
          {lang}
          stage={record.stage}
          access={record.access}
        />
        <h2 id="processing-status">{copy.statusTitle}</h2>
      </div>
      <div class="status-copy">
        <p>{copy.statusText}</p>
        <a
          href={record.cta.href[lang]}
          data-analytics-content-type="product_access"
          data-analytics-item-id={record.id}
          data-analytics-source="product-status"
        >
          {record.cta.label[lang]}
        </a>
      </div>
    </section>

    <section>
      <h2>{copy.flowTitle}</h2>
      <ol class="flow">
        {copy.flow.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section>
      <h2>{copy.boundaryTitle}</h2>
      <ul class="boundaries">
        {copy.boundaries.map((boundary) => <li>{boundary}</li>)}
      </ul>
    </section>

    <section>
      <h2>{copy.relationshipTitle}</h2>
      <div class="relationship" role="list">
        <p role="listitem">
          <strong>{copy.processingLabel}</strong><span>{copy.processing}</span>
        </p>
        <span aria-hidden="true">→</span>
        <p role="listitem">
          <strong>{copy.localLabel}</strong><span>{copy.local}</span>
        </p>
        <span aria-hidden="true">→</span>
        <p role="listitem">
          <strong>{copy.exchangeLabel}</strong><span>{copy.exchange}</span>
        </p>
      </div>
      <p class="transport-note">{copy.transport}</p>
    </section>

    <aside class="example">
      <h2>{copy.exampleTitle}</h2>
      <p>{copy.exampleText}</p>
      <div>
        <a
          href={exampleUrl}
          target="_blank"
          rel="noopener"
          data-analytics-content-type="developer_resource"
          data-analytics-item-id="processing-api-sdk-example"
          data-analytics-source="processing-api-example">{copy.exampleLabel}</a
        >
        <a
          href="/wsapi_v2/"
          data-analytics-content-type="developer_resource"
          data-analytics-item-id="file-exchange-api-reference"
          data-analytics-source="processing-api-example">{copy.docsLabel}</a
        >
      </div>
    </aside>
  </article>
</CatalogPageLayout>

<style>
  .processing-api {
    margin: 3rem auto;
    max-width: 1000px;
  }

  header,
  .processing-api > section,
  .example {
    margin-inline: auto;
    max-width: 900px;
  }

  header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .eyebrow {
    color: #087f72;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .lead,
  section p,
  section li,
  .example p {
    line-height: 1.7;
  }

  .lead {
    font-size: 1.12rem;
  }

  .processing-api > section,
  .example {
    margin-top: 2.5rem;
  }

  .status {
    background: #eef5ff;
    border: 1px solid #bfd1e8;
    border-radius: 12px;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(180px, 0.55fr) minmax(0, 1.45fr);
    padding: 1.4rem;
  }

  .status h2 {
    font-size: 1.35rem;
    margin: 0.6rem 0 0;
  }

  .status p {
    margin: 0;
  }

  .status-copy a {
    background: #087f72;
    border-radius: 8px;
    color: #fff;
    display: inline-flex;
    font-weight: 700;
    margin-top: 0.9rem;
    padding: 0.65rem 0.9rem;
    text-decoration: none;
  }

  .status-copy a:focus-visible {
    outline: 3px solid #17252b;
    outline-offset: 3px;
  }

  .flow,
  .boundaries {
    padding-left: 1.4rem;
  }

  .flow li + li,
  .boundaries li + li {
    margin-top: 0.65rem;
  }

  .relationship {
    align-items: stretch;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(
        0,
        1.2fr
      );
  }

  .relationship p {
    border: 1px solid #d6e0e2;
    border-radius: 10px;
    margin: 0;
    padding: 1rem;
  }

  .relationship strong {
    display: block;
    margin-bottom: 0.4rem;
  }

  .relationship > span {
    align-self: center;
    font-weight: 800;
  }

  .transport-note {
    border-left: 4px solid #087f72;
    margin-top: 1rem;
    padding-left: 1rem;
  }

  .example {
    background: #eef8f6;
    border: 1px solid #b9ddd6;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .example div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .example a {
    border: 1px solid #087f72;
    border-radius: 8px;
    color: #087f72;
    display: inline-block;
    font-weight: 700;
    padding: 0.7rem 1rem;
    text-decoration: none;
  }

  .example a:first-child {
    background: #087f72;
    color: #fff;
  }

  .example a:focus-visible {
    outline: 3px solid #17252b;
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .status,
    .relationship {
      grid-template-columns: 1fr;
    }

    .relationship > span {
      justify-self: center;
      transform: rotate(90deg);
    }
  }

  @media (max-width: 576px) {
    .processing-api {
      margin-block: 2rem;
    }

    .example a {
      text-align: center;
      width: 100%;
    }
  }
</style>
