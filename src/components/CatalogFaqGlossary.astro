---
import { catalogUi, type CatalogRecord } from "../data/productRegistry";
import type { Lang } from "../types";
import FaqList from "./ui/FaqList.astro";

interface Props {
  lang: Lang;
  record: CatalogRecord;
}

const { lang, record } = Astro.props;
const ui = catalogUi[lang];
const faq = record.faq.map((item) => ({
  q: item.question[lang],
  a: item.answer[lang],
}));
---

{
  (record.faq.length > 0 || record.glossary.length > 0) && (
    <section class="catalog-help">
      {record.faq.length > 0 && (
        <div>
          <h2>{ui.faq}</h2>
          <div class="catalog-faq-list">
            <FaqList items={faq} />
          </div>
        </div>
      )}
      {record.glossary.length > 0 && (
        <aside>
          <h2>{ui.glossary}</h2>
          <dl>
            {record.glossary.map((item) => (
              <div>
                <dt>{item.term[lang]}</dt>
                <dd>{item.definition[lang]}</dd>
              </div>
            ))}
          </dl>
        </aside>
      )}
    </section>
  )
}

<style>
  .catalog-help {
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
    margin: 2.5rem 0;
  }

  .catalog-help:first-child {
    margin-top: 0;
  }

  .catalog-help:last-child {
    margin-bottom: 0;
  }

  .catalog-help h2 {
    color: var(--landing-ink);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .catalog-help aside {
    align-self: start;
    background: var(--landing-card);
    border: 1px solid var(--landing-line);
    border-radius: 14px;
    color: var(--landing-ink);
    padding: 26px;
  }

  .catalog-help aside h2 {
    font-size: 1.2rem;
  }

  .catalog-help dl,
  .catalog-help dd {
    margin: 0;
  }

  .catalog-help dl div + div {
    border-top: 1px solid var(--landing-line);
    margin-top: 0.85rem;
    padding-top: 0.85rem;
  }

  .catalog-help dt {
    font-weight: 750;
  }

  .catalog-help dd {
    color: var(--landing-muted);
    line-height: 1.55;
    margin-top: 0.2rem;
  }

  @media (max-width: 720px) {
    .catalog-help {
      gap: 32px;
      grid-template-columns: 1fr;
    }
  }
</style>
