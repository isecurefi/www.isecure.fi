---
import type { Lang } from '../types';
import { getLocalizedPathname } from '../utils/languages';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;

const languages: Record<Lang, string> = {
  fi: 'FI',
  en: 'EN',
  se: 'SE'
};
---

<div class="language-switcher">
  {Object.entries(languages).map(([lang, label]) => (
    <a
      href={getLocalizedPathname(Astro.url.pathname, lang as Lang)}
      class={`lang-link ${currentLang === lang ? 'active' : ''}`}
      aria-label={`Switch to ${label}`}
      onclick={`
        localStorage.setItem('preferred-lang', '${lang}');
        window.location.href = '${getLocalizedPathname(Astro.url.pathname, lang as Lang)}';
        return false;
      `}
    >
      {label}
    </a>
  ))}
</div>

<script>
  // Set initial active state based on current URL path
  const currentPath = window.location.pathname;
  const pathParts = currentPath.split('/').filter(Boolean);
  
  // Default to 'fi' for root path or paths without language code
  let currentLang = 'fi';
  
  // Only update currentLang if a valid language code is found
  if (pathParts[0] && ['en', 'se'].includes(pathParts[0])) {
    currentLang = pathParts[0];
  }
  
  const links = document.querySelectorAll('.lang-link');
  links.forEach(link => {
    const href = link.getAttribute('href');
    const linkLang = href === '/' ? 'fi' : href.split('/')[1] || 'fi';
    
    // Clear any existing active states first
    link.classList.remove('active');
    
    // Only add active class if languages match exactly
    if (currentLang === linkLang) {
      link.classList.add('active');
    }
  });
</script>

<style>
  .language-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: 1rem;
  }

  .lang-link {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }

  .lang-link:hover {
    background-color: var(--background-light);
  }

  .lang-link.active {
    background-color: var(--primary-color);
    color: white;
  }
</style>
