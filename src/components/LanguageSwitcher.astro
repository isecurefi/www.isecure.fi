---
import type { Lang } from '../types';
import { getLocalizedPathname } from '../utils/languages';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;

const languages: Record<Lang, string> = {
  fi: 'FI',
  en: 'EN',
  se: 'SE'
};
---

<div class="language-switcher">
  {Object.entries(languages).map(([lang, label]) => (
    <a
      href={getLocalizedPathname(Astro.url.pathname.replace('/index.html', '/'), lang as Lang)}
      class={`lang-link ${currentLang === lang ? 'active' : ''}`}
      data-lang={lang}
      aria-label={`Switch to ${label}`}
      onclick={`
        localStorage.setItem('preferred-lang', '${lang}');
        window.location.href = '${getLocalizedPathname(Astro.url.pathname.replace('/index.html', '/'), lang as Lang)}';
        return false;
      `}
    >
      {label}
    </a>
  ))}
</div>

<script>
  function detectCurrentLanguage() {
    const path = window.location.pathname;
    
    // Special cases for Finnish
    if (path === "/" || 
        path === "/index.html" || 
        path === "/ws-channel" || 
        path === "/ws-api" ||
        path.startsWith("/ws-channel/") || 
        path.startsWith("/ws-api/")) {
      return "fi";
    }
    
    // Check for explicit language prefixes
    if (path.startsWith("/en") || path === "/en") return "en";
    if (path.startsWith("/se") || path === "/se") return "se";
    
    // Default to Finnish for any other path
    return "fi";
  }

  function updateLanguageHighlight() {
    const currentLang = detectCurrentLanguage();
    
    // Remove all active classes first
    document.querySelectorAll('.lang-link').forEach(link => {
      link.classList.remove('active');
    });
    
    // Find and highlight the correct language link
    const linkToActivate = document.querySelector(`.lang-link[data-lang="${currentLang}"]`);
    if (linkToActivate) {
      linkToActivate.classList.add('active');
    }
  }

  // Update on initial load
  updateLanguageHighlight();

  // Update on Astro page transitions
  document.addEventListener('astro:page-load', updateLanguageHighlight);
</script>

<style>
  .language-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: 1rem;
  }

  .lang-link {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }

  .lang-link:hover {
    background-color: var(--background-light);
  }

  .lang-link.active {
    background-color: var(--primary-color);
    color: white;
  }
</style>
