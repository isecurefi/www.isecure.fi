---
import type { Lang } from '../types';
import { getLocalizedPathname } from '../utils/languages';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;

const languages: Record<Lang, string> = {
  fi: 'FI',
  en: 'EN',
  se: 'SE'
};
---

<div class="language-switcher">
  {Object.entries(languages).map(([lang, label]) => (
    <a
      href={getLocalizedPathname(Astro.url.pathname, lang as Lang)}
      class={`lang-link ${currentLang === lang ? 'active' : ''}`}
      aria-label={`Switch to ${label}`}
      onclick={`
        localStorage.setItem('preferred-lang', '${lang}');
        window.location.href = '${getLocalizedPathname(Astro.url.pathname, lang as Lang)}';
        return false;
      `}
    >
      {label}
    </a>
  ))}
</div>

<script>
  function updateActiveState() {
    const currentPath = window.location.pathname;
    
    // Default to 'fi' for all paths except those explicitly starting with /en/ or /se/
    let currentLang = 'fi';
    
    // Only change from Finnish if path explicitly starts with /en/ or /se/
    if (currentPath.startsWith('/en/') || currentPath === '/en') {
      currentLang = 'en';
    } else if (currentPath.startsWith('/se/') || currentPath === '/se') {
      currentLang = 'se';
    }
    
    const links = document.querySelectorAll('.lang-link');
    links.forEach(link => {
      const href = link.getAttribute('href');
      const linkLang = href === '/' ? 'fi' : href.split('/')[1] || 'fi';
      
      // Set active class based on current language
      if (currentLang === linkLang) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  }

  // Run once when the script loads
  updateActiveState();

  // Also update when the page content changes (for client-side navigation)
  document.addEventListener('astro:page-load', updateActiveState);
</script>

<style>
  .language-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: 1rem;
  }

  .lang-link {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }

  .lang-link:hover {
    background-color: var(--background-light);
  }

  .lang-link.active {
    background-color: var(--primary-color);
    color: white;
  }
</style>
