---
import type { Lang } from '../types';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;

const languages: Record<Lang, string> = {
  fi: 'FI',
  en: 'EN',
  se: 'SE'
};
---

<div class="language-switcher">
  {Object.entries(languages).map(([lang, label]) => (
    <a
      href={`${Astro.url.pathname}?lang=${lang}`}
      class={`lang-link ${currentLang === lang ? 'active' : ''}`}
      aria-label={`Switch to ${label}`}
      onclick={`
        localStorage.setItem('preferred-lang', '${lang}');
        document.querySelectorAll('.lang-link').forEach(link => {
          link.classList.remove('active');
        });
        this.classList.add('active');
      `}
    >
      {label}
    </a>
  ))}
</div>

<script>
  // Set initial active state based on stored language
  const storedLang = localStorage.getItem('preferred-lang') || 'fi';
  const links = document.querySelectorAll('.lang-link');
  links.forEach(link => {
    const langParam = new URL(link.getAttribute('href'), window.location.href)
      .searchParams.get('lang');
    if (langParam === storedLang) {
      link.classList.add('active');
    } else {
      link.classList.remove('active');
    }
  });
</script>

<style>
  .language-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: 1rem;
  }

  .lang-link {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }

  .lang-link:hover {
    background-color: var(--background-light);
  }

  .lang-link.active {
    background-color: var(--primary-color);
    color: white;
  }
</style>
