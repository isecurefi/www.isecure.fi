---
import {
  catalogUi,
  directionLabel,
  type CatalogRecord,
} from "../data/productRegistry";
import type { Lang } from "../types";

interface Props {
  lang: Lang;
  record: CatalogRecord;
}

const { lang, record } = Astro.props;
const ui = catalogUi[lang];
---

<section
  class="capability-section"
  aria-labelledby={`${record.id}-capabilities`}
>
  <h2 id={`${record.id}-capabilities`}>{ui.capabilities}</h2>
  <div class="capability-table-wrap">
    <table>
      <thead>
        <tr
          ><th scope="col">{ui.direction}</th><th scope="col"
            >{ui.capability}</th
          ></tr
        >
      </thead>
      <tbody>
        {
          record.capabilities.map((capability) => (
            <tr>
              <td>
                <span class:list={["direction", `is-${capability.direction}`]}>
                  {directionLabel(capability.direction, lang)}
                </span>
              </td>
              <td>
                <strong>{capability.label[lang]}</strong>
                <span>{capability.detail[lang]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .capability-section {
    margin: 2.5rem auto;
    max-width: 1000px;
  }

  .capability-section h2 {
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    margin-bottom: 1rem;
  }

  .capability-table-wrap {
    border: 1px solid #d6e0e2;
    border-radius: 12px;
    overflow-x: auto;
  }

  table {
    background: #fff;
    border-collapse: collapse;
    color: #17252b;
    min-width: 560px;
    width: 100%;
  }

  th,
  td {
    border-bottom: 1px solid #dfe7e8;
    padding: 0.9rem 1rem;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: #f4f7f8;
    color: #4f6167;
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  td:first-child {
    width: 170px;
  }

  td strong,
  td span:not(.direction) {
    display: block;
  }

  td span:not(.direction) {
    color: #53636a;
    line-height: 1.55;
    margin-top: 0.25rem;
  }

  .direction {
    background: #e9f4f2;
    border-radius: 999px;
    color: #075d54;
    display: inline-flex;
    font-size: 0.75rem;
    font-weight: 750;
    padding: 0.28rem 0.55rem;
  }
</style>
