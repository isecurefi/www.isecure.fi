---
import {
  catalogUi,
  directionLabel,
  type CatalogRecord,
} from "../data/productRegistry";
import type { Lang } from "../types";

interface Props {
  lang: Lang;
  record: CatalogRecord;
}

const { lang, record } = Astro.props;
const ui = catalogUi[lang];
---

<section
  class="capability-section"
  aria-labelledby={`${record.id}-capabilities`}
>
  <h2 id={`${record.id}-capabilities`}>{ui.capabilities}</h2>
  <div class="capability-table-wrap">
    <table>
      <thead>
        <tr
          ><th scope="col">{ui.direction}</th><th scope="col"
            >{ui.capability}</th
          ></tr
        >
      </thead>
      <tbody>
        {
          record.capabilities.map((capability) => (
            <tr>
              <td>
                <span class:list={["direction", `is-${capability.direction}`]}>
                  {directionLabel(capability.direction, lang)}
                </span>
              </td>
              <td>
                <strong>{capability.label[lang]}</strong>
                <span>{capability.detail[lang]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .capability-section {
    margin: 2.5rem 0;
  }

  .capability-section:first-child {
    margin-top: 0;
  }

  .capability-section:last-child {
    margin-bottom: 0;
  }

  .capability-section h2 {
    color: var(--landing-ink);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
    margin: 0 0 1.25rem;
  }

  .capability-table-wrap {
    background: var(--landing-card);
    border: 1px solid var(--landing-line);
    border-radius: 14px;
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    color: var(--landing-ink);
    min-width: 560px;
    width: 100%;
  }

  th,
  td {
    border-bottom: 1px solid var(--landing-line);
    padding: 0.95rem 1.1rem;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: var(--landing-soft);
    color: var(--landing-muted);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  td:first-child {
    width: 170px;
  }

  td strong,
  td span:not(.direction) {
    display: block;
  }

  td span:not(.direction) {
    color: var(--landing-muted);
    line-height: 1.55;
    margin-top: 0.25rem;
  }

  .direction {
    background: rgba(79, 209, 197, 0.16);
    border-radius: 999px;
    color: var(--landing-accent);
    display: inline-flex;
    font-size: 0.75rem;
    font-weight: 750;
    padding: 0.28rem 0.6rem;
  }
</style>
