---
import {
  catalogUi,
  getPublicProductRecords,
  type CatalogRecord,
} from "../data/productRegistry";
import type { Lang } from "../types";

interface Props {
  lang: Lang;
  current?: CatalogRecord;
}

const { lang, current } = Astro.props;
const ui = catalogUi[lang];
const indexHref = lang === "fi" ? "/products/" : `/${lang}/products/`;
const records = getPublicProductRecords();
---

<nav class="catalog-navigation" aria-label={ui.products}>
  <a
    href={indexHref}
    aria-current={!current ? "page" : undefined}
    data-analytics-content-type="product_navigation"
    data-analytics-item-id="product-index"
    data-analytics-source="catalog-navigation"
  >
    {ui.products}
  </a>
  {
    records.map((record) => (
      <a
        href={record.routes[lang]}
        aria-current={record.id === current?.id ? "page" : undefined}
        data-analytics-content-type="product_navigation"
        data-analytics-item-id={record.id}
        data-analytics-source="catalog-navigation"
      >
        {record.name[lang]}
      </a>
    ))
  }
</nav>

<style>
  /* Product switcher: pill tabs under the page hero. */
  .catalog-navigation {
    align-items: center;
    border-bottom: 1px solid var(--landing-line);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 auto;
    padding: 14px 0;
    width: min(1180px, calc(100% - 40px));
  }

  .catalog-navigation a {
    border-radius: 999px;
    color: var(--landing-muted);
    font-size: 0.9rem;
    font-weight: 650;
    padding: 6px 14px;
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .catalog-navigation a:hover {
    background: var(--landing-soft);
    color: var(--landing-ink);
  }

  .catalog-navigation a[aria-current="page"] {
    background: rgba(79, 209, 197, 0.16);
    color: var(--landing-accent);
  }

  .catalog-navigation a:focus-visible {
    outline: 2px solid var(--landing-accent);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .catalog-navigation {
      width: calc(100% - 28px);
    }
  }
</style>
