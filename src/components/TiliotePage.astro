---
import GuidePage from "./GuidePage.astro";
import type { Lang } from "../types";

const { lang } = Astro.props;

const content = {
  fi: {
    title: "camt.053 API: konekielinen tiliote ohjelmistoon | ISECure",
    description:
      "camt.053 API tuo konekielisen ISO 20022 -tiliotteen ohjelmistoon yhdestä rajapinnasta. Lue camt053-sisällöstä, versioista, noudosta ja täsmäytyksestä.",
    h1: "camt.053 API: konekielinen tiliote ohjelmistoon",
    intro:
      "Konekielinen tiliote tuo pankkitilin tapahtumat rakenteisessa muodossa suoraan taloushallinnon tai ERP-ohjelmistoon, jolloin täsmäytys ja kirjaukset voidaan automatisoida. Nykyään tiliote noudetaan camt.053-muodossa Web Services -kanavan kautta.",
    sections: [
      {
        h2: "Mikä camt.053 on",
        paras: [
          "camt.053 on ISO 20022 -standardin mukainen konekielinen tiliote, joka on korvannut vanhan kotimaisen TITO-muodon (konekielinen tiliote). Se sisältää tilin saldot ja yksittäiset tapahtumat rakenteisessa XML-muodossa, mukaan lukien viitetiedot saapuville maksuille.",
          "Rakenteinen muoto mahdollistaa automaattisen täsmäytyksen: ohjelmisto voi kohdistaa saapuvat viitemaksut myyntilaskuihin ilman manuaalista työtä.",
        ],
      },
      {
        h2: "camt.053, camt053 vai camt 053?",
        paras: [
          "Kirjoitusasut camt.053, camt053 ja camt 053 tarkoittavat samaa ISO 20022 Bank-to-Customer Statement -sanomaperhettä. Pankit ilmoittavat lisäksi skeemaversion, kuten camt.053.001.08. Ohjelmiston on tunnistettava pankin toimittama versio ja sen pankkikohtainen soveltamisohje.",
        ],
      },
      {
        h2: "Miten tiliote noudetaan",
        paras: [
          "Tiliote noudetaan pankin Web Services -kanavan kautta allekirjoitetulla sanomalla. Nouto vaatii voimassa olevat varmenteet ja Web Services -sopimuksen pankin kanssa. Saapuvat viitemaksut voidaan noutaa vastaavasti erillisenä aineistona.",
        ],
        list: [
          "camt.053 tiliote saldoineen ja tapahtumineen",
          "Saapuvien viitemaksujen kohdistustiedot",
          "Nouto Web Services -kanavan kautta, varmenteilla allekirjoitettuna",
          "Automaattinen täsmäytys myyntireskontraan",
        ],
      },
      {
        h2: "Tiliotteet ISECuren kautta",
        paras: [
          "ISECure noutaa camt.053-tiliotteet kaikilta tukemiltamme suomalaisilta pankeilta yhdellä REST-rajapinnalla. Hoidamme varmenteet ja allekirjoitukset, joten ohjelmistosi saa tiliotteet valmiina yhdestä paikasta — samalla integraatiolla kaikista pankeista.",
        ],
      },
    ],
  },
  en: {
    title: "camt.053 API for Machine-Readable Bank Statements | ISECure",
    description:
      "A camt.053 API delivers ISO 20022 bank statements to software through one integration. Learn about camt053 content, versions, retrieval, and reconciliation.",
    h1: "camt.053 API for machine-readable bank statements",
    intro:
      "A machine-readable statement brings a bank account's transactions in structured form straight into accounting or ERP software, so reconciliation and bookings can be automated. Today the statement is retrieved in camt.053 format over the Web Services channel.",
    sections: [
      {
        h2: "What camt.053 is",
        paras: [
          "camt.053 is the ISO 20022 machine-readable statement that has replaced the old domestic TITO format. It contains account balances and individual transactions in structured XML, including reference data for incoming payments.",
          "The structured format enables automatic reconciliation: software can match incoming reference payments to sales invoices with no manual work.",
        ],
      },
      {
        h2: "camt.053, camt053, or camt 053?",
        paras: [
          "The spellings camt.053, camt053, and camt 053 refer to the same ISO 20022 Bank-to-Customer Statement message family. Banks also identify a schema version, such as camt.053.001.08. Your software must recognize the version delivered by the bank and its bank-specific implementation guidelines.",
        ],
      },
      {
        h2: "How the statement is retrieved",
        paras: [
          "The statement is retrieved over the bank's Web Services channel with a signed message. Retrieval requires valid certificates and a Web Services agreement with the bank. Incoming reference payments can be retrieved similarly as a separate file.",
        ],
        list: [
          "camt.053 statement with balances and transactions",
          "Matching data for incoming reference payments",
          "Retrieval over the Web Services channel, signed with certificates",
          "Automatic reconciliation to accounts receivable",
        ],
      },
      {
        h2: "Statements through ISECure",
        paras: [
          "ISECure retrieves camt.053 statements from all the Finnish banks we support through one REST API. We handle the certificates and signing, so your software gets statements ready from one place — from every bank with the same integration.",
        ],
      },
    ],
  },
  se: {
    title: "camt.053-API för maskinläsbara kontoutdrag | ISECure",
    description:
      "Ett camt.053-API levererar ISO 20022-kontoutdrag till programvara via en integration. Läs om camt053-innehåll, versioner, hämtning och avstämning.",
    h1: "camt.053-API för maskinläsbara kontoutdrag",
    intro:
      "Ett maskinläsbart kontoutdrag för in ett bankkontos transaktioner i strukturerad form direkt i ekonomi- eller ERP-programvara, så att avstämning och bokföring kan automatiseras. I dag hämtas kontoutdraget i camt.053-format via Web Services-kanalen.",
    sections: [
      {
        h2: "Vad camt.053 är",
        paras: [
          "camt.053 är det maskinläsbara kontoutdraget enligt ISO 20022 som har ersatt det gamla inhemska TITO-formatet. Det innehåller kontosaldon och enskilda transaktioner i strukturerad XML, inklusive referensuppgifter för inkommande betalningar.",
          "Det strukturerade formatet möjliggör automatisk avstämning: programvaran kan matcha inkommande referensbetalningar mot försäljningsfakturor utan manuellt arbete.",
        ],
      },
      {
        h2: "camt.053, camt053 eller camt 053?",
        paras: [
          "Skrivsätten camt.053, camt053 och camt 053 avser samma ISO 20022 Bank-to-Customer Statement-meddelandefamilj. Banker anger också en schemaversion, till exempel camt.053.001.08. Programvaran måste känna igen bankens version och bankspecifika tillämpningsanvisningar.",
        ],
      },
      {
        h2: "Hur kontoutdraget hämtas",
        paras: [
          "Kontoutdraget hämtas via bankens Web Services-kanal med ett signerat meddelande. Hämtningen kräver giltiga certifikat och ett Web Services-avtal med banken. Inkommande referensbetalningar kan hämtas på motsvarande sätt som en separat fil.",
        ],
        list: [
          "camt.053-kontoutdrag med saldon och transaktioner",
          "Matchningsuppgifter för inkommande referensbetalningar",
          "Hämtning via Web Services-kanalen, signerad med certifikat",
          "Automatisk avstämning mot kundreskontra",
        ],
      },
      {
        h2: "Kontoutdrag via ISECure",
        paras: [
          "ISECure hämtar camt.053-kontoutdrag från alla finländska banker vi stöder via ett REST-API. Vi sköter certifikaten och signeringen, så din programvara får kontoutdragen färdiga från ett ställe — från alla banker med samma integration.",
        ],
      },
    ],
  },
} satisfies Record<Lang, unknown>;

const related = [
  {
    slug: "data-api",
    fi: "ISO 20022 -pankkidata API",
    en: "ISO 20022 Banking Data API",
    se: "ISO 20022-bankdata-API",
  },
  {
    slug: "camt-054",
    fi: "camt.054-tapahtumailmoitukset",
    en: "camt.054 debit and credit notifications",
    se: "camt.054 debet- och kreditaviseringar",
  },
  {
    slug: "web-services",
    fi: "Web Services -kanava",
    en: "Web Services channel",
    se: "Web Services-kanalen",
  },
  {
    slug: "pankkiyhteys",
    fi: "Pankkiyhteys: rakenna itse vai osta",
    en: "Bank connectivity: build vs buy",
    se: "Bankförbindelse: bygga eller köpa",
  },
  {
    slug: "nordea",
    fi: "Nordea-pankkiyhteys",
    en: "Nordea bank connectivity",
    se: "Nordea-bankförbindelse",
  },
];
---

<GuidePage lang={lang} slug="tiliote" content={content} related={related} />
