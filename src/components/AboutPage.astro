---
import Layout from "../layouts/Layout.astro";
import { alternateLinks, localizedRoutes } from "../lib/seo";
import type { Lang } from "../types";
import Actions from "./ui/Actions.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import CheckList from "./ui/CheckList.astro";
import PageHero from "./ui/PageHero.astro";
import Prose from "./ui/Prose.astro";
import Section from "./ui/Section.astro";
import SectionHeading from "./ui/SectionHeading.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = {
  fi: {
    title: "Tietoa meistä",
    description:
      "ISECure Oy on helsinkiläinen ohjelmistoyritys. Pankkiyhteyspalvelu on ollut tuotannossa yli 10 vuotta, ja sitä käyttää yli 600 yritystä sekä integraattorit.",
    intro:
      "ISECure Oy on helsinkiläinen ohjelmistoyritys, joka tarjoaa pankkiyhteydet yhtenä rajapintana ohjelmistoyrityksille. Palvelumme on ollut tuotannossa yli 10 vuotta, ja sitä käyttää yli 600 yritystä suoraan. Lisäksi integraattorit palvelevat sen kautta omia asiakasyrityksiään.",
    facts: [
      "Yli 10 vuotta tuotannossa: WS-kanavan pankkiyhteydet, varmenteet ja aineistoliikenne",
      "Yli 600 yritystä käyttää palvelua suoraan, ja integraattorit palvelevat sen kautta omia asiakkaitaan",
      "Palvelu toimii AWS:ssä PCI DSS -sertifioiduilla komponenteilla",
      "Avoimet SDK:t ja OpenAPI-kuvaus — kehitys näkyy GitHubissa",
    ],
    founderTitle: "Perustaja",
    founderText:
      "ISECuren perustaja Dan Forsberg (tekniikan tohtori, D.Sc.) on rakentanut pankkiyhteys- ja tietoturvaratkaisuja yli vuosikymmenen. Dan vastaa henkilökohtaisesti asiakkaiden käyttöönotoista — saat saman asiantuntijan, joka on rakentanut palvelun.",
    certsTitle: "AWS-sertifioitu asiantuntijuus",
    githubCta: "ISECure GitHubissa",
  },
  en: {
    title: "About us",
    description:
      "ISECure Oy is a Helsinki software company. Its bank connectivity service has run in production for over 10 years and is used by over 600 companies and integrators.",
    intro:
      "ISECure Oy is a Helsinki-based software company providing bank connectivity as a single API for software companies. Our service has been in production for over 10 years and is used directly by over 600 companies. Integrators also serve their own customer companies through it.",
    facts: [
      "10+ years in production: WS-channel bank connectivity, certificates, and file traffic",
      "Over 600 companies use the service directly, and integrators serve their own customers through it",
      "Runs on AWS with PCI DSS certified components",
      "Open SDKs and an OpenAPI description — development is visible on GitHub",
    ],
    founderTitle: "Founder",
    founderText:
      "ISECure's founder Dan Forsberg (D.Sc. in technology) has built bank connectivity and security solutions for over a decade. Dan personally handles customer onboarding — you work with the same expert who built the service.",
    certsTitle: "AWS-certified expertise",
    githubCta: "ISECure on GitHub",
  },
  se: {
    title: "Om oss",
    description:
      "ISECure Oy är ett mjukvaruföretag i Helsingfors. Bankförbindelsetjänsten har varit i produktion i över 10 år och används av över 600 företag och integratörer.",
    intro:
      "ISECure Oy är ett Helsingforsbaserat mjukvaruföretag som erbjuder bankförbindelser som ett enda API för mjukvarubolag. Vår tjänst har varit i produktion i över 10 år och används direkt av över 600 företag. Integratörer betjänar dessutom sina egna kundföretag via den.",
    facts: [
      "Över 10 år i produktion: WS-kanalens bankförbindelser, certifikat och filtrafik",
      "Över 600 företag använder tjänsten direkt, och integratörer betjänar sina egna kunder via den",
      "Körs på AWS med PCI DSS-certifierade komponenter",
      "Öppna SDK:er och OpenAPI-beskrivning — utvecklingen syns på GitHub",
    ],
    founderTitle: "Grundare",
    founderText:
      "ISECures grundare Dan Forsberg (teknologie doktor, D.Sc.) har byggt bankförbindelse- och säkerhetslösningar i över ett decennium. Dan sköter personligen kundernas onboarding — du arbetar med samma expert som byggt tjänsten.",
    certsTitle: "AWS-certifierad expertis",
    githubCta: "ISECure på GitHub",
  },
};

const t = content[lang];
const awsCerts = ["SAP", "DOP", "SS", "BD", "NS", "DA", "SAA", "SOA", "CP"];
---

<Layout
  title={t.title}
  lang={lang}
  description={t.description}
  alternateLinks={alternateLinks(localizedRoutes("about"))}
  fullWidth
>
  <PageHero title={t.title} lead={t.intro}>
    <Card slot="aside" tone="accent">
      <CheckList items={t.facts} />
    </Card>
  </PageHero>

  <Section tone="band" width="narrow">
    <div class="about-founder">
      <img
        src="/images/dforsber.png"
        class="about-portrait"
        alt="Dan Forsberg"
        loading="lazy"
      />
      <div>
        <SectionHeading title={t.founderTitle} />
        <Prose>
          <p><strong>Dan Forsberg, D.Sc.</strong></p>
          <p>{t.founderText}</p>
        </Prose>
      </div>
    </div>
  </Section>

  <Section width="narrow">
    <SectionHeading title={t.certsTitle} />
    <div class="about-certs">
      {
        awsCerts.map((cert) => (
          <img
            src={`/images/AWS_${cert}.png`}
            alt={`AWS ${cert} certification`}
            loading="lazy"
          />
        ))
      }
    </div>
    <Actions>
      <Button href="https://github.com/isecurefi" variant="secondary"
        >{t.githubCta}</Button
      >
    </Actions>
  </Section>
</Layout>

<style>
  .about-founder {
    align-items: center;
    display: grid;
    gap: 48px;
    grid-template-columns: 220px minmax(0, 1fr);
  }

  .about-founder :global(.ui-heading) {
    margin-bottom: 20px;
  }

  .about-portrait {
    border: 1px solid var(--landing-line);
    border-radius: 14px;
    display: block;
    height: auto;
    width: 100%;
  }

  .about-certs {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .about-certs img {
    height: auto;
    max-height: 72px;
    width: auto;
  }

  @media (max-width: 640px) {
    .about-founder {
      gap: 24px;
      grid-template-columns: 1fr;
    }

    .about-portrait {
      max-width: 160px;
    }
  }
</style>
