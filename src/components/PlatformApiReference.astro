---
import ApiDocsLayout from "../layouts/ApiDocsLayout.astro";
import ApiReferenceScript from "./ApiReferenceScript.astro";
import processing from "../data/processing.openapi.json";
import simulator from "../data/bank-simulator.openapi.json";
import simulatorMetadata from "../data/platform-api.source-metadata.json";
import processingMetadata from "../data/processing-api.source-metadata.json";
import pgpPolicy from "../data/pgp-policy.openapi.json";
import pgpMetadata from "../data/pgp-policy.source.json";
interface Props {
  kind: "processing" | "bank-simulator" | "pgp-policy";
}
const { kind } = Astro.props;
const revision =
  kind === "pgp-policy"
    ? pgpMetadata.commit
    : (kind === "processing" ? processingMetadata : simulatorMetadata)
        .repositoryRevision;
const spec =
  kind === "pgp-policy"
    ? pgpPolicy
    : kind === "processing"
      ? processing
      : simulator;
const title = `${spec.info.title} documentation`;
const description =
  kind === "pgp-policy"
    ? "Production and Test PGP authorization reference: required signers, per-bank signature counts, blocking, key deletion and irreversible locking. SDK 6.1.0 examples."
    : kind === "processing"
      ? "Production Processing API reference: prepare and validate payments, generate XML, authenticate and handle errors. Includes TypeScript SDK examples and OpenAPI schemas."
      : "Configure synthetic bank accounts and scenarios, run tests and inspect results. Experimental test API reference with authentication, TypeScript examples and OpenAPI 3.0 schemas.";
const specPath = `/apis/${kind}/openapi.json`;
const specUrl = `${specPath}?revision=${revision}`;
const operationCount = Object.values(spec.paths).reduce(
  (count, path) =>
    count +
    Object.keys(path).filter((method) =>
      ["get", "post", "put", "delete", "patch"].includes(method),
    ).length,
  0,
);
const schemaCount = Object.keys(
  "definitions" in spec ? spec.definitions : spec.components.schemas,
).length;
---

<ApiDocsLayout
  {title}
  {description}
  version={spec.info.version}
  {operationCount}
  canonicalPath={`/apis/${kind}/`}
  {specPath}
  apiName={spec.info.title}
>
  <main
    id="api-reference"
    tabindex="-1"
    data-renderer="scalar"
    data-reference-only="true"
    data-spec-url={specUrl}
    data-api-name={spec.info.title}
    aria-busy="true"
  >
    <div class="docs-loading" role="status">
      <span aria-hidden="true"></span><div>
        <strong>Loading API reference</strong><small
          >{operationCount} operations · {schemaCount} schemas</small
        >
      </div>
    </div>
    <noscript
      ><section class="noscript-message">
        <h1>{title}</h1><p>
          JavaScript is required for the browsable reference. Download the
          complete <a href={specPath}>OpenAPI JSON document</a>.
        </p>
      </section></noscript
    >
  </main>
  <section class="reference-error" id="reference-error" role="alert" hidden>
    <strong>The API reference could not be loaded.</strong><span
      >The complete contract remains available as <a href={specPath}
        >OpenAPI JSON</a
      >, or contact <a href="mailto:support@isecure.fi">developer support</a
      >.</span
    >
  </section>
  <ApiReferenceScript />
</ApiDocsLayout>
