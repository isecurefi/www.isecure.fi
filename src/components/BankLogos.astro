---
const banks = [
  { name: "Aktia", logo: "/images/bank_icons/aktia_logo.png" },
  { name: "Ålandsbanken", logo: "/images/bank_icons/alandsbanken_logo.gif" },
  { name: "Handelsbanken", logo: "/images/bank_icons/handelsbanken_logo.gif" },
  { name: "Danske Bank", logo: "/images/bank_icons/danske_bank_logo.png" },
  { name: "Nordea", logo: "/images/bank_icons/nordea_logo.gif" },
  { name: "OP", logo: "/images/bank_icons/op_logo.gif" },
  { name: "POP", logo: "/images/bank_icons/pop_logo.png" },
  { name: "S-Pankki", logo: "/images/bank_icons/spankki_lahitapiola.png" },
  { name: "SEB", logo: "/images/bank_icons/SEBlogo.png" },
  { name: "Samlink", logo: "/images/bank_icons/samlink-logo.svg" },
  { name: "Crosskey", logo: "/images/bank_icons/crosskey-logo.svg" },
];
---

<div class="bank-logos" aria-label="Supported bank logos">
  <div class="bank-logo-track">
    {
      [false, true].map((duplicate) => (
        <div class="bank-logo-set" aria-hidden={duplicate ? "true" : undefined}>
          {banks.map((bank) => (
            <div class="bank-logo-tile">
              <img
                src={bank.logo}
                alt={duplicate ? "" : `${bank.name} logo`}
                class="bank-icon"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .bank-logos {
    align-items: center;
    display: block;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 5%,
      #000 95%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 5%,
      #000 95%,
      transparent
    );
  }

  .bank-logo-track {
    animation: bank-logo-flow 42s linear infinite;
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .bank-logo-set {
    display: flex;
    flex: 0 0 auto;
    gap: 12px;
    padding-right: 12px;
  }

  .bank-logo-tile {
    align-items: center;
    background: #ffffff;
    border: 1px solid #dce5ea;
    border-radius: 6px;
    display: inline-flex;
    flex: 0 0 auto;
    height: 60px;
    justify-content: center;
    min-width: 112px;
    padding: 10px 14px;
  }

  .bank-icon {
    max-height: 38px;
    max-width: 128px;
    object-fit: contain;
    transition: transform 0.2s ease;
    width: auto;
  }

  .bank-logo-tile:hover .bank-icon {
    transform: scale(1.05);
  }

  .bank-logos:hover .bank-logo-track,
  .bank-logos:focus-within .bank-logo-track {
    animation-play-state: paused;
  }

  @keyframes bank-logo-flow {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bank-logos {
      -webkit-mask-image: none;
      mask-image: none;
      overflow: visible;
    }

    .bank-logo-track {
      animation: none;
      width: 100%;
    }

    .bank-logo-set {
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
      width: 100%;
    }

    .bank-logo-set[aria-hidden="true"] {
      display: none;
    }
  }
</style>
