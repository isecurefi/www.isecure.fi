---
const banks = [
  { name: "Aktia", logo: "/images/bank_icons/aktia_logo.png" },
  { name: "Ålandsbanken", logo: "/images/bank_icons/alandsbanken_logo.gif" },
  { name: "Handelsbanken", logo: "/images/bank_icons/handelsbanken_logo.gif" },
  { name: "Nooa", logo: "/images/bank_icons/nooa_logo.gif" },
  { name: "Nordea", logo: "/images/bank_icons/nordea_logo.gif" },
  { name: "OKO", logo: "/images/bank_icons/oko_logo.gif" },
  { name: "POP", logo: "/images/bank_icons/pop_logo.png" },
  { name: "Sampo", logo: "/images/bank_icons/sampo_logo.png" },
  { name: "S-Pankki", logo: "/images/bank_icons/spankki_lahitapiola.png" },
  { name: "SEB", logo: "/images/bank_icons/SEBlogo.png" },
  { name: "Samlink", logo: "/images/bank_icons/samlink-logo.svg" },
  { name: "Crosskey", logo: "/images/bank_icons/crosskey-logo.svg" },
];
---

<div class="bank-logos" aria-label="Supported bank logos">
  {
    banks.map((bank) => (
      <div class="bank-logo-tile">
        <img
          src={bank.logo}
          alt={`${bank.name} logo`}
          class="bank-icon"
          loading="lazy"
          decoding="async"
        />
      </div>
    ))
  }
</div>

<style>
  .bank-logos {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .bank-logo-tile {
    align-items: center;
    background: #ffffff;
    border: 1px solid #dce5ea;
    border-radius: 6px;
    display: inline-flex;
    height: 60px;
    justify-content: center;
    min-width: 112px;
    padding: 10px 14px;
  }

  .bank-icon {
    max-height: 38px;
    max-width: 128px;
    object-fit: contain;
    transition: transform 0.2s ease;
    width: auto;
  }

  .bank-logo-tile:hover .bank-icon {
    transform: scale(1.05);
  }
</style>
