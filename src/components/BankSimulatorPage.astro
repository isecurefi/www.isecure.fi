---
import { bankSimulatorContent } from "../data/bankSimulator";
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import type { Lang } from "../types";
import CapabilityDirectionTable from "./CapabilityDirectionTable.astro";
import CatalogStatus from "./CatalogStatus.astro";
import CatalogFaqGlossary from "./CatalogFaqGlossary.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = bankSimulatorContent[lang];
const record = getCatalogRecord("bank-simulation");
const processingRecord = getCatalogRecord("processing-api");
if (processingRecord.visibility === "none") {
  throw new Error("Processing API must have a public route");
}
const sdkExampleUrl =
  "https://github.com/isecurefi/isecure-ts-client/blob/main/examples/bank-simulator/README.md";
---

<CatalogPageLayout lang={lang} description={content.meta.description} {record}>
  <article class="simulator-guide container">
    <header class="simulator-header">
      <p class="simulator-eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p class="simulator-intro">{content.intro}</p>
      <dl class="simulator-facts">
        <div>
          <dt>{content.baseUrlLabel}</dt>
          <dd><code>https://ws-api.test.isecure.fi/v2</code></dd>
        </div>
        <div>
          <dt>{content.bankLabel}</dt>
          <dd><code>simulator</code></dd>
        </div>
      </dl>
    </header>

    <CatalogStatus {lang} {record} />

    <div class="simulator-sections">
      {
        content.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.items && (
              <ul>
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>

    <CapabilityDirectionTable {lang} {record} />
    <CatalogFaqGlossary {lang} {record} />

    <aside class="simulator-processing">
      <div>
        <h2>{content.processingTitle}</h2>
        <p>{content.processingText}</p>
      </div>
      <a
        class="simulator-link simulator-link-primary"
        href={processingRecord.routes[lang]}
        data-analytics-content-type="product"
        data-analytics-item-id={processingRecord.id}
        data-analytics-source="bank-simulator-processing"
      >
        {content.processingLink}
      </a>
    </aside>

    <aside class="simulator-example">
      <h2>{content.exampleTitle}</h2>
      <p>{content.exampleText}</p>
      <div class="simulator-actions">
        <a
          class="simulator-link simulator-link-primary"
          href="/wsapi_v2/"
          data-analytics-content-type="developer_resource"
          data-analytics-item-id="file-exchange-api-reference"
          data-analytics-source="bank-simulator-example"
        >
          {content.apiLink}
        </a>
        <a
          class="simulator-link"
          href={sdkExampleUrl}
          target="_blank"
          rel="noopener"
          data-analytics-content-type="developer_resource"
          data-analytics-item-id="bank-simulator-sdk-example"
          data-analytics-source="bank-simulator-example"
        >
          {content.sdkLink}
        </a>
      </div>
    </aside>
  </article>
</CatalogPageLayout>

<style>
  .simulator-guide {
    margin: 3rem auto;
    max-width: 900px;
  }

  .simulator-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .simulator-eyebrow {
    color: #087f72;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .simulator-header h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .simulator-intro {
    font-size: 1.15rem;
    line-height: 1.75;
    max-width: 760px;
  }

  .simulator-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.75rem 0 0;
  }

  .simulator-facts div {
    background: var(--background-light);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    min-width: min(100%, 260px);
    padding: 0.85rem 1rem;
  }

  .simulator-facts dt {
    color: #5f6870;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .simulator-facts dd {
    margin: 0.25rem 0 0;
  }

  .simulator-facts code {
    color: #b42369;
  }

  .simulator-sections {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .simulator-sections section {
    max-width: 780px;
  }

  .simulator-sections h2,
  .simulator-processing h2,
  .simulator-example h2 {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }

  .simulator-sections p,
  .simulator-processing p,
  .simulator-example p {
    line-height: 1.75;
    margin-bottom: 0.75rem;
  }

  .simulator-sections ul {
    line-height: 1.75;
    padding-left: 1.25rem;
  }

  .simulator-sections li + li {
    margin-top: 0.35rem;
  }

  code {
    overflow-wrap: anywhere;
  }

  .simulator-processing,
  .simulator-example {
    background: #eef8f6;
    border: 1px solid #b9ddd6;
    border-radius: 12px;
    margin-top: 3rem;
    padding: 1.5rem;
  }

  .simulator-processing {
    align-items: center;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .simulator-processing p {
    margin-bottom: 0;
  }

  .simulator-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .simulator-link {
    border: 1px solid #087f72;
    border-radius: 8px;
    color: #087f72;
    display: inline-block;
    font-weight: 700;
    padding: 0.7rem 1rem;
    text-decoration: none;
  }

  .simulator-link-primary {
    background: #087f72;
    color: #fff;
  }

  .simulator-link:hover {
    background: #d9efeb;
    color: #066b61;
  }

  .simulator-link-primary:hover {
    background: #066b61;
    color: #fff;
  }

  .simulator-link:focus-visible {
    outline: 3px solid #212529;
    outline-offset: 3px;
  }

  @media (max-width: 576px) {
    .simulator-guide {
      margin: 2rem auto;
    }

    .simulator-link {
      text-align: center;
      width: 100%;
    }

    .simulator-processing {
      grid-template-columns: 1fr;
    }
  }
</style>
