---
import ProductApiLinks from "./ProductApiLinks.astro";
import { bankSimulatorContent } from "../data/bankSimulator";
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import type { Lang } from "../types";
import CapabilityDirectionTable from "./CapabilityDirectionTable.astro";
import CatalogStatus from "./CatalogStatus.astro";
import CatalogFaqGlossary from "./CatalogFaqGlossary.astro";
import Actions from "./ui/Actions.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import CardGrid from "./ui/CardGrid.astro";
import CheckList from "./ui/CheckList.astro";
import PageHero from "./ui/PageHero.astro";
import Section from "./ui/Section.astro";
import Split from "./ui/Split.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = bankSimulatorContent[lang];
const record = getCatalogRecord("bank-simulation");
const processingRecord = getCatalogRecord("processing-api");
if (processingRecord.visibility === "none") {
  throw new Error("Processing API must have a public route");
}
const sdkExampleUrl =
  "https://github.com/isecurefi/isecure-ts-client/blob/main/examples/bank-simulator/README.md";
const csharpExampleUrl =
  "https://github.com/isecurefi/isecure-cs-client/blob/main/examples/FileExchange/README.md";
---

<CatalogPageLayout
  lang={lang}
  description={content.meta.description}
  {record}
  fullWidth
>
  <PageHero
    slot="hero"
    eyebrow={content.eyebrow}
    title={content.title}
    lead={content.intro}
  >
    <Card slot="aside" icon="flask" tone="accent">
      <dl class="simulator-facts">
        <div>
          <dt>{content.baseUrlLabel}</dt>
          <dd><code>https://ws-api.test.isecure.fi/v2</code></dd>
        </div>
        <div>
          <dt>{content.bankLabel}</dt>
          <dd><code>simulator</code></dd>
        </div>
      </dl>
    </Card>
  </PageHero>

  <Section>
    <CatalogStatus {lang} {record} />
    <ProductApiLinks {lang} kind="bank-simulator" />
  </Section>

  <Section tone="band">
    <div class="simulator-sections">
      {
        content.sections.map((section) => (
          <Split>
            <h2 slot="side">{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.items && <CheckList items={section.items} />}
          </Split>
        ))
      }
    </div>
  </Section>

  <Section>
    <CapabilityDirectionTable {lang} {record} />
    <CatalogFaqGlossary {lang} {record} />
  </Section>

  <Section tone="band">
    <CardGrid columns={2}>
      <Card title={content.processingTitle} icon="file" headingLevel={2}>
        <p>{content.processingText}</p>
        <Actions>
          <Button
            href={processingRecord.routes[lang]}
            data-analytics-content-type="product"
            data-analytics-item-id={processingRecord.id}
            data-analytics-source="bank-simulator-processing"
          >
            {content.processingLink}
          </Button>
        </Actions>
      </Card>
      <Card
        title={content.exampleTitle}
        icon="code"
        headingLevel={2}
        tone="accent"
      >
        <p>{content.exampleText}</p>
        <Actions>
          <Button
            href="/wsapi_v2/"
            data-analytics-content-type="developer_resource"
            data-analytics-item-id="file-exchange-api-reference"
            data-analytics-source="bank-simulator-example"
          >
            {content.apiLink}
          </Button>
          <Button
            variant="secondary"
            href={sdkExampleUrl}
            external
            data-analytics-content-type="developer_resource"
            data-analytics-item-id="bank-simulator-sdk-example"
            data-analytics-source="bank-simulator-example"
          >
            {content.sdkLink}
          </Button>
        </Actions>
        <p class="csharp">{content.csharpExampleText}</p>
        <Button
          variant="link"
          href={csharpExampleUrl}
          external
          data-analytics-content-type="developer_resource"
          data-analytics-item-id="bank-simulator-csharp-example"
          data-analytics-source="bank-simulator-example"
        >
          {content.csharpLink}
        </Button>
      </Card>
    </CardGrid>
  </Section>
</CatalogPageLayout>

<style>
  .simulator-facts {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  .simulator-facts dt {
    color: var(--landing-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .simulator-facts dd {
    color: var(--landing-ink);
    font-size: 1.1rem;
    margin: 4px 0 0;
  }

  code {
    color: inherit;
    overflow-wrap: anywhere;
  }

  .simulator-sections {
    display: grid;
  }

  .simulator-sections > :global(.ui-split) {
    padding: 32px 0;
  }

  .simulator-sections > :global(.ui-split + .ui-split) {
    border-top: 1px solid var(--landing-line);
  }

  .simulator-sections > :global(.ui-split:first-child) {
    padding-top: 0;
  }

  .simulator-sections > :global(.ui-split:last-child) {
    padding-bottom: 0;
  }

  @media (max-width: 980px) {
    .simulator-sections > :global(.ui-split) {
      gap: 14px;
    }
  }

  .simulator-sections h2 {
    color: var(--landing-ink);
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0;
  }

  .simulator-sections p {
    color: var(--landing-muted);
    line-height: 1.75;
    margin: 0 0 14px;
  }

  .simulator-sections :global(.ui-checklist) {
    margin-top: 6px;
  }

  :global(.ui-card-body) .csharp {
    margin-top: 18px;
  }
</style>
