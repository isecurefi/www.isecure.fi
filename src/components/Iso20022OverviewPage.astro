---
import Layout from "../layouts/Layout.astro";
import { absoluteUrl, alternateLinks, localizedRoutes } from "../lib/seo";
import type { Lang } from "../types";
import Actions from "./ui/Actions.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import CardGrid from "./ui/CardGrid.astro";
import CheckList from "./ui/CheckList.astro";
import PageHero from "./ui/PageHero.astro";
import Prose from "./ui/Prose.astro";
import Section from "./ui/Section.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Split from "./ui/Split.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = localizedRoutes()[lang];
const routes = localizedRoutes("iso-20022");
const canonicalUrl = absoluteUrl(routes[lang]);

const content = {
  fi: {
    title: "ISO 20022 -sanomat: camt.053, camt.054 ja pain | ISECure",
    description:
      "Vertaa ISO 20022 camt.053-, camt.054-, pain.001- ja pain.002-sanomia. Katso mitä kukin pankkisanoma tekee ja miten aineistot integroidaan.",
    eyebrow: "ISO 20022 -opas ohjelmistotiimeille",
    h1: "ISO 20022 -sanomat pankki-integraatiossa",
    intro:
      "ISO 20022 määrittelee rakenteisia sanomia maksujen lähettämiseen, maksustatusten vastaanottamiseen sekä tiliotteiden ja tapahtumailmoitusten noutamiseen. Oikea sanoma riippuu siitä, mitä ohjelmistosi tekee ja mitä yrityksen pankkisopimus tarjoaa.",
    messageTitle: "Valitse sanoma käyttötarkoituksen mukaan",
    messages: [
      {
        slug: "pain-001",
        code: "pain.001",
        name: "Maksuaineisto",
        direction: "Ohjelmisto → pankki",
        text: "Customer Credit Transfer Initiation välittää SEPA-maksutoimeksiannot pankille.",
      },
      {
        slug: "pain-002",
        code: "pain.002",
        name: "Maksun status",
        direction: "Pankki → ohjelmisto",
        text: "Customer Payment Status Report kertoo aineiston vastaanotosta, hyväksynnästä tai hylkäyksestä.",
      },
      {
        slug: "camt-053",
        code: "camt.053",
        name: "Konekielinen tiliote",
        direction: "Pankki → ohjelmisto",
        text: "Bank-to-Customer Statement kokoaa saldot ja kirjatut tapahtumat raportointijaksolta.",
      },
      {
        slug: "camt-054",
        code: "camt.054",
        name: "Veloitus- ja hyvitysilmoitus",
        direction: "Pankki → ohjelmisto",
        text: "Debit/Credit Notification ilmoittaa pankin tarjoamista veloituksista ja hyvityksistä.",
      },
    ],
    sections: [
      {
        h2: "Tiedostonsiirto ja maksuaineiston muodostaminen ovat eri vastuita",
        paras: [
          "Tuotannossa oleva ISECure REST API — File Exchange siirtää pankin ja sopimuksen sallimat ISO 20022 -aineistot muuttamatta niiden sisältöä. Se hoitaa pankkikohtaiset Web Services -yhteydet, allekirjoitukset ja varmenteet.",
          "Erillinen Processing API muodostaa testikäytössä hallitusta maksuerästä tarkan pain.001-aineiston. Sillä on oma API Gateway ja audience-rajattu istunto; se ei lähetä aineistoa pankkiin.",
        ],
      },
      {
        h2: "Mitä toteutus edelleen vaatii",
        paras: [
          "Yritys tarvitsee omat pankkisopimukset ja aineistokohtaiset valtuudet. Pankki määrittää hyväksytyt sanoma- ja skeemaversiot, tiedostotyypit sekä toimitusrytmin. Ohjelmiston pitää käsitellä myös pankkikohtaiset soveltamisohjeet ja mahdolliset poikkeukset.",
        ],
        list: [
          "Pankkisopimukset ja aineistovaltuudet",
          "Pankin hyväksymä ISO 20022 -versio",
          "Web Services -varmenteet ja allekirjoitus",
          "Sanomien validointi, statuslogiikka ja täsmäytys",
        ],
      },
    ],
    dataLink: "Tutustu Processing API:n maksuaineistopolkuun",
    ctaTitle: "Yhdistä ISO 20022 -aineistot tuotteeseesi",
    ctaText:
      "Kerro pankit, sanomatyypit ja käyttämäsi versiot. Selvitämme sopivan tiedostonsiirto- tai datamallin.",
    ctaLabel: "Keskustele integraatiosta",
  },
  en: {
    title: "ISO 20022 Messages: camt.053, camt.054 and pain | ISECure",
    description:
      "Compare ISO 20022 camt.053, camt.054, pain.001, and pain.002. Learn what each bank message does and how to integrate the files.",
    eyebrow: "ISO 20022 guide for software teams",
    h1: "ISO 20022 messages in bank integration",
    intro:
      "ISO 20022 defines structured messages for sending payments, receiving payment status, and retrieving statements or account notifications. The right message depends on what your product needs to do and what the company's bank agreement provides.",
    messageTitle: "Choose the message by business task",
    messages: [
      {
        slug: "pain-001",
        code: "pain.001",
        name: "Payment initiation file",
        direction: "Software → bank",
        text: "Customer Credit Transfer Initiation carries SEPA payment instructions to the bank.",
      },
      {
        slug: "pain-002",
        code: "pain.002",
        name: "Payment status",
        direction: "Bank → software",
        text: "Customer Payment Status Report describes reception, acceptance, or rejection of a payment file.",
      },
      {
        slug: "camt-053",
        code: "camt.053",
        name: "Bank statement",
        direction: "Bank → software",
        text: "Bank-to-Customer Statement summarizes balances and booked entries for a reporting period.",
      },
      {
        slug: "camt-054",
        code: "camt.054",
        name: "Debit/credit notification",
        direction: "Bank → software",
        text: "Debit/Credit Notification reports debits and credits when the bank provides the message.",
      },
    ],
    sections: [
      {
        h2: "File transport and payment generation have separate responsibilities",
        paras: [
          "The production ISECure REST API — File Exchange transports ISO 20022 files allowed by the bank and customer agreement without changing their content. It handles bank-specific Web Services connections, signing, and certificates.",
          "The separate Processing API generates exact pain.001 from a governed payment batch in the test environment. It has its own API Gateway and audience-bound session; it does not submit the file to a bank.",
        ],
      },
      {
        h2: "What an implementation still requires",
        paras: [
          "The company needs its own bank agreements and file authorizations. Each bank defines accepted message and schema versions, file types, and delivery schedules. Your software must also handle bank implementation guidelines and exceptions.",
        ],
        list: [
          "Bank agreements and file authorizations",
          "An ISO 20022 version accepted by the bank",
          "Web Services certificates and message signing",
          "Message validation, status logic, and reconciliation",
        ],
      },
    ],
    dataLink: "Explore the Processing API payment workflow",
    ctaTitle: "Connect ISO 20022 files to your product",
    ctaText:
      "Tell us the banks, message types, and versions you use. We will identify the appropriate file-transport or data model.",
    ctaLabel: "Discuss your integration",
  },
  se: {
    title: "ISO 20022-meddelanden: camt.053, camt.054 och pain | ISECure",
    description:
      "Jämför ISO 20022 camt.053, camt.054, pain.001 och pain.002. Läs vad varje bankmeddelande gör och hur filerna integreras.",
    eyebrow: "ISO 20022-guide för programvaruteam",
    h1: "ISO 20022-meddelanden i bankintegration",
    intro:
      "ISO 20022 definierar strukturerade meddelanden för att skicka betalningar, ta emot betalningsstatus och hämta kontoutdrag eller kontoaviseringar. Rätt meddelande beror på vad produkten ska göra och vad företagets bankavtal erbjuder.",
    messageTitle: "Välj meddelande enligt användningsfall",
    messages: [
      {
        slug: "pain-001",
        code: "pain.001",
        name: "Betalningsfil",
        direction: "Programvara → bank",
        text: "Customer Credit Transfer Initiation förmedlar SEPA-betalningsuppdrag till banken.",
      },
      {
        slug: "pain-002",
        code: "pain.002",
        name: "Betalningsstatus",
        direction: "Bank → programvara",
        text: "Customer Payment Status Report beskriver mottagning, godkännande eller avvisning av en betalningsfil.",
      },
      {
        slug: "camt-053",
        code: "camt.053",
        name: "Kontoutdrag",
        direction: "Bank → programvara",
        text: "Bank-to-Customer Statement sammanfattar saldon och bokförda poster för en rapportperiod.",
      },
      {
        slug: "camt-054",
        code: "camt.054",
        name: "Debet-/kreditavisering",
        direction: "Bank → programvara",
        text: "Debit/Credit Notification rapporterar debiteringar och krediteringar när banken erbjuder meddelandet.",
      },
    ],
    sections: [
      {
        h2: "Filtransport och betalningsgenerering har olika ansvar",
        paras: [
          "ISECure REST API — File Exchange i produktion transporterar ISO 20022-filer som banken och kundavtalet tillåter utan att ändra innehållet. Det hanterar bankspecifika Web Services-anslutningar, signering och certifikat.",
          "Det separata Processing API:t genererar exakt pain.001 från en styrd betalningsbatch i testmiljön. Det har en egen API Gateway och audience-bunden session och skickar inte filen till banken.",
        ],
      },
      {
        h2: "Vad en implementation fortfarande kräver",
        paras: [
          "Företaget behöver egna bankavtal och filbehörigheter. Varje bank definierar godkända meddelande- och schemaversioner, filtyper och leveransrytmer. Programvaran måste även hantera bankens tillämpningsanvisningar och undantag.",
        ],
        list: [
          "Bankavtal och filbehörigheter",
          "En ISO 20022-version som banken godkänner",
          "Web Services-certifikat och meddelandesignering",
          "Meddelandevalidering, statuslogik och avstämning",
        ],
      },
    ],
    dataLink: "Utforska betalningsflödet i Processing API",
    ctaTitle: "Anslut ISO 20022-filer till er produkt",
    ctaText:
      "Berätta vilka banker, meddelandetyper och versioner ni använder. Vi identifierar en lämplig filtransport- eller datamodell.",
    ctaLabel: "Diskutera integrationen",
  },
} satisfies Record<Lang, unknown>;

const t = content[lang];
---

<Layout
  title={t.title}
  lang={lang}
  description={t.description}
  canonicalUrl={canonicalUrl}
  alternateLinks={alternateLinks(routes)}
  fullWidth
>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.intro} />

  <Section>
    <SectionHeading title={t.messageTitle} />
    <CardGrid columns={4}>
      {
        t.messages.map((message) => (
          <Card title={message.name} href={`${base}${message.slug}/`}>
            <span class="message-code" slot="header">
              {message.code}
            </span>
            <p class="message-direction">{message.direction}</p>
            <p>{message.text}</p>
          </Card>
        ))
      }
    </CardGrid>
  </Section>

  {
    t.sections.map((section, index) => (
      <Section tone={index % 2 === 0 ? "band" : "plain"}>
        <Split sticky>
          <SectionHeading slot="side" title={section.h2} />
          <Prose>
            {section.paras.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </Prose>
          {section.list && (
            <div class="section-list">
              <CheckList items={section.list} />
            </div>
          )}
        </Split>
      </Section>
    ))
  }

  <Section tone="band">
    <SectionHeading title={t.ctaTitle} lead={t.ctaText} align="center">
      <Actions align="center">
        <Button href="#contact">{t.ctaLabel}</Button>
        <Button variant="secondary" href={`${base}processing-api/`}>
          {t.dataLink} →
        </Button>
      </Actions>
    </SectionHeading>
  </Section>
</Layout>

<style>
  .message-code {
    color: var(--landing-accent);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      monospace;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .message-direction {
    color: var(--landing-ink);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .section-list {
    margin-top: 28px;
  }
</style>
