---
import '../styles/Hero.css';
import { getText } from '../store/translations';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero-section bg-gradient">
  <div class="hero-title">
    <h1>{getText('frontContent.title', lang)}</h1>
  </div>
  <div class="hero-container container">
    <div class="hero-item">
      <div class="hero-content">
        <img 
          src="/images/isecure_header1_b.png" 
          alt="WS-Kanava"
          class="hero-image"
        />
        <h1>{getText('hero.title1', lang)}</h1>
        <h3>{getText('hero.subtitle1', lang)}</h3>
        <a href={`/${lang}/ws-kanava`} class="btn btn-primary">WS-Kanava</a>
      </div>
    </div>

    <div class="hero-item">
      <div class="hero-content">
        <img 
          src="/images/kustom.png" 
          alt="WS-Kanava API"
          class="hero-image"
        />
        <h1>{getText('hero.title2', lang)}</h1>
        <h3>{getText('hero.subtitle2', lang)}</h3>
        <a href={`/${lang}/ws-api`} class="btn btn-primary">WS-Kanava API</a>
      </div>
    </div>
  </div>
</section>
