---
import '../styles/Hero.css';
import { getText } from '../store/translations';
import type { Lang } from '../types';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="hero-section bg-gradient">
  <div class="hero-title">
    <h1>{getText('frontContent.title', lang)}</h1>
  </div>
  <div class="hero-container container">
    <div class="hero-item">
      <div class="hero-content">
        <div class="hero-upper">
          <div class="hero-image-container">
            <OptimizedImage
              src="/images/isecure_header1_b.png"
              alt={lang === 'en' ? 'WS-Channel' : lang === 'se' ? 'WS-Kanal' : 'WS-Kanava'}
              class="hero-image"
              width={600}
              height={400}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              format="webp"
            />
          </div>
          <div class="hero-text">
            <h1>{getText('hero.title1', lang)}</h1>
            <h3>{getText('hero.subtitle1', lang)}</h3>
          </div>
        </div>
        <div class="hero-button">
          <a href={`/${lang}/ws-channel/index.html`} class="btn btn-primary">
            {lang === 'en' ? 'WS-Channel' : lang === 'se' ? 'WS-Kanal' : 'WS-Kanava'}
          </a>
        </div>
      </div>
    </div>

    <div class="hero-item">
      <div class="hero-content">
        <div class="hero-upper">
          <div class="hero-image-container">
            <OptimizedImage
              src="/images/kustom.png"
              alt={`${lang === 'en' ? 'WS-Channel' : lang === 'se' ? 'WS-Kanal' : 'WS-Kanava'} API`}
              class="hero-image"
              width={600}
              height={400}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              format="webp"
            />
          </div>
          <div class="hero-text">
            <h1>{getText('hero.title2', lang)}</h1>
            <h3>{getText('hero.subtitle2', lang)}</h3>
          </div>
        </div>
        <div class="hero-button">
          <a href={`/${lang}/ws-api/index.html`} class="btn btn-primary">
            {lang === 'en' ? 'WS-Channel' : lang === 'se' ? 'WS-Kanal' : 'WS-Kanava'} API
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
