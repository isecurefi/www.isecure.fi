---
import { getText } from '../store/translations';
import type { Lang } from '../types';

interface Props {
  lang?: Lang;
}

const { lang = 'fi' } = Astro.props;
---
<div class="container">
  <div class="row">
    <div class="col-md-12">
      <h3>{getText('references.title', lang)}</h3>
      <div class="references">
        <img 
          src="/images/references/fennoa.png" 
          class="reference" 
          alt="Fennoa"
          loading="lazy"
          width="150"
          height="60"
          decoding="async"
        >
        <img src="/images/references/briox.svg" class="reference" style="width:30%;" alt="Briox">
        <img src="/images/references/graphia-logo.jpg" class="reference" alt="Graphia">
        <img src="/images/references/hostingpalvelu.png" class="reference" alt="Hostingpalvelu">
        <img src="/images/references/secureaction.png" class="reference" alt="Secureaction">
        <img src="/images/references/joutsen-rahoitus.png" class="reference" alt="Joutsen Rahoitus">
        <img src="/images/references/talokeskus.jpg" class="reference" alt="Talokeskus">
        <img src="/images/references/acFakta.png" class="reference" alt="acFakta">
      </div>
    </div>
  </div>
</div>

<style>
.references {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 2rem;
  padding: 2rem 0;
}

.reference {
  max-height: 60px;
  width: auto;
  object-fit: contain;
}
</style>
