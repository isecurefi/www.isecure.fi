---
import {
  catalogUi,
  getCatalogRecord,
  getPublicProductRecords,
} from "../data/productRegistry";
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../types";
import CatalogNavigation from "./CatalogNavigation.astro";
import CatalogAccessSummary from "./CatalogAccessSummary.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const origin = "https://www.isecure.fi";
const route = lang === "fi" ? "/products/" : `/${lang}/products/`;
const canonicalUrl = `${origin}${route}`;
const ui = catalogUi[lang];
const copy = {
  fi: {
    title: "Tuotteet | ISECure",
    description: "ISECuren tuotteet sekä niiden tuotevaihe ja käyttöönpääsy.",
    eyebrow: "ISECure-tuotteet",
    heading: "Valitse työnkulkuusi sopiva tuote",
    lead: "Vertaa tuotteiden kypsyyttä, saatavilla olevaa ympäristöä, rekisteröinti- ja tilausvaatimuksia sekä käyttöönpääsyä.",
    journeyEyebrow: "Aloita ennen pankkisopimusta",
    journeyTitle:
      "Testaa maksuaineistopolku nyt, kohdista sama API oikeaan pankkiin myöhemmin",
    journeyLead:
      "Tuotteet säilyvät erillisinä: Processing API valmistelee tiedoston, sovelluksesi allekirjoittaa sen ja Pankkisimulaattori testaa File Exchange -palautepolun. Kun sopimus ja tuotantovarmenteet ovat valmiit, sama File Exchange API kohdistetaan erikseen pätevöityyn oikeaan pankkiyhteyteen.",
    localLabel: "Oma sovelluksesi",
    localText:
      "Tarkistaa ja allekirjoittaa täsmälleen samat tavut paikallisesti.",
    simulatorText:
      "Palauttaa synteettiset pain.002-, camt.054- ja camt.053-aineistot.",
    connectivityText:
      "Kohdistaa saman File Exchange API:n erikseen pätevöityyn oikeaan pankkiyhteyteen.",
    journeyLimit:
      "Nykyiset esimerkit ajetaan erikseen. Simulaattorievidenssi ei ole pankin hyväksyntä tai tuotantopätevyys.",
  },
  en: {
    title: "Products | ISECure",
    description:
      "ISECure products with their product stage and customer access.",
    eyebrow: "ISECure products",
    heading: "Choose the product that fits your workflow",
    lead: "Compare each product’s maturity, available environment, registration and subscription requirements, and how to get access.",
    journeyEyebrow: "Start before the bank agreement",
    journeyTitle:
      "Test the payment-file path now, point the same API at a real bank later",
    journeyLead:
      "The products stay separate: Processing API prepares the file, your application signs it, and Bank Simulator tests the File Exchange feedback path. Once the agreement and production certificates are ready, the same File Exchange API targets the separately qualified real-bank connection.",
    localLabel: "Your application",
    localText: "Verifies and signs the exact same bytes locally.",
    simulatorText: "Returns synthetic pain.002, camt.054, and camt.053 files.",
    connectivityText:
      "Targets a separately qualified real-bank connection through the same File Exchange API.",
    journeyLimit:
      "The current examples run separately. Simulator evidence is not bank acceptance or production qualification.",
  },
  se: {
    title: "Produkter | ISECure",
    description: "ISECures produkter med produktfas och kundåtkomst.",
    eyebrow: "ISECure-produkter",
    heading: "Välj produkten som passar ert arbetsflöde",
    lead: "Jämför produkternas mognad, tillgängliga miljö, krav på registrering och prenumeration samt hur ni får åtkomst.",
    journeyEyebrow: "Börja före bankavtalet",
    journeyTitle:
      "Testa betalningsfilflödet nu, rikta samma API mot en riktig bank senare",
    journeyLead:
      "Produkterna förblir separata: Processing API förbereder filen, er applikation signerar den och Banksimulatorn testar File Exchange-responsflödet. När avtalet och produktionscertifikaten är klara riktas samma File Exchange API mot den separat kvalificerade riktiga bankanslutningen.",
    localLabel: "Er applikation",
    localText: "Verifierar och signerar exakt samma byte lokalt.",
    simulatorText:
      "Returnerar syntetiska pain.002-, camt.054- och camt.053-filer.",
    connectivityText:
      "Riktar samma File Exchange API mot en separat kvalificerad riktig bankanslutning.",
    journeyLimit:
      "De nuvarande exemplen körs separat. Simulatorevidens är inte bankens godkännande eller produktionskvalificering.",
  },
}[lang];
const alternateLinks = [
  { hreflang: "fi", href: `${origin}/products/` },
  { hreflang: "en", href: `${origin}/en/products/` },
  { hreflang: "sv", href: `${origin}/se/products/` },
  { hreflang: "x-default", href: `${origin}/en/products/` },
];
const products = getPublicProductRecords();
const entries = products;
const processing = getCatalogRecord("processing-api");
const simulator = getCatalogRecord("bank-simulation");
const connectivity = getCatalogRecord("bank-connectivity");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  url: canonicalUrl,
  name: copy.title,
  description: copy.description,
  inLanguage: lang === "fi" ? "fi-FI" : lang === "en" ? "en-US" : "sv-SE",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: entries.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: entry.name[lang],
      url: `${origin}${entry.routes[lang]}`,
    })),
  },
};
---

<Layout
  title={copy.title}
  description={copy.description}
  socialDescription={copy.description}
  {canonicalUrl}
  {alternateLinks}
  {structuredData}
  {lang}
  bodyClass="product-index-page"
>
  <CatalogNavigation {lang} />
  <article class="product-index container">
    <header>
      <p class="product-index-eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.lead}</p>
    </header>

    <section class="test-journey" aria-labelledby="test-journey-title">
      <p class="test-journey-eyebrow">{copy.journeyEyebrow}</p>
      <h2 id="test-journey-title">{copy.journeyTitle}</h2>
      <p>{copy.journeyLead}</p>
      <ol>
        <li>
          <a
            href={processing.routes[lang]}
            data-analytics-content-type="product"
            data-analytics-item-id={processing.id}
            data-analytics-source="product-index-test-journey"
            >{processing.name[lang]}</a
          >
          <span>{processing.buyerJob[lang]}</span>
        </li>
        <li>
          <strong>{copy.localLabel}</strong>
          <span>{copy.localText}</span>
        </li>
        <li>
          <a
            href={simulator.routes[lang]}
            data-analytics-content-type="product"
            data-analytics-item-id={simulator.id}
            data-analytics-source="product-index-test-journey"
            >{simulator.name[lang]}</a
          >
          <span>{copy.simulatorText}</span>
        </li>
        <li>
          <a
            href={connectivity.routes[lang]}
            data-analytics-content-type="product"
            data-analytics-item-id={connectivity.id}
            data-analytics-source="product-index-test-journey"
            >{connectivity.name[lang]}</a
          >
          <span>{copy.connectivityText}</span>
        </li>
      </ol>
      <small>{copy.journeyLimit}</small>
    </section>

    <section aria-label={ui.catalogEntries}>
      <div class="product-grid">
        {
          entries.map((entry) => (
            <article class="product-card" data-catalog-entry={entry.id}>
              <CatalogAccessSummary
                {lang}
                stage={entry.stage}
                access={entry.access}
                compact
                card
              >
                <h3 slot="title">
                  <a
                    href={entry.routes[lang]}
                    data-analytics-content-type="product"
                    data-analytics-item-id={entry.id}
                    data-analytics-source="product-index"
                  >
                    {entry.name[lang]}
                  </a>
                </h3>
                <div class="product-card-content" data-card-content>
                  <p>{entry.buyerJob[lang]}</p>
                  <small>{entry.qualification.scope[lang]}</small>
                </div>
              </CatalogAccessSummary>
            </article>
          ))
        }
      </div>
    </section>
  </article>
</Layout>

<style>
  .product-index {
    margin: 3rem auto;
    max-width: 1040px;
  }

  .product-index > header {
    max-width: 780px;
  }

  .product-index-eyebrow {
    color: #087f72;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-index h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .product-index > header > p:last-child {
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .product-index section {
    margin-top: 3rem;
  }

  .test-journey {
    background: #eef8f6;
    border: 1px solid #b9ddd6;
    border-radius: 12px;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .test-journey-eyebrow {
    color: #087f72;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }

  .test-journey h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0;
  }

  .test-journey > p:not(.test-journey-eyebrow) {
    line-height: 1.65;
    max-width: 800px;
  }

  .test-journey ol {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
  }

  .test-journey li {
    background: #fff;
    border: 1px solid #cde2dd;
    border-radius: 8px;
    padding: 0.9rem;
  }

  .test-journey li a,
  .test-journey li strong {
    color: #075d75;
    display: block;
    font-weight: 750;
    margin-bottom: 0.35rem;
  }

  .test-journey li span,
  .test-journey small {
    color: #53636a;
    line-height: 1.5;
  }

  .product-grid {
    display: grid;
    column-gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 2.5rem;
  }

  .product-card {
    min-width: 0;
    padding: 0;
  }

  .product-card h3 {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    line-height: 1.25;
    margin: 0;
  }

  .product-card p {
    font-size: 1.03rem;
    line-height: 1.6;
    margin-top: 0.8rem;
  }

  .product-card small {
    color: #53636a;
    display: block;
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .product-card a {
    color: #075d75;
    font-weight: 750;
    text-decoration: none;
  }

  .product-card a:hover {
    color: #087f72;
  }

  .product-card a:focus-visible {
    border-radius: 3px;
    outline: 3px solid #58b7aa;
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .product-grid,
    .test-journey ol {
      grid-template-columns: 1fr;
    }
  }
</style>
