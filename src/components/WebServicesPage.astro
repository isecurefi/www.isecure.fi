---
import { getCatalogRecord } from "../data/productRegistry";
import CatalogPageLayout from "../layouts/CatalogPageLayout.astro";
import type { Lang } from "../types";
import CapabilityDirectionTable from "./CapabilityDirectionTable.astro";
import CatalogAccessSummary from "./CatalogAccessSummary.astro";
import CatalogFaqGlossary from "./CatalogFaqGlossary.astro";
import Actions from "./ui/Actions.astro";
import Button from "./ui/Button.astro";
import Card from "./ui/Card.astro";
import CardGrid from "./ui/CardGrid.astro";
import CheckList from "./ui/CheckList.astro";
import PageHero from "./ui/PageHero.astro";
import Section from "./ui/Section.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Split from "./ui/Split.astro";

interface PageContent {
  title: string;
  description: string;
  h1: string;
  intro: string;
  statusTitle: string;
  limitationsTitle: string;
  simulatorTitle: string;
  simulatorText: string;
  simulatorLink: string;
  sections: Array<{
    h2: string;
    paras: string[];
    list?: string[];
  }>;
}

const { lang } = Astro.props;
const record = getCatalogRecord("bank-connectivity");
const simulatorRecord = getCatalogRecord("bank-simulation");
if (simulatorRecord.visibility === "none") {
  throw new Error("Bank Simulator must have a public route");
}

const content = {
  fi: {
    title: "WS-kanava API suomalaisiin pankkeihin | ISECure",
    description:
      "WS-kanava API yhdistää ohjelmistosi suomalaisten pankkien yritysaineistoihin. ISECure hoitaa Web Services -yhteydet, varmenteet ja pankkikohtaiset erot.",
    h1: "WS-kanava API: yksi integraatio suomalaisiin pankkeihin",
    intro:
      "Web Services -kanava on suomalaisten pankkien standardi yritysasiakkaiden aineistoliikenteelle: tiliotteiden noutamiselle ja maksuaineistojen lähettämiselle. Tässä oppaassa käymme läpi, miten se toimii ja mitä integrointi vaatii.",
    statusTitle: "Tarkka vaihe ja pääsy",
    limitationsTitle: "Palvelun rajat",
    simulatorTitle: "Testaa ensin Pankkisimulaattorilla",
    simulatorText:
      "Aloita jo silloin, kun pankkisopimus ja tuotantovarmenteet ovat vielä työn alla. Pankkisimulaattorilla voit testata saman API:n varmenteen rekisteröinnin, tiedostojen listauksen ja latauksen sekä allekirjoitetun maksuaineiston lähetyksen synteettisillä aineistoilla. Kun oikea pankki on valmis, kohdista täsmälleen sama File Exchange API erikseen määritettyyn pankkiyhteyteen ja säilytä simulaattori testausta varten. Oikeat pankkikanavat eivät tarjoa vastaavaa asiakkaan hallitsemaa testiympäristöä.",
    simulatorLink: "Tutustu Pankkisimulaattoriin",
    sections: [
      {
        h2: "Mikä Web Services -kanava on",
        paras: [
          "WS-kanava on pankkien tarjoama SOAP-pohjainen rajapinta, jonka kautta yrityksen ohjelmisto noutaa konekielisiä tiliotteita ja lähettää maksuaineistoja. Se korvaa vanhemmat eräsiirtomenetelmät ja on käytössä kaikilla suurilla suomalaisilla pankeilla.",
          "Sanomaliikenne on allekirjoitettua ja salattua, ja se perustuu pankin myöntämiin PKI-varmenteisiin. Aineistot ovat pääosin ISO 20022 -muotoisia: tiliote camt.053, maksut pain.001 ja maksupalaute pain.002.",
        ],
      },
      {
        h2: "Mitä integrointi vaatii",
        paras: [
          "WS-yhteyden käyttöönotto edellyttää Web Services -sopimusta pankin kanssa sekä varmennehakemusta. Ohjelmiston on osattava muodostaa ja allekirjoittaa WS-sanomat, hallita avaimia ja varmenteiden uusintaa sekä käsitellä ISO 20022 -aineistoja.",
          "Tämä on merkittävä toteutustyö pankkia kohden — ja se on toistettava jokaiselle pankille erikseen, koska yhteyksissä on pankkikohtaisia eroja.",
        ],
        list: [
          "Web Services -sopimus ja varmenteet pankin kanssa",
          "WS-sanomien muodostus, allekirjoitus ja salaus",
          "Avainten ja varmenteiden elinkaaren hallinta",
          "ISO 20022 -aineistojen (camt.053, pain.001/002) käsittely",
        ],
      },
      {
        h2: "Miten ISECure yksinkertaistaa tämän",
        paras: [
          "ISECure tarjoaa WS-kanavan yhtenä REST-rajapintana. Hoidamme sanomien allekirjoituksen, varmenteet ja avainten hallinnan sekä pankkikohtaiset erot, joten ohjelmistosi tekee vain yksinkertaisia REST-kutsuja. Yksi integraatio kattaa tukemamme suomalaiset pankit.",
        ],
      },
    ],
  },
  en: {
    title: "Finnish Bank Web Services API | ISECure",
    description:
      "Connect software to Finnish corporate banking through one Web Services API. ISECure handles bank connections, certificates, signing, and bank-specific differences.",
    h1: "Finnish bank Web Services through one API",
    intro:
      "The Web Services channel is the Finnish banks' standard for corporate file traffic: retrieving statements and sending payment files. This guide covers how it works and what integrating it requires.",
    statusTitle: "Exact stage and access",
    limitationsTitle: "Service boundaries",
    simulatorTitle: "Test first with Bank Simulator",
    simulatorText:
      "Start while the bank agreement and production certificates are still in progress. Bank Simulator lets you test the same API's certificate enrollment, file listing and download, and signed payment-file upload with synthetic data. When the real bank is ready, point that exact File Exchange API contract at the separately configured bank connection and keep the simulator for testing. Real bank channels do not provide an equivalent customer-controlled test environment.",
    simulatorLink: "Explore Bank Simulator",
    sections: [
      {
        h2: "What the Web Services channel is",
        paras: [
          "The WS channel is a SOAP-based interface offered by banks, through which a company's software retrieves machine-readable statements and sends payment files. It replaces older batch-transfer methods and is used by all major Finnish banks.",
          "The messaging is signed and encrypted, based on PKI certificates issued by the bank. The files are mostly in ISO 20022 format: statements as camt.053, payments as pain.001, and payment feedback as pain.002.",
        ],
      },
      {
        h2: "What integration requires",
        paras: [
          "Adopting a WS connection requires a Web Services agreement with the bank and a certificate application. The software must build and sign WS messages, manage keys and certificate renewal, and process ISO 20022 files.",
          "This is a significant implementation effort per bank — and it must be repeated for each bank, because there are bank-specific differences in the connections.",
        ],
        list: [
          "Web Services agreement and certificates with the bank",
          "Building, signing, and encrypting WS messages",
          "Managing the lifecycle of keys and certificates",
          "Processing ISO 20022 files (camt.053, pain.001/002)",
        ],
      },
      {
        h2: "How ISECure simplifies this",
        paras: [
          "ISECure offers the WS channel as a single REST API. We handle message signing, certificates, key management, and bank-specific differences, so your software only makes simple REST calls. One integration covers the Finnish banks we support.",
        ],
      },
    ],
  },
  se: {
    title: "WS-kanal API för finländska banker | ISECure",
    description:
      "Anslut programvara till finländsk företagsbank via ett WS-kanal API. ISECure sköter bankanslutningar, certifikat, signering och bankspecifika skillnader.",
    h1: "WS-kanal API: en integration till finländska banker",
    intro:
      "Web Services-kanalen är de finländska bankernas standard för företagens filtrafik: att hämta kontoutdrag och skicka betalningsfiler. Den här guiden går igenom hur den fungerar och vad en integration kräver.",
    statusTitle: "Exakt fas och åtkomst",
    limitationsTitle: "Tjänstens gränser",
    simulatorTitle: "Testa först med Banksimulatorn",
    simulatorText:
      "Börja medan bankavtalet och produktionscertifikaten fortfarande är under arbete. Med Banksimulatorn kan ni testa certifikatregistrering, fillistning och hämtning samt uppladdning av signerade betalningsfiler via samma API med syntetiska data. När den riktiga banken är klar riktar ni exakt samma File Exchange API mot den separat konfigurerade bankanslutningen och behåller simulatorn för testning. Riktiga bankkanaler erbjuder inte en motsvarande testmiljö som kunden kan styra.",
    simulatorLink: "Utforska Banksimulatorn",
    sections: [
      {
        h2: "Vad Web Services-kanalen är",
        paras: [
          "WS-kanalen är ett SOAP-baserat gränssnitt som bankerna erbjuder, genom vilket ett företags programvara hämtar maskinläsbara kontoutdrag och skickar betalningsfiler. Den ersätter äldre batchöverföringsmetoder och används av alla stora finländska banker.",
          "Meddelandetrafiken är signerad och krypterad, baserad på PKI-certifikat utfärdade av banken. Filerna är mestadels i ISO 20022-format: kontoutdrag som camt.053, betalningar som pain.001 och betalningsrespons som pain.002.",
        ],
      },
      {
        h2: "Vad integrationen kräver",
        paras: [
          "Att ta i bruk en WS-anslutning kräver ett Web Services-avtal med banken och en certifikatansökan. Programvaran måste bygga och signera WS-meddelanden, hantera nycklar och certifikatförnyelse samt bearbeta ISO 20022-filer.",
          "Detta är ett betydande implementeringsarbete per bank — och det måste upprepas för varje bank, eftersom det finns bankspecifika skillnader i anslutningarna.",
        ],
        list: [
          "Web Services-avtal och certifikat med banken",
          "Bygga, signera och kryptera WS-meddelanden",
          "Hantera livscykeln för nycklar och certifikat",
          "Bearbeta ISO 20022-filer (camt.053, pain.001/002)",
        ],
      },
      {
        h2: "Hur ISECure förenklar detta",
        paras: [
          "ISECure erbjuder WS-kanalen som ett enda REST-API. Vi sköter meddelandesignering, certifikat, nyckelhantering och de bankspecifika skillnaderna, så din programvara gör endast enkla REST-anrop. En integration täcker de finländska banker vi stöder.",
        ],
      },
    ],
  },
} satisfies Record<Lang, PageContent>;

const t = content[lang];

const related = [
  {
    slug: "camt-053",
    fi: "Konekielinen tiliote (camt.053)",
    en: "Machine-readable statements (camt.053)",
    se: "Maskinläsbart kontoutdrag (camt.053)",
  },
  {
    slug: "pain-001",
    fi: "SEPA-maksuaineisto (pain.001)",
    en: "SEPA payment files (pain.001)",
    se: "SEPA-betalningsfiler (pain.001)",
  },
  {
    slug: "pain-002",
    fi: "Maksupalaute (pain.002)",
    en: "Payment status (pain.002)",
    se: "Betalningsstatus (pain.002)",
  },
  {
    slug: "camt-054",
    fi: "Tapahtumailmoitukset (camt.054)",
    en: "Debit and credit notifications (camt.054)",
    se: "Debet- och kreditaviseringar (camt.054)",
  },
  {
    slug: "nordea",
    fi: "Nordea-pankkiyhteys",
    en: "Nordea bank connectivity",
    se: "Nordea-bankförbindelse",
  },
  {
    slug: "pankkiyhteys",
    fi: "Pankkiyhteysohjelma: rakenna itse vai osta",
    en: "Bank connectivity: build vs buy",
    se: "Bankförbindelse: bygga eller köpa",
  },
];
const relatedTitle = { fi: "Lue myös", en: "See also", se: "Läs även" }[lang];
const relatedHref = (slug: string) =>
  lang === "fi" ? `/${slug}/` : `/${lang}/${slug}/`;
---

<CatalogPageLayout
  lang={lang}
  title={t.title}
  description={t.description}
  {record}
  bodyClass="bank-connectivity-page"
  fullWidth
>
  <PageHero slot="hero" eyebrow={record.name[lang]} title={t.h1} lead={t.intro}>
    <section
      slot="aside"
      class="status"
      aria-labelledby="bank-connectivity-status"
    >
      <Card tone="accent">
        <CatalogAccessSummary
          slot="header"
          {lang}
          stage={record.stage}
          access={record.access}
        />
        <h2 id="bank-connectivity-status">{t.statusTitle}</h2>
        <p>{record.qualification.scope[lang]}</p>
        <Actions>
          <Button
            href={record.cta.href[lang]}
            data-analytics-content-type="product_access"
            data-analytics-item-id={record.id}
            data-analytics-source="product-status"
          >
            {record.cta.label[lang]}
          </Button>
        </Actions>
      </Card>
    </section>
  </PageHero>

  <Section>
    <div class="product-sections">
      {
        t.sections.map((section) => (
          <Split>
            <h2 slot="side">{section.h2}</h2>
            {section.paras.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.list && <CheckList items={section.list} />}
          </Split>
        ))
      }
    </div>
  </Section>

  <Section tone="band">
    <Split sticky>
      <SectionHeading slot="side" title={t.limitationsTitle} />
      <CheckList items={record.limitations[lang]} icon="shield" />
    </Split>
  </Section>

  <Section width="narrow">
    <SectionHeading
      align="center"
      title={t.simulatorTitle}
      lead={t.simulatorText}
    >
      <Actions align="center">
        <Button
          href={simulatorRecord.routes[lang]}
          data-analytics-content-type="product"
          data-analytics-item-id={simulatorRecord.id}
          data-analytics-source="bank-connectivity-simulator"
        >
          {t.simulatorLink}
        </Button>
      </Actions>
    </SectionHeading>
  </Section>

  <Section tone="band">
    <CapabilityDirectionTable {lang} {record} />
    <CatalogFaqGlossary {lang} {record} />
  </Section>

  <Section>
    <SectionHeading title={relatedTitle} />
    <CardGrid columns={3}>
      {
        related.map((item) => (
          <Card
            title={item[lang]}
            href={relatedHref(item.slug)}
            icon="document"
          />
        ))
      }
    </CardGrid>
  </Section>
</CatalogPageLayout>

<style>
  .status h2 {
    color: var(--landing-ink);
    font-size: 1.15rem;
    margin: 6px 0 0;
  }

  .status p {
    margin: 0;
  }

  .status :global(.ui-actions) {
    margin-top: 12px;
  }

  .product-sections {
    display: grid;
  }

  .product-sections > :global(.ui-split) {
    padding: 32px 0;
  }

  .product-sections > :global(.ui-split + .ui-split) {
    border-top: 1px solid var(--landing-line);
  }

  .product-sections > :global(.ui-split:first-child) {
    padding-top: 0;
  }

  .product-sections > :global(.ui-split:last-child) {
    padding-bottom: 0;
  }

  @media (max-width: 980px) {
    .product-sections > :global(.ui-split) {
      gap: 14px;
    }
  }

  .product-sections h2 {
    color: var(--landing-ink);
    font-size: 1.5rem;
    line-height: 1.25;
    margin: 0;
  }

  .product-sections p {
    color: var(--landing-muted);
    line-height: 1.75;
    margin: 0 0 14px;
  }

  .product-sections :global(.ui-checklist) {
    margin-top: 6px;
  }
</style>
