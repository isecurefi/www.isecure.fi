---
import { catalogUi, getPublicProductRecords } from "../data/productRegistry";
import CatalogAccessSummary from "./CatalogAccessSummary.astro";
import IconTile from "./ui/IconTile.astro";
import type { IconName } from "./ui/icons";
import type { Lang } from "../types";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = {
  en: {
    title: "From first test file to live bank traffic",
    all: "Explore all products",
    more: "Read more",
    descriptions: [
      "Exchange bank files and manage certificates.",
      "Prepare, validate and approve payment files for Nordea, OP, Danske Bank, Säästöpankki, Oma Säästöpankki and Ålandsbanken. Verification of Payee (VoP) included for Nordea, OP and Danske Bank.",
      "Test bank-file workflows with synthetic accounts and payment feedback. Automate scenarios through the Bank Simulator API.",
    ],
  },
  fi: {
    title: "Ensimmäisestä testitiedostosta tuotannon pankkiliikenteeseen",
    all: "Tutustu kaikkiin tuotteisiin",
    more: "Lue lisää",
    descriptions: [
      "Lähetä ja nouda pankkiaineistoja sekä hallitse varmenteita.",
      "Luo, tarkista ja hyväksy maksuaineistoja Nordealle, OP:lle, Danske Bankille, Säästöpankille, Oma Säästöpankille ja Ålandsbankenille. Maksunsaajan tarkistus (VoP) sisältyy Nordean, OP:n ja Danske Bankin maksuihin.",
      "Testaa pankkiaineistoja synteettisillä tileillä ja maksupalautteilla. Automatisoi skenaariot Bank Simulator API:lla.",
    ],
  },
  se: {
    title: "Från första testfilen till skarp banktrafik",
    all: "Utforska alla produkter",
    more: "Läs mer",
    descriptions: [
      "Skicka och hämta bankfiler och hantera certifikat.",
      "Skapa, kontrollera och godkänn betalningsfiler för Nordea, OP, Danske Bank, Sparbanken, Oma Sparbank och Ålandsbanken. Mottagarkontroll (VoP) ingår för Nordea, OP och Danske Bank.",
      "Testa bankfilflöden med syntetiska konton och betalningsrespons. Automatisera scenarier via Bank Simulator API.",
    ],
  },
}[lang];
const order = ["bank-connectivity", "processing-api", "bank-simulation"];
const products = getPublicProductRecords()
  .filter((p) => order.includes(p.id))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const icons: Record<string, IconName> = {
  "bank-connectivity": "network",
  "processing-api": "document",
  "bank-simulation": "flask",
};
const indexHref = lang === "fi" ? "/products/" : `/${lang}/products/`;
---

<section class="our-products" id="products" aria-labelledby="products-title">
  <div class="products-inner">
    <div class="products-heading">
      <h2 id="products-title">{copy.title}</h2><a href={indexHref}
        >{copy.all} →</a
      >
    </div>
    <div class="products-grid" aria-label={catalogUi[lang].products}>
      {
        products.map((product, i) => (
          <article data-catalog-entry={product.id}>
            <span class="product-icon">
              <IconTile name={icons[product.id] ?? "network"} size="lg" />
            </span>
            <CatalogAccessSummary
              {lang}
              stage={product.stage}
              access={product.access}
              compact
              card
            >
              <h3 slot="title">
                <a
                  href={product.routes[lang]}
                  data-analytics-content-type="product"
                  data-analytics-item-id={product.id}
                  data-analytics-source="homepage-products"
                >
                  {product.name[lang]}
                </a>
              </h3>
              <p>{copy.descriptions[i]}</p>
            </CatalogAccessSummary>
            <span class="product-more" aria-hidden="true">
              {copy.more} →
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>
<style>
  .our-products {
    background: var(--landing-band, var(--landing-soft, #edf3f5));
    padding: 74px 0;
  }
  .products-inner {
    margin: 0 auto;
    width: min(1180px, calc(100% - 40px));
  }
  .products-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 32px;
  }
  h2 {
    font-size: clamp(1.9rem, 3vw, 3rem);
    line-height: 1.08;
    margin: 0;
  }
  .products-heading a {
    color: var(--landing-accent, #006f6a);
    font-weight: 700;
    text-decoration: none;
  }
  .products-heading a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  article {
    background: var(--landing-card, #fff);
    border: 1px solid var(--landing-line, #dce5ea);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgba(16, 24, 32, 0.04);
    display: flex;
    flex-direction: column;
    padding: 28px;
    position: relative;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  article:hover {
    border-color: var(--landing-accent, #006f6a);
    box-shadow: 0 18px 40px rgba(16, 24, 32, 0.1);
    transform: translateY(-3px);
  }
  .product-icon {
    display: block;
    margin-bottom: 20px;
  }
  h3 {
    font-size: 1.3rem;
    margin: 0;
  }
  h3 a {
    color: var(--landing-ink, #12212f);
    text-decoration: none;
  }
  /* The title link covers the whole card. */
  h3 a::after {
    content: "";
    inset: 0;
    position: absolute;
  }
  h3 a:focus-visible {
    outline: none;
  }
  article:has(h3 a:focus-visible) {
    outline: 2px solid var(--landing-accent, #006f6a);
    outline-offset: 3px;
  }
  p {
    color: var(--landing-muted, #526173);
    margin: 14px 0;
  }
  .product-more {
    color: var(--landing-accent, #006f6a);
    font-weight: 700;
    margin-top: auto;
    padding-top: 12px;
  }
  @media (max-width: 760px) {
    .our-products {
      padding: 48px 0;
    }
    .products-inner {
      width: min(100% - 28px, 1180px);
    }
    .products-grid {
      grid-template-columns: 1fr;
    }
    .products-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
