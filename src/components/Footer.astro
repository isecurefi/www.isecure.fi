---
const currentYear = new Date().getFullYear();
---
<footer>
  <div class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-left">
          <p style="padding:5px;margin:0px;color:#a0a0a0;">Copyright &copy; ISECure Oy {currentYear}</p>
          <div class="footer-logo">
            <a href="/">
              <img src="/images/isecure-small-logo.png" style="width:200px" alt="ISECure">
            </a>
          </div>
        </div>
        <div class="footer-right">
          <div class="contact-info">
            <p>
              <strong style="color:#fff">Founder Dan Forsberg, D.Sc.</strong><br>
              <i style="color:#4dabf7">dan.forsberg@isecure.fi</i><br>
              <span style="color:#dee2e6">+358 40 483 5507 (Finland)</span><br>
              <span style="color:#dee2e6">Helsinki, Finland (Y-tunnus: 2296336-9)</span>
            </p>
            <div class="social-links">
              <a href="https://www.linkedin.com/in/danforsberg/">
                <img src="/images/linkedin.png" class="soclogo" alt="LinkedIn">
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
