---
import sourceSpec from "../../data/wsapi_v2.json";
import ApiDocsLayout from "../../layouts/ApiDocsLayout.astro";

const HTTP_METHODS = new Set([
  "delete",
  "get",
  "head",
  "options",
  "patch",
  "post",
  "put",
]);

const operations = Object.entries(sourceSpec.paths).flatMap(
  ([path, pathItem]) =>
    Object.entries(pathItem)
      .filter(
        ([method, operation]) =>
          HTTP_METHODS.has(method) && "operationId" in operation,
      )
      .map(([method, operation]) => ({
        method,
        path,
        operationId: "operationId" in operation ? operation.operationId : "",
        tag: "tags" in operation ? (operation.tags?.[0] ?? "Other") : "Other",
      })),
);

const legacyHashMap = Object.fromEntries([
  ...operations.flatMap((operation) => [
    [
      `operations-${operation.tag}-${operation.operationId}`,
      `operation/${operation.operationId}`,
    ],
    [
      `operation-${operation.path.replace(/[/{}/]/g, "-")}-${operation.method}`,
      `operation/${operation.operationId}`,
    ],
  ]),
  ...Object.keys(sourceSpec.definitions).flatMap((name) => [
    [`model-${name}`, `schema/${name}`],
    [`definition-${name}`, `schema/${name}`],
  ]),
]);

const serializedLegacyHashMap = JSON.stringify(legacyHashMap).replace(
  /</g,
  "\\u003c",
);
const schemaCount = Object.keys(sourceSpec.definitions).length;
const description =
  "Complete API reference for the ISECure WS Channel API: authentication, Finnish bank file exchange, certificates, MFA, integrator workflows, code examples, and schemas.";
---

<ApiDocsLayout
  title="ISECure WS Channel API documentation"
  description={description}
  version={sourceSpec.info.version}
  operationCount={operations.length}
>
  <main
    id="api-reference"
    tabindex="-1"
    data-renderer="scalar"
    data-reference-only="true"
    aria-busy="true"
  >
    <div class="docs-loading" role="status">
      <span aria-hidden="true"></span>
      <div>
        <strong>Loading API reference</strong>
        <small>{operations.length} operations · {schemaCount} schemas</small>
      </div>
    </div>

    <noscript>
      <section class="noscript-message">
        <h1>ISECure WS Channel API documentation</h1>
        <p>
          JavaScript is required for the browsable reference. You can still read
          or download the complete <a href="/wsapi_v2.json"
            >OpenAPI JSON document</a
          >.
        </p>
      </section>
    </noscript>
  </main>

  <section class="reference-error" id="reference-error" role="alert" hidden>
    <strong>The API reference could not be loaded.</strong>
    <span>
      The complete contract remains available as <a href="/wsapi_v2.json"
        >OpenAPI JSON</a
      >, or contact <a href="mailto:support@isecure.fi">developer support</a>.
    </span>
  </section>

  <script
    id="legacy-hash-map"
    type="application/json"
    set:html={serializedLegacyHashMap}
  />

  <script>
    import "@scalar/api-reference/style.css";
    import { createApiReference } from "@scalar/api-reference";

    const hashMapElement = document.getElementById("legacy-hash-map");
    const legacyHashes = hashMapElement?.textContent
      ? (JSON.parse(hashMapElement.textContent) as Record<string, string>)
      : {};
    const requestedHash = window.location.hash.slice(1);

    if (legacyHashes[requestedHash]) {
      history.replaceState(null, "", `#${legacyHashes[requestedHash]}`);
    }

    const container = document.querySelector<HTMLElement>("#api-reference");
    const errorMessage =
      document.querySelector<HTMLElement>("#reference-error");

    if (!container) {
      if (errorMessage) errorMessage.hidden = false;
    } else {
      container.replaceChildren();

      try {
        createApiReference(container, {
          url: "/wsapi_v2.json",
          layout: "modern",
          theme: "default",
          showSidebar: true,
          hideClientButton: true,
          hideTestRequestButton: true,
          hideModels: false,
          modelsSectionLabel: "Schemas",
          documentDownloadType: "json",
          hideSearch: false,
          showOperationId: true,
          hideDarkModeToggle: false,
          darkMode: false,
          agent: {
            disabled: true,
            hideAddApi: true,
          },
          mcp: {
            disabled: true,
          },
          persistAuth: false,
          telemetry: false,
          withDefaultFonts: false,
          showDeveloperTools: "never",
          defaultOpenFirstTag: true,
          defaultOpenAllTags: false,
          expandAllModelSections: false,
          expandAllResponses: false,
          expandAllSchemaProperties: false,
          orderSchemaPropertiesBy: "preserve",
          orderRequiredPropertiesFirst: true,
          operationTitleSource: "summary",
          generateOperationSlug: ({ operationId, path, method }) =>
            `operation/${operationId ?? `${method}-${path}`}`,
          generateModelSlug: ({ name }) => `schema/${name}`,
          generateTagSlug: ({ name }) => `tag/${name}`,
          generateHeadingSlug: ({ slug }) => `section/${slug}`,
          setPageTitle: ({ title }) => `${title} · ISECure WS Channel API`,
          customCss: `
            :root {
              --scalar-color-accent: #087f72;
              --scalar-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
              --scalar-font-code: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
              --scalar-paragraph: 14px;
              --scalar-sidebar-padding: 10px;
              --scalar-refs-heading-spacing: 20px;
            }

            .light-mode {
              --scalar-color-accent: #087f72;
              --scalar-background-2: #f4f8f7;
              --scalar-background-3: #e8f1ef;
              --scalar-background-accent: rgb(8 127 114 / 12%);
              --scalar-border-color: #cfddda;
              --scalar-sidebar-background-1: #edf5f3;
              --scalar-sidebar-border-color: #bfd4d0;
              --scalar-sidebar-search-background: #ffffff;
              --scalar-sidebar-item-hover-background: #dfedea;
              --scalar-sidebar-item-active-background: #d2e7e3;
              --scalar-sidebar-color-active: #066b61;
            }

            .dark-mode {
              --scalar-color-accent: #67dbc9;
              --scalar-background-1: #0e171b;
              --scalar-background-2: #152227;
              --scalar-background-3: #1c2c32;
              --scalar-background-accent: rgb(103 219 201 / 13%);
              --scalar-border-color: #2b4047;
              --scalar-sidebar-background-1: #0a1317;
              --scalar-sidebar-border-color: #294047;
              --scalar-sidebar-search-background: #142126;
              --scalar-sidebar-item-hover-background: #17272c;
              --scalar-sidebar-item-active-background: #1b3335;
              --scalar-sidebar-color-active: #8ce8dc;
            }
          `,
          onLoaded: () => {
            container.setAttribute("aria-busy", "false");
          },
        });
      } catch (error) {
        container.setAttribute("aria-busy", "false");
        container.hidden = true;
        if (errorMessage) errorMessage.hidden = false;
        console.error(error);
      }
    }
  </script>
</ApiDocsLayout>
