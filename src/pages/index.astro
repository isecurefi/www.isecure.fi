---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getText } from '../store/translations';
import FrontContent from '../components/FrontContent.astro';
import References from '../components/References.astro';

const lang = "fi";
---

<Layout 
  title="WS-Kanava | Turvallinen Pankkiyhteyskanava & API-Ratkaisut"
  lang={lang}
>
  <Hero lang={lang} />
  <div class="quote-section">
    <blockquote class="customer-quote">
      {getText("quote.text", lang)}
    </blockquote>
  </div>
  <FrontContent lang={lang} />
  <hr />
  <References lang={lang} />
</Layout>
