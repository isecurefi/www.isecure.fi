---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";

const lang = "fi";

const messages = {
  title: {
    en: "Thank You - Message Sent Successfully",
    se: "Tack - Meddelandet har skickats",
    fi: "Kiitos - Viesti lähetetty onnistuneesti",
  },
  heading: {
    en: "Thank you for contacting us",
    se: "Tack för att du kontaktade oss",
    fi: "Kiitos yhteydenotosta",
  },
  message: {
    en: "We will be in touch with you soon!",
    se: "Vi kommer att kontakta dig snart!",
    fi: "Olemme teihin yhteydessä!",
  },
  regards: {
    en: "Best regards,",
    se: "Med vänliga hälsningar,",
    fi: "Ystävällisin terveisin,",
  },
};
---

<Layout
  title={messages.title[lang]}
  lang={lang}
  robots="noindex, nofollow"
  fullWidth
>
  <PageHero
    align="center"
    title={messages.heading[lang]}
    lead={messages.message[lang]}
  >
    <p class="thankyou-regards">
      {messages.regards[lang]}<br />
      -&nbsp;Dan Forsberg
    </p>
    <img
      class="thankyou-logo"
      src="/images/isecure-small-logo.png"
      alt="iSecure"
    />
  </PageHero>
</Layout>

<style>
  .thankyou-regards {
    color: var(--landing-muted);
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 32px auto 0;
  }

  .thankyou-logo {
    display: block;
    height: auto;
    margin: 28px auto 0;
    max-width: 200px;
  }
</style>
