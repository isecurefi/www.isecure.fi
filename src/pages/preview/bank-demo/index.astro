---
import BankDemo from "../../../components/BankDemo.astro";
import "../../../styles/theme.css";
---

<!doctype html>
<html lang="en" class="banking-theme-root" data-isecure-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Preview a read-only ISECure Bank Simulator demonstration with synthetic statement data."
    />
    <link rel="canonical" href="https://www.isecure.fi/preview/bank-demo/" />
    <title>Bank Simulator demo preview | ISECure</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="banking-theme-page" data-isecure-theme="light">
    <header>
      <a href="/en/" class="brand">ISECure<span>Bank connectivity</span></a
      ><span class="preview-label">UNLISTED PREVIEW</span>
    </header>
    <main>
      <div class="intro">
        <p class="kicker">FROM DOCUMENTATION TO YOUR FIRST RESPONSE</p><h1>
          See what comes<br />back from the API.
        </h1><p>
          One click to retrieve a bank statement through our test environment.
          Explore the response before writing your first line of integration
          code.
        </p>
      </div>
      <BankDemo />
      <div class="notes">
        <div>
          <h2>A real retrieval. Synthetic data.</h2><p>
            The server uses our TypeScript SDK to read one dedicated simulator
            account. The €10 million opening balance is a fixed test value, not
            money held at a bank.
          </p>
        </div><div>
          <h2>Explore safely, without signing in.</h2><p>
            This preview only lists and downloads its opening statement. It
            cannot send payments or access customer accounts. A response may be
            cached for up to one minute.
          </p>
        </div>
      </div>
      <footer>
        ISECure Oy · Preview for review · <a href="/en/bank-simulator/"
          >About Bank Simulator</a
        >
      </footer>
    </main>
  </body>
</html>
<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: var(--landing-ink);
    background: var(--landing-bg);
    -webkit-font-smoothing: antialiased;
  }
  header {
    max-width: 1120px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px clamp(20px, 4vw, 48px);
    gap: 20px;
  }
  .brand {
    color: var(--landing-ink);
    font-weight: 750;
    font-size: 25px;
    text-decoration: none;
    letter-spacing: -0.05em;
  }
  .brand span {
    display: block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--landing-muted);
    margin-top: 1px;
  }
  .preview-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--landing-muted);
    border: 1px solid var(--landing-line);
    padding: 7px 9px;
    border-radius: 5px;
  }
  main {
    max-width: 900px;
    margin: auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }
  .intro {
    padding: 36px 0;
  }
  .kicker {
    font-size: 10px;
    letter-spacing: 0.15em;
    font-weight: 700;
    color: var(--landing-accent);
  }
  h1 {
    font-size: clamp(38px, 6vw, 60px);
    line-height: 1.07;
    letter-spacing: -0.055em;
    margin: 18px 0;
    font-weight: 650;
  }
  .intro > p:last-child {
    font-size: 17px;
    line-height: 1.7;
    color: var(--landing-muted);
    max-width: 620px;
  }
  .notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin: 36px 0;
  }
  .notes h2 {
    font-size: 15px;
    margin: 0 0 10px;
  }
  .notes p {
    font-size: 13px;
    line-height: 1.75;
    color: var(--landing-muted);
    margin: 0;
  }
  footer {
    font-size: 12px;
    color: var(--landing-muted);
    border-top: 1px solid var(--landing-line);
    padding: 24px 0 40px;
  }
  a {
    color: var(--landing-accent);
  }
  @media (max-width: 540px) {
    .intro {
      padding-top: 20px;
    }
    .notes {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
</style>
