---
import Layout from "../../layouts/Layout.astro";
import Callout from "../../components/ui/Callout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import Prose from "../../components/ui/Prose.astro";
import Section from "../../components/ui/Section.astro";

const description =
  "Information about agreements, acceptable use, security responsibilities, and support for the ISECure WS Channel API.";
---

<Layout
  title="WS Channel API service terms | ISECure"
  lang="en"
  description={description}
  canonicalUrl="https://www.isecure.fi/ws-api-terms/"
  showLanguageSwitcher={false}
  fullWidth
>
  <PageHero
    width="narrow"
    eyebrow="Developer resources"
    title="WS Channel API service terms"
    lead="WS Channel API access is provided under a customer- or partner-specific service agreement with ISECure Oy. That signed agreement, including any attached service description and data-processing terms, governs your use of the API."
  />

  <Section width="narrow">
    <Prose>
      <section>
        <h2>Before using the API</h2>
        <p>
          Contact ISECure to obtain the applicable agreement. Your integrator
          API key identifies your tenant; it is not a secret and does not
          replace user authentication. Identity tokens, passwords, private keys,
          and MFA secrets are confidential credentials. Keep them out of source
          control, browser logs, analytics, and support messages.
        </p>
      </section>

      <section>
        <h2>Responsible integration</h2>
        <p>
          Use the API only for the accounts, banks, and purposes covered by your
          agreement. Respect documented rate limits, validate responses, avoid
          unnecessary retries, and protect bank files and personal data
          according to applicable law and your security obligations.
        </p>
      </section>

      <section>
        <h2>Availability and changes</h2>
        <p>
          Banks and upstream services can introduce delays or maintenance
          windows. API behavior, supported banks, and security requirements may
          evolve. Version-specific behavior is documented in the{" "}
          <a href="/wsapi_v2/">API reference</a>{" "}and its changelog.
        </p>
      </section>

      <section>
        <h2>Questions and support</h2>
        <p>
          For commercial terms or a copy of the agreement, contact{" "}
          <a href="mailto:sales@isecure.fi">sales@isecure.fi</a>. For
          integration support, contact{" "}
          <a href="mailto:support@isecure.fi">support@isecure.fi</a>{" "}and
          include the API request ID—not credentials or bank-file contents.
        </p>
      </section>
    </Prose>

    <div class="terms-note">
      <Callout title="Important">
        <p>
          This page is a practical summary and does not replace the signed
          service agreement between you and ISECure Oy.
        </p>
      </Callout>
    </div>
  </Section>
</Layout>

<style>
  /* Prose resets each section's leading h2, so space the sections here. */
  section + section {
    margin-top: 2.2em;
  }

  .terms-note {
    margin-top: 40px;
    max-width: 780px;
  }
</style>
