---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { getText } from '../../store/translations';
import FrontContent from '../../components/FrontContent.astro';
import References from '../../components/References.astro';
import '../../styles/Hero.css';
import { languages } from '../../utils/languages';

export async function getStaticPaths() {
  // Only generate pages for non-Finnish languages since Finnish is at root
  return languages
    .filter(lang => lang !== 'fi')
    .map(lang => ({
      params: { lang },
      props: { lang }
    }));
}

const { lang } = Astro.props;
---

<Layout 
  title={
    lang === 'en' 
      ? "Secure Bank Connection Channel & API Solutions"
      : lang === 'se'
      ? "Säker Bankförbindelsekanal & API-Lösningar"
      : "Turvallinen Pankkiyhteyskanava & API-Ratkaisut"
  } 
  lang={lang}
>
  <Hero lang={lang} />
  <div class="quote-section">
    <blockquote class="customer-quote">
      {getText("quote.text", lang)}
    </blockquote>
  </div>
  <FrontContent lang={lang} />
  <hr />
  <References lang={lang} />
</Layout>
