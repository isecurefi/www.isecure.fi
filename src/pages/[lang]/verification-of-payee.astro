---
import VerificationOfPayeePage from "../../components/VerificationOfPayeePage.astro";
import { languages } from "../../utils/languages";

export async function getStaticPaths() {
  return languages
    .filter((lang) => lang !== "fi")
    .map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<VerificationOfPayeePage lang={lang} />
