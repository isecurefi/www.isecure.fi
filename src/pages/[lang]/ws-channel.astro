---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../utils/languages';
import { getText } from '../../store/translations';
import BankLogos from '../../components/BankLogos.astro';
import '../../styles/PageContent.css';

export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;
---
<Layout title={`${getText('webService.wsChannel.title', lang)} | ISECure`} lang={lang}>
  <div class="container page-container">
    <h1 class="page-header">{getText('webService.wsChannel.title', lang)}</h1>

    <div class="content-section">
      <div class="main-content">
        <h2 class="section-title">{getText('webService.wsChannel.subtitle', lang)}</h2>
        <div class="content-block">
          <p>{getText('webService.wsChannel.description', lang)}</p>
          <p class="highlight-text"><i>"{getText('webService.wsChannel.quote', lang)}"</i></p>
          <p>{getText('webService.wsChannel.details', lang)}</p>
        </div>
      </div>
    </div>

    <h3>{getText('webService.banks', lang)}</h3>
    <BankLogos />
  </div>
</Layout>
