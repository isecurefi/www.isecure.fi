---
import Layout from "../../layouts/Layout.astro";
import { languages } from "../../utils/languages";
import { getText } from "../../store/translations";
import PageHero from "../../components/ui/PageHero.astro";
import Prose from "../../components/ui/Prose.astro";
import Section from "../../components/ui/Section.astro";
import BankLogos from "../../components/BankLogos.astro";

export async function getStaticPaths() {
  // Only generate pages for non-Finnish languages since Finnish is at root
  return languages
    .filter((lang) => lang !== "fi")
    .map((lang) => ({
      params: { lang },
      props: { lang },
    }));
}

const { lang } = Astro.props;
const landingCanonical =
  lang === "en" ? "https://www.isecure.fi/en/" : "https://www.isecure.fi/se/";
---

<Layout
  title={`${getText("webService.wsChannel.title", lang)} | ISECure`}
  lang={lang}
  robots="noindex, follow"
  canonicalUrl={landingCanonical}
  fullWidth
>
  <PageHero
    width="narrow"
    title={getText("webService.wsChannel.title", lang)}
  />

  <Section width="narrow">
    <Prose>
      <h2>{getText("webService.wsChannel.subtitle", lang)}</h2>
      <p>{getText("webService.wsChannel.description", lang)}</p>
      <p class="highlight-text">
        <i>"{getText("webService.wsChannel.quote", lang)}"</i>
      </p>
      <p>{getText("webService.wsChannel.details", lang)}</p>
    </Prose>
  </Section>

  <Section tone="band">
    <h3 class="banks-title">{getText("webService.banks", lang)}</h3>
    <BankLogos />
  </Section>
</Layout>

<style>
  .highlight-text {
    border-left: 3px solid var(--landing-accent);
    padding-left: 18px;
  }

  .banks-title {
    color: var(--landing-ink);
    font-size: 1.2rem;
    margin: 0 0 24px;
    text-align: center;
  }
</style>
