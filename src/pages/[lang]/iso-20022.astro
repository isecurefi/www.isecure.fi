---
import Iso20022OverviewPage from "../../components/Iso20022OverviewPage.astro";
import { languages } from "../../utils/languages";

export async function getStaticPaths() {
  return languages
    .filter((lang) => lang !== "fi")
    .map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<Iso20022OverviewPage lang={lang} />
