---
import InvoicingPage from "../../components/InvoicingPage.astro";
import { languages } from "../../utils/languages";

export function getStaticPaths() {
  return languages
    .filter((lang) => lang !== "fi")
    .map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
---

<InvoicingPage lang={lang} />
