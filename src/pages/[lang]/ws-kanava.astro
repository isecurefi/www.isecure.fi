---
import Layout from '../../layouts/Layout.astro';
import type { Lang } from '../../types';
import { languages } from '../../utils/languages';

export async function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;
---
<Layout title={`${getText('webService.wsChannel.title', lang)} | iSecure`} lang={lang}>
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <h1 class="page-header">{getText('webService.wsChannel.title', lang)}</h1>
      </div>
    </div>

    <div class="row">
      <div class="col-md-8">
        <p>{getText('webService.wsChannel.subtitle', lang)}</p>
 
        <p>{getText('webService.wsChannel.description', lang)}</p>
 
        <p class="blue-text"><i>"{getText('webService.wsChannel.quote', lang)}"</i></p>
 
        <p>{getText('webService.wsChannel.details', lang)}</p>
      </div>
      <div class="col-md-4">
        <p class="blue-text">{getText('webService.wsChannel.saas', lang)}</p>
        <a href="#contact" class="btn btn-primary">{lang === 'fi' ? 'Kysy Lisää' : lang === 'se' ? 'Fråga Mer' : 'Ask More'}</a>
      </div>
    </div>

    <h3>Tuetut pankit</h3>
    <div class="row">
      <div class="col-md-12">
        <div class="bank-logos text-center">
          <img src="/images/bank_icons/aktia_logo.png" alt="Aktia" class="bank-icon">
          <img src="/images/bank_icons/alandsbanken_logo.gif" alt="Ålandsbanken" class="bank-icon">
          <img src="/images/bank_icons/handelsbanken_logo.gif" alt="Handelsbanken" class="bank-icon">
          <img src="/images/bank_icons/nooa_logo.gif" alt="Nooa" class="bank-icon">
          <img src="/images/bank_icons/nordea_logo.gif" alt="Nordea" class="bank-icon">
          <img src="/images/bank_icons/oko_logo.gif" alt="OKO" class="bank-icon">
          <img src="/images/bank_icons/pop_logo.png" alt="POP Pankki" class="bank-icon">
          <img src="/images/bank_icons/sampo_logo.png" alt="Sampo" class="bank-icon">
          <img src="/images/bank_icons/spankki_lahitapiola.png" alt="S-Pankki LähiTapiola" class="bank-icon">
          <img src="/images/bank_icons/SEBlogo.png" alt="SEB" class="bank-icon">
        </div>
      </div>
    </div>
  </div>
</Layout>
