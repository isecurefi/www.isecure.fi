# Google Search Console scripts — copy this file to .env and fill in.
# Path to the service-account JSON key you downloaded from Google Cloud.
# Read-only pulls require Search Console access; `yarn gsc:reconcile --apply`
# requires the service account to have Full permission on the property.
GSC_KEY_FILE=./gsc-key.json
# Your GSC property. Domain property: sc-domain:isecure.fi
# URL-prefix property instead: https://www.isecure.fi/
GSC_SITE_URL=sc-domain:isecure.fi
