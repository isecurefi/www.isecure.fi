<svg width="800" height="533" viewBox="0 0 800 533" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="533" fill="#f8f9fa"/>
  
  <!-- Bank Server -->
  <g transform="translate(100,100)">
    <rect width="150" height="100" rx="10" fill="#0d6efd" opacity="0.8"/>
    <text x="75" y="55" text-anchor="middle" fill="white" font-family="Arial" font-size="16">Bank Server</text>
  </g>

  <!-- SFTP Server -->
  <g transform="translate(550,100)">
    <rect width="150" height="100" rx="10" fill="#198754" opacity="0.8"/>
    <text x="75" y="55" text-anchor="middle" fill="white" font-family="Arial" font-size="16">SFTP Server</text>
  </g>

  <!-- ISECure WS-Channel -->
  <g transform="translate(300,250)">
    <rect width="200" height="120" rx="10" fill="#6610f2" opacity="0.8"/>
    <text x="100" y="50" text-anchor="middle" fill="white" font-family="Arial" font-size="16">ISECure</text>
    <text x="100" y="70" text-anchor="middle" fill="white" font-family="Arial" font-size="16">WS-Channel</text>
    <text x="100" y="90" text-anchor="middle" fill="white" font-family="Arial" font-size="16">SFTP Sync</text>
  </g>

  <!-- Arrows -->
  <g stroke="#212529" stroke-width="2" fill="none" marker-end="url(#arrowhead)">
    <!-- Bank to WS-Channel -->
    <path d="M250,150 C275,150 275,300 300,300" />
    <!-- WS-Channel to SFTP -->
    <path d="M500,300 C525,300 525,150 550,150" />
  </g>

  <!-- Arrowhead marker -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#212529"/>
    </marker>
  </defs>

  <!-- Labels -->
  <g font-family="Arial" font-size="14" fill="#495057">
    <text x="200" y="140">Bank Files</text>
    <text x="550" y="140">Secure Storage</text>
    <text x="250" y="250">Automated Sync</text>
    <text x="500" y="250">Secure Transfer</text>
  </g>
</svg>
